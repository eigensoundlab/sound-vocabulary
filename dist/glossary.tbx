<conceptEntry id="bar-shape">
<descrip type="subjectField">material</descrip>
<langSec xml:lang="en">
<descrip type="definition">A long solid body, such as a rod or beam.</descrip>
<termSec><term>bar</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Dlouhé plné těleso, například prut nebo nosník.</descrip>
<termSec><term>tyč</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Not to be confused with the musical bar ('takt').</note></termSec>
<termSec><term>nosník</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein langer, massiver Körper, etwa eine Stange oder ein Träger.</descrip>
<termSec><term>Stab</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Not 'Takt' (musical bar).</note></termSec>
<termSec><term>Balken</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un cuerpo sólido alargado, como una varilla o una viga.</descrip>
<termSec><term>barra</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Shape; unrelated to 'compás' (musical bar).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Długie, pełne ciało, np. pręt lub belka.</descrip>
<termSec><term>pręt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Not „takt” (musical bar).</note></termSec>
<termSec><term>belka</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Длинное твёрдое тело, например прут или балка.</descrip>
<termSec><term>стержень</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Термин теории колебаний; не путать с тактом (bar).</note></termSec>
<termSec><term>брусок</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="plate">
<descrip type="subjectField">material</descrip>
<langSec xml:lang="en">
<descrip type="definition">A thin flat body.</descrip>
<termSec><term>plate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Tenké ploché těleso.</descrip>
