</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein dünner, flacher Körper.</descrip>
<termSec><term>Platte</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un cuerpo plano y delgado.</descrip>
<termSec><term>placa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Mechanics: 'placa'; 'lámina' for very thin sheets.</note></termSec>
<termSec><term>lámina</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Cienkie, płaskie ciało.</descrip>
<termSec><term>płyta</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>płytka</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Тонкое плоское тело.</descrip>
<termSec><term>пластина</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="membrane">
<descrip type="subjectField">material</descrip>
<langSec xml:lang="en">
<descrip type="definition">A stretched skin, as on a drum.</descrip>
<termSec><term>membrane</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Napjatá blána, jako na bubnu.</descrip>
<termSec><term>membrána</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>blána</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine gespannte Haut, wie bei einer Trommel.</descrip>
<termSec><term>Membran</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>AT also 'Membrane'.</note></termSec>
<termSec><term>Membrane</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una piel tensada, como el parche de un tambor.</descrip>
<termSec><term>membrana</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Napięta błona, jak w bębnie.</descrip>
<termSec><term>membrana</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Натянутая кожа или плёнка, как на барабане.</descrip>
<termSec><term>мембрана</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="shell">
<descrip type="subjectField">material</descrip>
<langSec xml:lang="en">
<descrip type="definition">A thin curved body, such as a can or pot.</descrip>
<termSec><term>shell</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Tenké zakřivené těleso, například plechovka nebo hrnec.</descrip>
<termSec><term>skořepina</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein dünner, gewölbter Körper, etwa eine Dose oder ein Topf.</descrip>
<termSec><term>Schale</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un cuerpo curvo y delgado, como una lata o una olla.</descrip>
<termSec><term>cáscara</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Structural mechanics calls shells 'cáscaras' or 'láminas'; 'carcasa' (casing) is more everyday if 'cáscara' reads too organic in UI.</note></termSec>
<termSec><term>carcasa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>lámina curva</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Cienkie, zakrzywione ciało, np. puszka lub garnek.</descrip>
<termSec><term>powłoka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Mechanics term („teoria powłok”).</note></termSec>
<termSec><term>skorupa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>czasza</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Тонкое изогнутое тело, например банка или кастрюля.</descrip>
<termSec><term>оболочка</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="bell">
<descrip type="subjectField">material</descrip>
<langSec xml:lang="en">
<termSec><term>bell</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<termSec><term>zvon</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<termSec><term>Glocke</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<termSec><term>campana</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<termSec><term>dzwon</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>dzwonek</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<termSec><term>колокол</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="wire">
<descrip type="subjectField">material</descrip>
<langSec xml:lang="en">
<descrip type="definition">A stiff string or wire that rings with slightly stretched (inharmonic) partials.</descrip>
<termSec><term>wire</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Tuhá struna nebo drát, který zní s mírně roztaženými (neharmonickými) částkovými tóny.</descrip>
<termSec><term>drát</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Drát' follows the English choice of 'wire'. In Workbench the impact-model shape 'Wire / string' becomes 'Drát / struna'. 'Roztažené' is the usual Czech for stretched partials (as in piano-string inharmonicity).</note></termSec>
<termSec><term>struna</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>drát / struna</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine dünne, gespannte Saite.</descrip>
<termSec><term>Draht</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Literal 'Draht' keeps the object-like naming of the shape list; physically a tensioned string is modelled, so choose 'Saite' if non-metal strings are meant.</note></termSec>
<termSec><term>Saite</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una cuerda rígida o un alambre que resuena con parciales ligeramente estirados (inarmónicos).</descrip>
<termSec><term>cuerda</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Workbench's 'Wire / string' shape: 'cuerda' is the physics term ('cuerda vibrante') and covers metal strings and wires; 'alambre' keeps the metal-wire image and suits a combined label 'Cuerda / alambre'. 'parciales estirados' as in piano 'afinación estirada'.</note></termSec>
<termSec><term>alambre</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Sztywna struna lub drut, który dzwoni lekko rozciągniętymi (nieharmonicznymi) tonami składowymi.</descrip>
<termSec><term>struna</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish names a vibrating stretched element „struna” (piano strings are steel wire); „drut” is the material. In Workbench the impact-model shape „Wire / string” is „Drut / struna”.</note></termSec>
<termSec><term>drut</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Тонкая струна под натяжением.</descrip>
<termSec><term>струна</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>В физике колебаний — «струна»; «проволока» называет скорее материал.</note></termSec>
<termSec><term>проволока</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="box">
<descrip type="subjectField">material</descrip>
<langSec xml:lang="en">
<descrip type="definition">A hollow body with flat sides.</descrip>
<termSec><term>box</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Duté těleso s rovnými stěnami.</descrip>
<termSec><term>skříň</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Skříň' as in 'rezonanční skříň'; 'krabice' is everyday and suggests cardboard.</note></termSec>
<termSec><term>krabice</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>bedna</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Hohlkörper mit flachen Seiten.</descrip>
<termSec><term>Kasten</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>Kiste</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Box</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un cuerpo hueco con caras planas.</descrip>
<termSec><term>caja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Puste w środku ciało o płaskich ściankach.</descrip>
<termSec><term>pudło</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>As in „pudło rezonansowe”.</note></termSec>
<termSec><term>skrzynka</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Полое тело с плоскими стенками.</descrip>
<termSec><term>ящик</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>коробка</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>короб</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
</body></text></tbx>
