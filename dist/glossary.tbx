<?xml version="1.0" encoding="UTF-8"?>
<tbx type="TBX-Basic" style="dca" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
<tbxHeader><fileDesc><sourceDesc><p>eigensoundlab sound vocabulary, https://github.com/eigensoundlab/sound-vocabulary</p></sourceDesc></fileDesc></tbxHeader>
<text><body>
<conceptEntry id="waveform">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">The drawing of a sound's amplitude over time.</descrip>
<termSec><term>waveform</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Vykreslení amplitudy zvuku v čase.</descrip>
<termSec><term>vlnový průběh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour cs uses 'průběhová křivka' and Audacity cs plain 'křivka'. Neither is used here because 'křivka' is reserved for analysis curves, which are drawn along the waveform. 'Časový/vlnový průběh signálu' is the textbook phrase; in speech 'waveform' or 'vlna' is common.</note></termSec>
<termSec><term>průběhová křivka</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>průběh signálu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>waveform</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die grafische Darstellung der Amplitude eines Sounds über der Zeit.</descrip>
<termSec><term>Wellenform</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La representación gráfica de la amplitud de un sonido a lo largo del tiempo.</descrip>
<termSec><term>forma de onda</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Universal (Audacity es, Cubase es, Adobe Audition es).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Wykres amplitudy dźwięku w czasie.</descrip>
<termSec><term>przebieg</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity pl uses „kształt fali”, Ardour pl „wykres fali”. „Przebieg” (przebieg czasowy) is the electronics and studio word and combines well (przebieg szczytowy, przebieg rzeźbiony); write „przebieg fali” in docs where the context is unclear.</note></termSec>
<termSec><term>kształt fali</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>wykres fali</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>waveform</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изображение амплитуды звука во времени.</descrip>
<termSec><term>форма волны</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Самый употребительный вариант в русских DAW и учебниках. «Осциллограмма» — строгий технический термин для документации, «волноформа» — вариант русской Audacity. «Форма волны» также означает форму колебания генератора (синус, пила); в Workbench различайте по контексту.</note></termSec>
<termSec><term>волновая форма</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>осциллограмма</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>волноформа</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="spectrogram">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A picture of how a sound's frequency content changes over time: time across, frequency up, level as colour.</descrip>
<termSec><term>spectrogram</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Obraz toho, jak se frekvenční obsah zvuku mění v čase: čas vodorovně, frekvence svisle, úroveň barvou.</descrip>
<termSec><term>spektrogram</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Bild davon, wie sich der Frequenzinhalt eines Sounds über die Zeit ändert: Zeit nach rechts, Frequenz nach oben, Pegel als Farbe.</descrip>
<termSec><term>Spektrogramm</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una imagen de cómo cambia con el tiempo el contenido en frecuencia de un sonido: el tiempo en horizontal, la frecuencia en vertical y el nivel como color.</descrip>
<termSec><term>espectrograma</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Obraz zmian zawartości częstotliwościowej dźwięku w czasie: czas w poziomie, częstotliwość w pionie, poziom jako kolor.</descrip>
<termSec><term>spektrogram</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity pl and Ardour pl. „Sonogram” is an older variant, still common in bioacoustics.</note></termSec>
<termSec><term>sonogram</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изображение того, как частотный состав звука меняется во времени: время — по горизонтали, частота — по вертикали, уровень — цветом.</descrip>
<termSec><term>спектрограмма</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="mel-scale">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A frequency scale spaced as pitch is heard: roughly linear below 1 kHz and logarithmic above.</descrip>
<termSec><term>mel scale</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Frekvenční stupnice rozložená podle vnímané výšky tónu: zhruba lineární pod 1 kHz a logaritmická nad ním.</descrip>
<termSec><term>melová stupnice</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Unit 'mel'. ČVUT speech-processing lectures also say 'melodická stupnice'.</note></termSec>
<termSec><term>stupnice mel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>melodická stupnice</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine Frequenzskala, die so eingeteilt ist, wie Tonhöhe gehört wird: unterhalb von 1 kHz annähernd linear, darüber logarithmisch.</descrip>
<termSec><term>Mel-Skala</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Duden spelling with hyphen; unit 'mel'.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una escala de frecuencias espaciada según se percibe el tono: aproximadamente lineal por debajo de 1 kHz y logarítmica por encima.</descrip>
<termSec><term>escala mel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'tono' is used for pitch throughout (as in DAWs: 'cambio de tono'); formal acoustics also says 'altura tonal'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Skala częstotliwości rozłożona tak, jak słyszymy wysokość dźwięku: w przybliżeniu liniowa poniżej 1 kHz i logarytmiczna powyżej.</descrip>
<termSec><term>skala melowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Unit „mel”; Polish Wikipedia: „Mel (skala)”.</note></termSec>
<termSec><term>skala mel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Шкала частот, размеченная так, как воспринимается высота звука: примерно линейная ниже 1 кГц и логарифмическая выше.</descrip>
<termSec><term>мел-шкала</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Мел — единица воспринимаемой высоты тона.</note></termSec>
<termSec><term>шкала мелов</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="playhead">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">The moving line that marks the current playback position.</descrip>
<termSec><term>playhead</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>cursor</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Pohyblivá čára, která označuje aktuální pozici přehrávání.</descrip>
<termSec><term>ukazatel přehrávání</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour cs ('ukazatel přehrávání', also 'ukazatel polohy'). Keep 'kurzor' for the edit cursor. The app name Playhead stays untranslated.</note></termSec>
<termSec><term>přehrávací hlava</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>playhead</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die mitlaufende Linie, die die aktuelle Wiedergabeposition markiert.</descrip>
<termSec><term>Abspielposition</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Logic Pro de defines it exactly so: 'Die Abspielposition ist die vertikale Linie, die die aktuelle Wiedergabeposition in einem Projekt zeigt.' Not 'Cursor' (Cubase's 'Projekt-Cursor'), so it stays distinct from the Einfügemarke (edit cursor). Use 'Abspielpositionslinie' where the line must be told apart from the time value. The app name Playhead stays English.</note></termSec>
<termSec><term>Abspielpositionslinie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Playhead</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La línea móvil que marca la posición de reproducción actual.</descrip>
<termSec><term>cabezal de reproducción</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Adobe Audition/Premiere es: 'cabezal de reproducción'; Logic Pro es: 'cursor de reproducción'; Cubase es: 'cursor del proyecto'. 'cabezal' keeps the English separation from the edit cursor ('cursor de edición'), as the source asks. The app name Playhead is not translated.</note></termSec>
<termSec><term>cursor de reproducción</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Ruchoma linia, która wskazuje bieżące miejsce odtwarzania.</descrip>
<termSec><term>głowica odtwarzania</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Ardour pl: „głowica”; Audacity pl: „wskaźnik odtwarzania”. Do not call it „kursor” (that is the edit cursor). The app name Playhead stays in English.</note></termSec>
<termSec><term>wskaźnik odtwarzania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>znacznik odtwarzania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Движущаяся линия, которая отмечает текущую позицию воспроизведения.</descrip>
<termSec><term>указатель воспроизведения</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Как в русской Audacity («указатель проигрывания»). Согласно исходнику, в документации не называйте его «курсором»: это слово оставлено для курсора редактирования. Название приложения Playhead не переводится.</note></termSec>
<termSec><term>курсор воспроизведения</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>плейхед</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="edit-cursor">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">The position where editing and playback start, set by clicking.</descrip>
<termSec><term>edit cursor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Pozice, od které začínají úpravy a přehrávání; nastavuje se kliknutím.</descrip>
<termSec><term>editační kurzor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour cs translates 'edit point' as 'pracovní bod'.</note></termSec>
<termSec><term>kurzor úprav</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pracovní bod</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Position, an der Bearbeitung und Wiedergabe beginnen; wird per Klick gesetzt.</descrip>
<termSec><term>Einfügemarke</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>As in Ableton Live de ('Einfügemarke', the blinking insert marker from which playback starts). 'Cursor' is acceptable here but never for the playhead.</note></termSec>
<termSec><term>Bearbeitungscursor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Edit-Cursor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La posición donde empiezan la edición y la reproducción; se fija haciendo clic.</descrip>
<termSec><term>cursor de edición</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Miejsce, od którego zaczyna się edycja i odtwarzanie, ustawiane kliknięciem.</descrip>
<termSec><term>kursor edycji</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity pl: „Kursor”; Ardour pl: „punkt edycji” (edit point).</note></termSec>
<termSec><term>punkt edycji</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Позиция, с которой начинаются редактирование и воспроизведение; устанавливается щелчком мыши.</descrip>
<termSec><term>курсор редактирования</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>курсор правки</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="sample-rate">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Samples per second of a digital sound, in Hz.</descrip>
<termSec><term>sample rate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Počet vzorků za sekundu u digitálního zvuku, v Hz.</descrip>
<termSec><term>vzorkovací frekvence</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>LMMS cs 'vzorkovací frekvence'; Audacity cs and ČSN usage 'vzorkovací kmitočet'.</note></termSec>
<termSec><term>vzorkovací kmitočet</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Anzahl der Abtastwerte pro Sekunde eines digitalen Sounds, in Hz.</descrip>
<termSec><term>Abtastrate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Abtastrate' in standards, textbooks and Audacity de; Cubase de and studio speech often say 'Samplerate'.</note></termSec>
<termSec><term>Samplerate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Samplingrate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Muestras por segundo de un sonido digital, en Hz.</descrip>
<termSec><term>frecuencia de muestreo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Cubase es and textbooks: 'frecuencia de muestreo'; 'tasa de muestreo' is a frequent calque, more common in Latin America.</note></termSec>
<termSec><term>tasa de muestreo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Liczba próbek na sekundę dźwięku cyfrowego, w Hz.</descrip>
<termSec><term>częstotliwość próbkowania</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity, Ardour, LMMS pl; TVP technical requirements.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Число отсчётов в секунду в цифровом звуке, в Гц.</descrip>
<termSec><term>частота дискретизации</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Sample как единица дискретизации — «отсчёт»; «сэмпл» в русской студийной речи означает звуковой фрагмент.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="bit-depth">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Bits per sample of a digital sound; sets its resolution.</descrip>
<termSec><term>bit depth</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Počet bitů na vzorek digitálního zvuku; určuje jeho rozlišení.</descrip>
<termSec><term>bitová hloubka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity cs.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Bits pro Abtastwert eines digitalen Sounds; bestimmt seine Auflösung.</descrip>
<termSec><term>Bittiefe</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Wortbreite' is the older engineering term.</note></termSec>
<termSec><term>Wortbreite</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Bit-Auflösung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Bits por muestra de un sonido digital; determina su resolución.</descrip>
<termSec><term>profundidad de bits</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Cubase es: 'profundidad de bits'; 'resolución' alone is also heard.</note></termSec>
<termSec><term>resolución en bits</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Liczba bitów na próbkę dźwięku cyfrowego; decyduje o dokładności jego zapisu.</descrip>
<termSec><term>rozdzielczość bitowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity pl („Rozdzielczość bitowa”), Polish Wikipedia („Rozdzielczość bitowa dźwięku”), TVP („rozdzielczość … bitów/próbkę”). „Głębia bitowa” is a common calque. „Sets its resolution” is rendered as accuracy, to avoid „rozdzielczość… rozdzielczość”.</note></termSec>
<termSec><term>głębia bitowa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Число бит на отсчёт в цифровом звуке; определяет его разрешение.</descrip>
<termSec><term>разрядность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Разрядность» — как в русской Audacity и технической литературе; калька «битовая глубина» встречается реже.</note></termSec>
<termSec><term>битовая глубина</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="channel">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">One signal of a sound file; stereo has two.</descrip>
<termSec><term>channel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jeden signál zvukového souboru; stereo má dva.</descrip>
<termSec><term>kanál</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Signal einer Audiodatei; Stereo hat zwei.</descrip>
<termSec><term>Kanal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una de las señales de un archivo de sonido; el estéreo tiene dos.</descrip>
<termSec><term>canal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jeden sygnał w pliku dźwiękowym; stereo ma dwa.</descrip>
<termSec><term>kanał</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Один сигнал звукового файла; в стерео их два.</descrip>
<termSec><term>канал</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="mono">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">One channel.</descrip>
<termSec><term>mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jeden kanál.</descrip>
<termSec><term>mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
<termSec><term>monofonní (adj.)</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Kanal.</descrip>
<termSec><term>Mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un solo canal.</descrip>
<termSec><term>mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Invariable as an adjective ('pista mono', 'sonidos mono'); formal 'monofónico'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jeden kanał.</descrip>
<termSec><term>mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Indeclinable (ścieżka mono); adjective „monofoniczny” in formal text.</note></termSec>
<termSec><term>monofonia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Один канал.</descrip>
<termSec><term>моно</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Полная форма прилагательного — «монофонический».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="stereo">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Two channels, left and right.</descrip>
<termSec><term>stereo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Dva kanály, levý a pravý.</descrip>
<termSec><term>stereo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
<termSec><term>stereofonní (adj.)</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Zwei Kanäle, links und rechts.</descrip>
<termSec><term>Stereo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Dos canales, izquierdo y derecho.</descrip>
<termSec><term>estéreo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Written with accent; usually invariable as an adjective ('pistas estéreo').</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Dwa kanały: lewy i prawy.</descrip>
<termSec><term>stereo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Indeclinable; adjective „stereofoniczny”.</note></termSec>
<termSec><term>stereofonia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Два канала: левый и правый.</descrip>
<termSec><term>стерео</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Полная форма прилагательного — «стереофонический».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="mid-side">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Stereo written as the sum (mid) and the difference (side) of the channels.</descrip>
<termSec><term>mid/side</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Stereo zapsané jako součet (mid) a rozdíl (side) kanálů.</descrip>
<termSec><term>mid/side (M/S)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Engineers say 'M/S' or 'mid/side'; textbooks say 'signál M (součtový) a S (rozdílový)', as in 'MS stereofonie'.</note></termSec>
<termSec><term>střed/strana</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>součtový/rozdílový signál</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Stereo, dargestellt als Summe (Mitte) und Differenz (Seite) der Kanäle.</descrip>
<termSec><term>Mitte/Seite</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>German recording practice: MS-Verfahren, Mitten- und Seitensignal; DAW plug-ins often keep 'Mid/Side'.</note></termSec>
<termSec><term>M/S</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Mid/Side</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Estéreo expresado como la suma (mid, centro) y la diferencia (side, lateral) de los canales.</descrip>
<termSec><term>mid/side</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Spanish studio usage keeps 'Mid/Side' or 'M/S' (RØDE es: 'la técnica Mid-Side (también conocida como M-S)'); 'centro/lateral' and 'medio/lateral' appear in textbooks.</note></termSec>
<termSec><term>centro/lateral</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>medio/lateral</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zapis stereo jako sumy (mid, M) i różnicy (side, S) kanałów.</descrip>
<termSec><term>M/S</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Polish engineers say „M/S”, „technika M/S”, or „mid/side”; the descriptive „sygnał sumaryczny i różnicowy” is used in textbooks.</note></termSec>
<termSec><term>mid/side</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>sygnał sumaryczny i różnicowy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Стерео, записанное как сумма (мид) и разность (сайд) каналов.</descrip>
<termSec><term>мид/сайд</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>В студийной речи — «мид/сайд», «M/S-обработка»; в технической литературе — «MS-стереофония», «суммарно-разностное представление».</note></termSec>
<termSec><term>M/S</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>сумма/разность</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="phase">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Where in its cycle a wave is at a given moment.</descrip>
<termSec><term>phase</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">V jakém místě své periody se vlna v daném okamžiku nachází.</descrip>
<termSec><term>fáze</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">An welcher Stelle ihres Zyklus sich eine Welle zu einem bestimmten Zeitpunkt befindet.</descrip>
<termSec><term>Phase</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">En qué punto de su ciclo se encuentra una onda en un momento dado.</descrip>
<termSec><term>fase</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Miejsce w cyklu, w którym fala znajduje się w danej chwili.</descrip>
<termSec><term>faza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Положение волны внутри её цикла в данный момент.</descrip>
<termSec><term>фаза</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="polarity">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Whether a signal is upright or inverted.</descrip>
<termSec><term>polarity</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>phase</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zda je signál v původní orientaci, nebo obrácený.</descrip>
<termSec><term>polarita</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Use 'obrátit polaritu' (Ardour cs) and not 'obrátit fázi' when the signal is simply inverted.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ob ein Signal in ursprünglicher Lage oder invertiert ist.</descrip>
<termSec><term>Polarität</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>German studio speech often says 'Phase drehen' for a plain inversion; keep 'Polarität umkehren' for that, as the English does.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Si una señal está en su orientación normal o invertida.</descrip>
<termSec><term>polaridad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Spanish DAWs often label a plain inversion 'invertir fase' (Cubase es: 'Invertir fase'); in our UI and docs use 'invertir la polaridad'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">To, czy sygnał jest nieodwrócony, czy odwrócony.</descrip>
<termSec><term>biegunowość</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity pl: „biegunowość”; Ardour pl and studio speech: „polaryzacja” (in electronics „polaryzacja” also means bias, so „biegunowość” is the cleaner term). Do not say „odwrócenie fazy” for a plain inversion.</note></termSec>
<termSec><term>polaryzacja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">То, прямой сигнал или перевёрнутый (инвертированный).</descrip>
<termSec><term>полярность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Когда сигнал просто инвертирован, говорите «инверсия полярности», а не «переворот фазы».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="level">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">How strong a signal is, usually in dB.</descrip>
<termSec><term>level</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak silný je signál, obvykle v dB.</descrip>
<termSec><term>úroveň</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Úroveň signálu' is the audio-engineering term (also in RRTV EBU R 128 cz). 'Hladina' is the ČSN term for logarithmic acoustic quantities (hladina akustického tlaku), so use it only for dB SPL. Never 'hlasitost', which is loudness.</note></termSec>
<termSec><term>hladina</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie stark ein Signal ist, meist in dB.</descrip>
<termSec><term>Pegel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Pegel ≠ Lautheit. Avoid colloquial 'Lautstärke', which is used for both.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La magnitud de una señal, normalmente en dB.</descrip>
<termSec><term>nivel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Measured quantity; keep apart from 'sonoridad' (heard). Avoid 'volumen' in technical text.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Siła sygnału, zwykle w dB.</descrip>
<termSec><term>poziom</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Measured quantity. Do not use „głośność” for it, although everyday Polish calls the volume control „głośność”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Сила сигнала, обычно в дБ.</descrip>
<termSec><term>уровень</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Измеряемая величина, в отличие от громкости (воспринимаемой). Не пишите «уровень громкости» в значении level: в акустике это loudness level (в фонах).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="gain">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A change of level, in dB.</descrip>
<termSec><term>gain</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Změna úrovně, v dB.</descrip>
<termSec><term>zesílení</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Zesílení' is used in LMMS and Audacity cs, 'Zisk' in Ardour cs. A negative gain is still 'zesílení' (e.g. −6 dB); 'zeslabení' only in running text.</note></termSec>
<termSec><term>zisk</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>gain</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine Pegeländerung, in dB.</descrip>
<termSec><term>Gain</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Studio and DAW usage (Cubase, Logic). 'Verstärkung' (Audacity de) suggests only boosting, while a gain can be negative. Gender varies: das Gain / der Gain.</note></termSec>
<termSec><term>Verstärkung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Pegeländerung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un cambio de nivel, en dB.</descrip>
<termSec><term>ganancia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zmiana poziomu, w dB.</descrip>
<termSec><term>wzmocnienie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Audacity, Ardour, LMMS pl. A negative value is still „wzmocnienie” (−6 dB). „Gain” is common in speech (gain staging).</note></termSec>
<termSec><term>gain</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изменение уровня, в дБ.</descrip>
<termSec><term>усиление</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Как в русской Audacity («Усиление»); усиление может быть отрицательным. «Гейн» — студийный жаргон.</note></termSec>
<termSec><term>гейн</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="peak">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">The largest absolute sample value.</descrip>
<termSec><term>peak</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Největší absolutní hodnota vzorku.</descrip>
<termSec><term>špička</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Špičková úroveň' in RRTV EBU R 128 cz and in Czech metering (špičkový měřič). Audacity and Ardour cs use 'vrchol'. In this vocabulary 'vrchol' is kept for the top of an envelope or curve.</note></termSec>
<termSec><term>vrchol</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>špičková hodnota</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der größte Betrag der Abtastwerte.</descrip>
<termSec><term>Spitzenwert</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>German broadcast documents contrast 'Sample Peak' with 'True Peak' (ZDF Vorgaben 2022); meters label it 'Peak'. Use 'Spitzenpegel' for the value in dBFS. For a compact meter label 'Peak' is fine next to 'True Peak'.</note></termSec>
<termSec><term>Peak</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Sample-Peak</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Spitzenpegel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El mayor valor absoluto de las muestras.</descrip>
<termSec><term>pico</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio and DAW usage is 'pico' (Audacity es, Cubase es); ITU-R texts in Spanish say 'cresta' ('medidor de cresta de la muestra').</note></termSec>
<termSec><term>cresta</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Największa wartość bezwzględna próbki.</descrip>
<termSec><term>wartość szczytowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity pl („Szczyt”, „Poziom szczytowy”), TVP („miernik wartości szczytowej”).</note></termSec>
<termSec><term>szczyt</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>poziom szczytowy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Наибольшее абсолютное значение отсчёта.</descrip>
<termSec><term>пик</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Русская Audacity: «Пик», «пиковая амплитуда».</note></termSec>
<termSec><term>пиковое значение</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="true-peak">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">The peak of the signal between samples, as a DAC would reproduce it.</descrip>
<termSec><term>true peak</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Špička signálu mezi vzorky, jak by ji reprodukoval D/A převodník.</descrip>
<termSec><term>skutečná špičková úroveň</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>RRTV Czech translations of EBU R 128 and Tech 3341 ('maximální skutečná špičková úroveň'). The unit stays dBTP.</note></termSec>
<termSec><term>skutečná špička</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>true peak</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Spitzenwert des Signals zwischen den Abtastwerten, wie ihn ein D/A-Wandler wiedergeben würde.</descrip>
<termSec><term>True Peak</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>German broadcast usage keeps the English: ZDF Vorgaben 2022 'maximaler Spitzenpegel („Maximum True Peak Level“)', unit dBTP. Hyphenate in compounds: True-Peak-Pegel, True-Peak-Limiter.</note></termSec>
<termSec><term>True-Peak-Pegel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El pico de la señal entre muestras, tal como lo reproduciría un convertidor digital-analógico (DAC).</descrip>
<termSec><term>pico real</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>UIT-R BS.1770-5 (es) is titled '...el nivel de cresta de audio real' and uses 'nivel de cresta real', unit dBTP. Broadcast practice says 'pico real' or keeps 'true peak'.</note></termSec>
<termSec><term>true peak</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>cresta real</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Wartość szczytowa sygnału między próbkami, taka, jaką odtworzyłby przetwornik C/A.</descrip>
<termSec><term>true peak</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>No settled Polish term. TVP delivery specs write „Maksymalny chwilowy poziom sygnału („True Peak”)” and Ardour pl keeps „True Peak”; unit dBTP. Use the loan in the UI and add the Polish gloss on first use in docs. DAC = przetwornik C/A.</note></termSec>
<termSec><term>rzeczywisty poziom szczytowy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>maksymalny chwilowy poziom sygnału</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Пик сигнала между отсчётами — такой, каким его воспроизвёл бы ЦАП.</descrip>
<termSec><term>истинный пик</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Русская версия Рекомендации МСЭ-R BS.1770: «истинный пиковый уровень». В интерфейсе короче — «истинный пик»; единица dBTP.</note></termSec>
<termSec><term>истинный пиковый уровень</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="loudness">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">How loud a sound is heard, as opposed to its level.</descrip>
<termSec><term>loudness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak hlasitě je zvuk slyšet, na rozdíl od jeho úrovně.</descrip>
<termSec><term>hlasitost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Used in ČSN ISO 532-1, in RRTV EBU R 128 cz ('hlasitost pořadu', 'integrovaná hlasitost') and in Ardour/Audacity cs.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie laut ein Sound gehört wird, im Unterschied zu seinem Pegel.</descrip>
<termSec><term>Lautheit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>DIN 45631 / ISO 532-1; EBU R 128 in German practice ('Programmlautheit', 'Lautheitsbereich'). Not 'Lautstärke'; 'Lautstärkepegel' (phon) is a different quantity.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuán fuerte se oye un sonido, a diferencia de su nivel.</descrip>
<termSec><term>sonoridad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>UIT-R BS.1770 (es: 'Algoritmos para medir la sonoridad...') and Spanish psychoacoustics use 'sonoridad'; the loan 'loudness' is common in broadcast. Avoid 'volumen' (Audacity es 'Normalizar volumen') and 'intensidad sonora' (physical intensity, W/m²).</note></termSec>
<termSec><term>loudness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak głośno dźwięk jest słyszany, w odróżnieniu od jego poziomu.</descrip>
<termSec><term>głośność</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Psychoacoustic quantity (son, LUFS); KRRiT regulation Dz.U. 2013 poz. 48, Ardour pl („Analiza głośności”). Keep „poziom” for measured level. „Poziom głośności” in acoustics is loudness level in phons, while Polish broadcast rules use it for programme loudness in LUFS, so qualify it when you use it.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько громким звук воспринимается на слух — в отличие от его уровня.</descrip>
<termSec><term>громкость</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Русская версия МСЭ-R BS.1770, ISO 532-1: «громкость». Не путать с «уровнем громкости» (loudness level, в фонах).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="lufs">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Loudness units relative to full scale (ITU-R BS.1770); 1 LU is 1 dB.</descrip>
<termSec><term>LUFS</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jednotky hlasitosti vztažené k plné škále (ITU-R BS.1770); 1 LU odpovídá 1 dB.</descrip>
<termSec><term>LUFS</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>RRTV EBU R 128 cz expands it as 'jednotka hlasitosti vztažená k celému rozsahu'.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Lautheitseinheiten relativ zur digitalen Vollaussteuerung (ITU-R BS.1770); 1 LU entspricht 1 dB.</descrip>
<termSec><term>LUFS</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>ZDF Vorgaben 2022: 'Absolute Maßeinheit der Lautheit bezogen auf die digitale Vollaussteuerung'. Unit unchanged.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Unidades de sonoridad relativas a la escala completa (UIT-R BS.1770); 1 LU equivale a 1 dB.</descrip>
<termSec><term>LUFS</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Symbol unchanged. UIT-R BS.1770 (es) uses the equivalent LKFS ('sonoridad, ponderada en K, en relación con la plena escala nominal'); EBU R 128 uses LUFS. 'escala completa' is the usual practice; ITU = UIT in Spanish references.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jednostki głośności względem pełnej skali (ITU-R BS.1770); 1 LU to 1 dB.</descrip>
<termSec><term>LUFS</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>KRRiT regulation (Dz.U. 2013 poz. 48): LU, „jednostka pomiarowa głośności”; LUFS, „jednostka głośności wyrażona w LU w odniesieniu do pełnej skali”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Единицы громкости относительно полной шкалы (ITU-R BS.1770); 1 LU соответствует 1 дБ.</descrip>
<termSec><term>LUFS</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Пишется латиницей, как в EBU R 128 и русской Audacity («Громкость LUFS»). Русская версия BS.1770 использует равнозначное LKFS: «громкость, взвешенная по K, относительно номинальной полной шкалы».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="k-weighting">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">The frequency weighting that loudness meters apply before measuring.</descrip>
<termSec><term>K-weighting</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Frekvenční váhování, které měřiče hlasitosti používají před měřením.</descrip>
<termSec><term>frekvenční váhování K</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>RRTV Czech translation of EBU Tech 3341 ('frekvenční váhování'). For A/C weighting, Czech acoustics texts also write 'kmitočtové vážení' or 'váhový filtr'.</note></termSec>
<termSec><term>váhový filtr K</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>kmitočtové vážení K</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Frequenzbewertung, die Lautheitsmesser vor der Messung anwenden.</descrip>
<termSec><term>K-Bewertung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>ZDF Vorgaben 2022: 'K-Bewertungskurve nach ITU-R BS. 1770'; analogous to A-Bewertung.</note></termSec>
<termSec><term>K-Bewertungskurve</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>K-Filter</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La ponderación en frecuencia que aplican los medidores de sonoridad antes de medir.</descrip>
<termSec><term>ponderación K</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>UIT-R BS.1770 (es): 'ponderación de la frecuencia «K»'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Korekcja częstotliwościowa, którą mierniki głośności stosują przed pomiarem.</descrip>
<termSec><term>ważenie K</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Modelled on A-weighting in Polish noise standards („charakterystyka częstotliwościowa A”, „poziom dźwięku A”); „ważenie K” is the usual broadcast-engineering calque.</note></termSec>
<termSec><term>charakterystyka częstotliwościowa K</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>filtr K</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Частотное взвешивание, которое измерители громкости применяют к сигналу перед измерением.</descrip>
<termSec><term>K-взвешивание</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Термин русской версии МСЭ-R BS.1770; буква K латинская.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="normalize">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Set a sound's peak or loudness to a target.</descrip>
<termSec><term>normalize</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nastavit špičku nebo hlasitost zvuku na cílovou hodnotu.</descrip>
<termSec><term>normalizovat</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Audacity and Ardour cs 'Normalizovat'; noun 'normalizace hlasitosti' (RRTV, Audacity).</note></termSec>
<termSec><term>normalizace</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Den Spitzenwert oder die Lautheit eines Sounds auf einen Zielwert setzen.</descrip>
<termSec><term>Normalisieren</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Command 'Normalisieren' (Audacity, Cubase); noun 'Normalisierung'.</note></termSec>
<termSec><term>Normalisierung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Ajustar el pico o la sonoridad de un sonido a un valor objetivo.</descrip>
<termSec><term>normalizar</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Verb, as in Audacity es and Cubase es. Noun: 'normalización'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Ustawienie szczytu lub głośności dźwięku na wartość docelową.</descrip>
<termSec><term>normalizacja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Glossary form is the verbal noun; the UI command is „Normalizuj” (Audacity, Ardour pl). Specify „normalizacja szczytowa” or „normalizacja głośności”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Привести пик или громкость звука к целевому значению.</descrip>
<termSec><term>нормализовать</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Глагол — форма команды (русская Audacity: «Нормализовать пик амплитуды»); существительное «нормализация» — для документации и заголовков.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="fade">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A gradual change of level at the start (fade-in) or end (fade-out).</descrip>
<termSec><term>fade</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Postupná změna úrovně na začátku (fade-in) nebo na konci (fade-out).</descrip>
<termSec><term>fade</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech engineers say fade, fade-in, fade-out (pl. 'fady'). Ardour cs uses 'Postupné zesílení/zeslabení signálu', and Audacity cs 'Fade In (postupný náběh)' / 'Fade Out (do ztracena)'. 'Náběh' is avoided because it means attack here, and 'prolínání' because it means crossfade.</note></termSec>
<termSec><term>postupné zesílení / postupné zeslabení</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>postupná změna úrovně</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine allmähliche Pegeländerung am Anfang (Fade-in) oder am Ende (Fade-out).</descrip>
<termSec><term>Fade</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio and DAW usage (Ableton de 'Fades', Cubase/Logic 'Fade-In/Fade-Out'; Duden spells 'Fade-in/Fade-out'). Broadcast and Audacity de use 'Einblenden/Ausblenden', which also work well as command names.</note></termSec>
<termSec><term>Blende</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ein-/Ausblendung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un cambio gradual de nivel al principio (fundido de entrada) o al final (fundido de salida).</descrip>
<termSec><term>fundido</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Cubase es: 'fundido de entrada' / 'fundido de salida'. Audacity es uses 'Aparecer/Desvanecer progresivamente' (not recommended). 'fade in/out' is common in speech.</note></termSec>
<termSec><term>fade</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Stopniowa zmiana poziomu na początku (zgłośnienie, fade-in) lub na końcu (wyciszenie, fade-out).</descrip>
<termSec><term>przejście</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Generic „przejście” as in Audacity and Ardour pl („Typ przejścia”, „Długość przejścia”). For the two directions use „zgłośnienie” (fade-in) and „wyciszenie” (fade-out); Audacity has „Zgłośnienie”/„Ściszenie”. In speech, „fade-in/fade-out”.</note></termSec>
<termSec><term>fade</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zgłośnienie / wyciszenie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Постепенное изменение уровня в начале (фейд-ин) или в конце (фейд-аут) звука.</descrip>
<termSec><term>фейд</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Студийная норма — «фейд», «фейд-ин», «фейд-аут» (русская Audacity: «фейд-подъём/фейд-спад»). Не переводите fade-out как «затухание»: это слово занято термином decay.</note></termSec>
<termSec><term>плавное нарастание/затухание</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="clipping">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Distortion when a signal exceeds the largest value that can be stored.</descrip>
<termSec><term>clipping</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zkreslení, k němuž dojde, když signál překročí největší hodnotu, kterou lze uložit.</descrip>
<termSec><term>přebuzení</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Audacity cs ('Přebuzení', 'Najít přebuzení'). This is the everyday engineering word; technically the digital mechanism is 'ořezání (limitace) signálu'.</note></termSec>
<termSec><term>ořezání (clipping)</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>clipping</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Verzerrung, wenn ein Signal den größten speicherbaren Wert überschreitet.</descrip>
<termSec><term>Clipping</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Übersteuerung' is broader (also analogue, also without hard limiting); for the quality-check finding use 'Clipping'.</note></termSec>
<termSec><term>Übersteuerung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Distorsión que se produce cuando una señal supera el mayor valor que se puede almacenar.</descrip>
<termSec><term>clipping</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Cubase es keeps 'clipping'; Audacity es uses 'recorte'. The loan is recommended because 'recorte/recortar' also means trim/crop in editors. Do not call it 'saturación', reserved for soft saturation.</note></termSec>
<termSec><term>recorte</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>saturación digital</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zniekształcenie powstające, gdy sygnał przekracza największą wartość, jaką można zapisać.</descrip>
<termSec><term>przesterowanie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Ardour pl and studio speech use „przesterowanie” (clip indicator); Audacity pl uses „obcinanie” („Znajdź obcinanie”, „miękkie obcinanie”). Use „obcinanie (clipping)” where it must be told apart from analogue overdrive or saturation.</note></termSec>
<termSec><term>obcinanie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>clipping</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Искажение, возникающее, когда сигнал превышает наибольшее значение, которое можно сохранить.</descrip>
<termSec><term>клиппинг</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Как в русской Audacity и студийной речи; «перегрузка» шире (overload).</note></termSec>
<termSec><term>ограничение сигнала</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>срез пиков</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="dc-offset">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A constant shift of the signal away from zero.</descrip>
<termSec><term>DC offset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Stálý posun signálu od nuly.</descrip>
<termSec><term>stejnosměrná složka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity cs ('Odstranit stejnosměrnou složku'); standard electrical-engineering term.</note></termSec>
<termSec><term>stejnosměrný posun</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>DC offset</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine konstante Verschiebung des Signals weg von null.</descrip>
<termSec><term>DC-Offset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio usage 'DC-Offset'; Audacity de uses 'Gleichspannungsversatz'; textbooks 'Gleichanteil'.</note></termSec>
<termSec><term>Gleichanteil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Gleichspannungsversatz</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un desplazamiento constante de la señal respecto de cero.</descrip>
<termSec><term>desplazamiento DC</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity es: 'desplazamiento DC'. 'CC' (corriente continua) is Spain's abbreviation, 'CD' (corriente directa) is used in Mexico and parts of Latin America, so 'DC' is the neutral choice; 'offset de DC' in studio talk.</note></termSec>
<termSec><term>desplazamiento de CC</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>offset de DC</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Stałe przesunięcie sygnału względem zera.</descrip>
<termSec><term>składowa stała</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Electronics term for the DC component; Audacity pl: „offset DC”.</note></termSec>
<termSec><term>offset DC</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>przesunięcie DC</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Постоянный сдвиг сигнала относительно нуля.</descrip>
<termSec><term>DC-смещение</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>«DC-смещение» — как в русской Audacity; в инженерной литературе — «постоянная составляющая» («удалить постоянную составляющую»).</note></termSec>
<termSec><term>постоянная составляющая</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>смещение нуля</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="noise-floor">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">The level of the background noise under a sound.</descrip>
<termSec><term>noise floor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Úroveň šumu v pozadí pod zvukem.</descrip>
<termSec><term>šumové pozadí</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Usual engineering phrase, e.g. 'šumové pozadí −90 dB'. Audacity cs 'nežádoucí hluk' is not adopted.</note></termSec>
<termSec><term>úroveň šumu pozadí</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>noise floor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Pegel des Hintergrundrauschens unter einem Sound.</descrip>
<termSec><term>Grundrauschen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Rauschpegel' when the number is meant; 'Rauschteppich' is studio jargon.</note></termSec>
<termSec><term>Rauschpegel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Rauschteppich</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El nivel del ruido de fondo bajo un sonido.</descrip>
<termSec><term>nivel de ruido de fondo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'suelo de ruido' is Spain, 'piso de ruido' Latin America; 'nivel de ruido de fondo' is understood everywhere and names a level, as the definition does.</note></termSec>
<termSec><term>suelo de ruido</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>piso de ruido</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Poziom szumu tła, na którym leży dźwięk.</descrip>
<termSec><term>poziom szumu tła</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity pl: „Poziom szumu”. Equipment self-noise is „szumy własne”.</note></termSec>
<termSec><term>poziom szumów</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>noise floor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Уровень фонового шума под звуком.</descrip>
<termSec><term>уровень фонового шума</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Нижний порог шумов» — вариант русской Audacity; «шумовая полка» — жаргон измерений и студий. Не путать с порогом гейта.</note></termSec>
<termSec><term>шумовая полка</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>нижний порог шумов</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="silence">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A stretch with no sound above the noise floor.</descrip>
<termSec><term>silence</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Úsek bez zvuku nad úrovní šumového pozadí.</descrip>
<termSec><term>ticho</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Zeitraum ohne Schall oberhalb des Grundrauschens.</descrip>
<termSec><term>Stille</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un tramo sin sonido por encima del nivel de ruido de fondo.</descrip>
<termSec><term>silencio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Odcinek bez dźwięku powyżej poziomu szumu tła.</descrip>
<termSec><term>cisza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Участок, на котором нет звука выше уровня фонового шума.</descrip>
<termSec><term>тишина</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="cut-tail">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A sound that ends before its decay has died away.</descrip>
<termSec><term>cut tail</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zvuk, který skončí dřív, než jeho doznívání odezní.</descrip>
<termSec><term>useknuté doznění</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Uses 'doznění' for tail, as in all tail-related entries.</note></termSec>
<termSec><term>useknutý konec</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>useknutý ocas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Sound, der endet, bevor seine Abklingphase ausgeklungen ist.</descrip>
<termSec><term>abgeschnittener Ausklang</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Follows tail = Ausklang. Studio speech says 'der Hall reißt ab', hence 'abgerissenes Ende'. The short label reads as a quality-check finding.</note></termSec>
<termSec><term>abgerissenes Ende</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>abgeschnittene Fahne</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un sonido que termina antes de que su decaimiento se haya extinguido.</descrip>
<termSec><term>cola cortada</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Uses 'cola' (tail).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Dźwięk, który kończy się, zanim jego zanikanie dobiegnie końca.</descrip>
<termSec><term>ucięty ogon</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>ucięte wybrzmienie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Звук, который обрывается раньше, чем его затухание сошло на нет.</descrip>
<termSec><term>обрезанный хвост</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="take">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">One recorded or rendered version of a sound.</descrip>
<termSec><term>take</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jedna nahraná nebo vyrenderovaná verze zvuku.</descrip>
<termSec><term>take</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech studio usage is the loan 'take' (spoken 'tejk'). Ardour cs uses 'záběr' (film sense) or 'verze'. Keep it undeclined in UI where possible ('Take 3').</note></termSec>
<termSec><term>záběr</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>verze</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine aufgenommene oder gerenderte Version eines Sounds.</descrip>
<termSec><term>Take</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio and DAW usage (Cubase, Logic, Ableton 'Take-Lanes'). Duden: der oder das Take.</note></termSec>
<termSec><term>Aufnahme</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Version</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una versión grabada o renderizada de un sonido.</descrip>
<termSec><term>toma</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Cubase es: 'toma'. Universal in studio Spanish.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jedna nagrana lub wyrenderowana wersja dźwięku.</descrip>
<termSec><term>take</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour pl keeps „take” (genitive „take'a”). Polish film and recording studios also say „dubel”, which declines easily (duble, dubli). For generated output, „wersja” is a neutral fallback.</note></termSec>
<termSec><term>dubel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>podejście</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>wersja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Одна записанная или отрендеренная версия звука.</descrip>
<termSec><term>дубль</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="render">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Compute a processed sound and write it as audio.</descrip>
<termSec><term>render</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Vypočítat zpracovaný zvuk a zapsat ho jako audio.</descrip>
<termSec><term>renderovat</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Common studio usage. Audacity cs 'Spojit' (Mix and Render) is too vague. Noun: 'render'.</note></termSec>
<termSec><term>vyrenderovat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>bouncovat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Einen bearbeiteten Sound berechnen und als Audio schreiben.</descrip>
<termSec><term>Rendern</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Cubase de 'Rendern' (In-Place-Rendering); Logic de 'Bouncen'.</note></termSec>
<termSec><term>Bouncen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Berechnen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Calcular un sonido procesado y escribirlo como audio.</descrip>
<termSec><term>renderizar</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Studio verb (Cubase es: 'se renderiza'); Adobe es uses 'procesar', Audacity es 'generar'. Noun: 'renderizado'.</note></termSec>
<termSec><term>procesar</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>generar</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Obliczenie przetworzonego dźwięku i zapisanie go jako audio.</descrip>
<termSec><term>renderowanie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Audacity pl: „Renderuj”; Ardour pl uses „Zrzuć” for bounce. „Zgrać” is studio speech for writing a mix to a file.</note></termSec>
<termSec><term>zgrywanie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>bounce</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Вычислить обработанный звук и записать его как аудио.</descrip>
<termSec><term>отрендерить</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Глагол — форма команды; существительное — «рендер», «рендеринг» (русская Audacity: «Микширование и рендеринг»). «Просчитать/просчёт» — вариант из видеомонтажа.</note></termSec>
<termSec><term>просчитать</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="loop">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A sound that repeats without an audible join.</descrip>
<termSec><term>loop</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zvuk, který se opakuje bez slyšitelného spoje.</descrip>
<termSec><term>smyčka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Sound, der sich ohne hörbare Nahtstelle wiederholt.</descrip>
<termSec><term>Loop</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>DAW and sound-design usage (Ableton de 'Loop-Klammer'); 'Schleife' (Audacity de) sounds dated in this context. Duden: der Loop.</note></termSec>
<termSec><term>Schleife</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un sonido que se repite sin una unión audible.</descrip>
<termSec><term>bucle</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity es and Audition es: 'bucle' ('reproducir en bucle'); 'loop' (m) is common among producers for the sound itself and Cubase es keeps it. Both are understood everywhere.</note></termSec>
<termSec><term>loop</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Dźwięk, który powtarza się bez słyszalnego szwu.</descrip>
<termSec><term>pętla</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity, Ardour, LMMS pl; verb „zapętlić”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Звук, который повторяется без слышимого стыка.</descrip>
<termSec><term>луп</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Саунд-дизайнеры говорят «луп»; в русской Audacity «петля» — область циклического воспроизведения. Глагол — «зациклить».</note></termSec>
<termSec><term>петля</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>зацикленный звук</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="crossfade">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">A fade-out of one sound overlapping a fade-in of another.</descrip>
<termSec><term>crossfade</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Postupné zeslabení (fade-out) jednoho zvuku, které se překrývá s postupným zesílením (fade-in) jiného.</descrip>
<termSec><term>prolínání</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Used in Audacity, Ardour and LMMS cs. 'Prolnutí' for one instance.</note></termSec>
<termSec><term>prolnutí</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>crossfade</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Fade-out eines Sounds, der sich mit dem Fade-in eines anderen überlappt.</descrip>
<termSec><term>Crossfade</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Cubase and Ableton de keep 'Crossfade'; broadcast says 'Überblendung' or 'Kreuzblende'.</note></termSec>
<termSec><term>Überblendung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Kreuzblende</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un fundido de salida de un sonido que se superpone a un fundido de entrada de otro.</descrip>
<termSec><term>fundido cruzado</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Cubase es and Audacity es.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Wyciszenie jednego dźwięku nakładające się na zgłośnienie drugiego.</descrip>
<termSec><term>przenikanie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Audacity pl: „Przenikanie”; Ardour pl: „przejście krzyżowe”; in speech, „crossfade”.</note></termSec>
<termSec><term>przejście krzyżowe</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>crossfade</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Фейд-аут одного звука, перекрывающийся с фейд-ином другого.</descrip>
<termSec><term>кроссфейд</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Как в русской Audacity («Кроссфейд клипов»).</note></termSec>
<termSec><term>перекрёстное затухание</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="slice">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Cut a sound into parts at chosen points.</descrip>
<termSec><term>slice</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Rozdělit zvuk na části ve zvolených bodech.</descrip>
<termSec><term>rozřezat</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Producers also say 'slicovat'/'nasekat'. One resulting part is a 'díl' or 'výřez'.</note></termSec>
<termSec><term>rozsekat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>slicovat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Einen Sound an gewählten Stellen in Teile schneiden.</descrip>
<termSec><term>Slicen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>German DAW and sampler usage keeps 'slicen' (verb) and 'Slice' (the part). 'Zerteilen' is a plain German command if a loan-free UI is wanted.</note></termSec>
<termSec><term>Zerteilen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>In Slices schneiden</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cortar un sonido en partes en puntos elegidos.</descrip>
<termSec><term>trocear</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Ableton Live 12 es: 'Trocear a una nueva pista MIDI'; the pieces are 'trozos' (Cubase es) or 'rebanadas' (Ableton es).</note></termSec>
<termSec><term>slice</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Pocięcie dźwięku na części w wybranych punktach.</descrip>
<termSec><term>cięcie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Verbal noun as the glossary form; the UI command is „Potnij”. Call the parts „fragmenty” (sampler slang: „slice'y”). Audacity and Ardour pl use „Podziel” for split.</note></termSec>
<termSec><term>podział na fragmenty</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>slice</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Разрезать звук на части в выбранных точках.</descrip>
<termSec><term>нарезать</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Глагол — форма команды; действие — «нарезка», отдельная часть — «слайс» или «фрагмент».</note></termSec>
<termSec><term>слайсить</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="time-stretch">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Change a sound's duration without changing its pitch.</descrip>
<termSec><term>time stretch</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Změnit délku zvuku beze změny jeho výšky.</descrip>
<termSec><term>časové roztažení</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Like English 'stretch', this covers shortening too. Ardour cs has 'Protáhnutí času'; theses often keep 'time-stretching'.</note></termSec>
<termSec><term>time stretch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>změna délky</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Dauer eines Sounds ändern, ohne seine Tonhöhe zu ändern.</descrip>
<termSec><term>Time-Stretching</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Studio usage. 'Zeitdehnung' literally covers only lengthening (shortening would be 'Zeitstauchung'). Paired with Pitch-Shifting.</note></termSec>
<termSec><term>Zeitdehnung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Time-Stretch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cambiar la duración de un sonido sin cambiar su tono.</descrip>
<termSec><term>estiramiento temporal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity es: 'estiramiento de tiempo'; Cubase es: 'corrección de tiempo' for its warp feature; the loan 'time stretch' is common.</note></termSec>
<termSec><term>time stretch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zmiana długości dźwięku bez zmiany jego wysokości.</descrip>
<termSec><term>rozciąganie w czasie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Ardour pl („rozciąganie w czasie”), Audacity pl („rozciągnięty w czasie”).</note></termSec>
<termSec><term>time stretch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изменение длительности звука без изменения высоты тона.</descrip>
<termSec><term>растяжение по времени</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Русская Audacity: «растянутый по времени»; «тайм-стретч(инг)» — студийный жаргон.</note></termSec>
<termSec><term>тайм-стретч</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="pitch-shift">
<descrip type="subjectField">core</descrip>
<langSec xml:lang="en">
<descrip type="definition">Change a sound's pitch without changing its duration.</descrip>
<termSec><term>pitch shift</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Změnit výšku zvuku beze změny jeho délky.</descrip>
<termSec><term>posun výšky tónu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour cs ('Posun výšky tónu').</note></termSec>
<termSec><term>transpozice</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pitch shift</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Tonhöhe eines Sounds ändern, ohne seine Dauer zu ändern.</descrip>
<termSec><term>Pitch-Shifting</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Cubase de names the offline process 'Tonhöhenverschiebung'; studio speech says 'Pitch-Shifting' or 'pitchen'. Kept as a loan to pair with Time-Stretching.</note></termSec>
<termSec><term>Tonhöhenverschiebung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Tonhöhenänderung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cambiar el tono de un sonido sin cambiar su duración.</descrip>
<termSec><term>cambio de tono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity es: 'Cambiar tono'; Cubase es: 'Transposición'. 'tono' = pitch (formal 'altura').</note></termSec>
<termSec><term>transposición</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pitch shift</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zmiana wysokości dźwięku bez zmiany jego długości.</descrip>
<termSec><term>zmiana wysokości</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity pl: „Zmień wysokość” (Change Pitch), „Przesunięcie wysokości” (Pitch Shift). „Transpozycja” is the musical term, for whole-semitone shifts.</note></termSec>
<termSec><term>przesunięcie wysokości</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>transpozycja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pitch shift</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изменение высоты тона звука без изменения его длительности.</descrip>
<termSec><term>сдвиг высоты тона</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Русская Audacity: «Изменить высоту тона», «Смещение тона». «Транспонирование» — музыкальный синоним для сдвига на интервал.</note></termSec>
<termSec><term>питч-шифт</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>транспонирование</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="sone">
<descrip type="subjectField">psycho</descrip>
<langSec xml:lang="en">
<descrip type="definition">The unit of loudness as heard; 1 sone is the loudness of a 1 kHz tone at 40 dB SPL.</descrip>
<termSec><term>sone</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jednotka slyšené hlasitosti; 1 sone je hlasitost tónu 1 kHz o hladině 40 dB SPL.</descrip>
<termSec><term>sone</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>ISO 532-1. Czech texts name the unit 'son' (pl. 'sony', e.g. 'Jednotka hlasitosti je son', ZČU thesis). The unit is kept as 'sone' per this vocabulary's rule.</note></termSec>
<termSec><term>son</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Einheit der wahrgenommenen Lautheit; 1 sone ist die Lautheit eines 1-kHz-Tons mit 40 dB SPL.</descrip>
<termSec><term>Sone</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Unit symbol 'sone' unchanged; noun das Sone, pl. Sone (DIN 45631, Zwicker/Fastl).</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La unidad de sonoridad percibida; 1 sonio es la sonoridad de un tono de 1 kHz a 40 dB SPL.</descrip>
<termSec><term>sonio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Wikipedia es: 'El sonio o son es una unidad de sonoridad'; UPV acoustics notes use 'sonio'. Plural 'sonios'.</note></termSec>
<termSec><term>son</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jednostka głośności (słyszanej); 1 son to głośność tonu 1 kHz o poziomie 40 dB SPL.</descrip>
<termSec><term>son</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish Wikipedia: „Son (głośność dźwięku)”; plural „sony”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Единица воспринимаемой громкости; 1 сон — громкость тона 1 кГц при уровне звукового давления 40 дБ.</descrip>
<termSec><term>сон</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Русское название единицы (Вологдин, «Слух и восприятие звука», 2012; Акустический журнал, 2022). Обозначение «сон» с числом не склоняется, как «дБ».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="sharpness">
<descrip type="subjectField">psycho</descrip>
<langSec xml:lang="en">
<descrip type="definition">How much a sound's energy sits at high frequencies, as heard; in acum.</descrip>
<termSec><term>sharpness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Do jaké míry leží energie zvuku ve vysokých frekvencích, jak je slyšet; v acum.</descrip>
<termSec><term>ostrost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>DIN 45692. Standard Czech psychoacoustic term ('hlasitost, ostrost a drsnost', Czech music-acoustics research, RIV 2006). Reserved, so 'ostrý' must not be used for harshness.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie stark die Energie eines Sounds nach dem Höreindruck bei hohen Frequenzen liegt; in acum.</descrip>
<termSec><term>Schärfe</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>DIN 45692 'Messtechnische Simulation der Hörempfindung Schärfe'; the concept comes from German psychoacoustics (von Bismarck, Aures, Zwicker). Not the same as Härte (harshness).</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuánta energía de un sonido se concentra en las frecuencias altas, tal como se percibe; en acum.</descrip>
<termSec><term>agudeza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Spanish sound-quality literature: 'agudeza (sharpness)'. Some papers gloss it as 'nitidez': avoid, it means clarity. Unit acum unchanged (DIN 45692).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo energia dźwięku skupia się w wysokich częstotliwościach, w odbiorze słuchowym; jednostka: acum.</descrip>
<termSec><term>ostrość</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish psychoacoustics (A. Preis, UAM Poznań, in naukawpolsce.pl). Studio speech also calls a harsh sound „ostry”, but in these apps „ostrość” is kept for DIN 45692 sharpness only; harshness is „nieprzyjemność”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько энергия звука сосредоточена в области высоких частот — по ощущению; измеряется в акумах.</descrip>
<termSec><term>резкость</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Римская-Корсакова и др., «Оценки раздражающего действия шума», Акустический журнал, 2022, № 5; Стаценко и др., 2023: «резкость», единица «акум». Не путать с жёсткостью (harshness).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="roughness">
<descrip type="subjectField">psycho</descrip>
<langSec xml:lang="en">
<descrip type="definition">The rasping quality of fast amplitude modulation (about 15–300 Hz); in asper.</descrip>
<termSec><term>roughness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Chraplavý vjem rychlé amplitudové modulace (asi 15–300 Hz); v asper.</descrip>
<termSec><term>drsnost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Drsnost' is used in Czech psychoacoustic research on musical signals; some theses (ZČU) say 'hrubost'. Reserved, so 'drsný' must not be used for harshness.</note></termSec>
<termSec><term>hrubost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der raue, schnarrende Höreindruck schneller Amplitudenmodulation (etwa 15–300 Hz); in asper.</descrip>
<termSec><term>Rauigkeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Zwicker/Fastl's German texts spell 'Rauhigkeit' (pre-1996 spelling); current spelling 'Rauigkeit', occasionally 'Rauheit'. Distinct from Härte (harshness) and Schärfe (sharpness).</note></termSec>
<termSec><term>Rauhigkeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Rauheit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La cualidad rasposa de la modulación de amplitud rápida (aproximadamente 15–300 Hz); en asper.</descrip>
<termSec><term>rugosidad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Spanish literature uses both 'rugosidad' and 'aspereza' for Zwicker's roughness (UPV paper: 'roughness (aspereza, rugosidad)'). We use only 'rugosidad' and keep 'aspereza' out of the psychoacoustic set, so that harshness ('estridencia') cannot be read as roughness. Unit asper unchanged.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zgrzytliwa, chropawa jakość brzmienia wynikająca z szybkiej modulacji amplitudy (ok. 15–300 Hz); jednostka: asper.</descrip>
<termSec><term>chropowatość</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>A. Preis (naukawpolsce.pl) and M. Gałuszka (twojazielonka.org) use „chropowatość”; „szorstkość” is an equivalent variant also found in Polish texts. Keep both away from harshness („nieprzyjemność”).</note></termSec>
<termSec><term>szorstkość</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Хриплый, скрежещущий характер звучания, создаваемый быстрой амплитудной модуляцией (примерно 15–300 Гц); измеряется в асперах.</descrip>
<termSec><term>хриплость</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>В русской научной психоакустике — «хриплость» (Ищенко, Акустический журнал, 1977; Римская-Корсакова и др., 2022; Стаценко и др., 2023). «Шероховатость» — калька из популярных и переводных текстов; найти её у Алдошиной не удалось. Не путать с жёсткостью (harshness).</note></termSec>
<termSec><term>шероховатость</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="fluctuation-strength">
<descrip type="subjectField">psycho</descrip>
<langSec xml:lang="en">
<descrip type="definition">The sensation of slow amplitude modulation (about 1–20 Hz, strongest near 4 Hz); in vacil.</descrip>
<termSec><term>fluctuation strength</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Vjem pomalé amplitudové modulace (asi 1–20 Hz, nejsilnější kolem 4 Hz); ve vacil.</descrip>
<termSec><term>síla fluktuace</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Both 'síla fluktuace' and 'fluktuační síla' (ZČU thesis) occur.</note></termSec>
<termSec><term>fluktuační síla</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>síla kolísání</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Empfindung langsamer Amplitudenmodulation (etwa 1–20 Hz, am stärksten um 4 Hz); in vacil.</descrip>
<termSec><term>Schwankungsstärke</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Zwicker/Fastl.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La sensación de la modulación de amplitud lenta (aproximadamente 1–20 Hz, máxima cerca de 4 Hz); en vacil.</descrip>
<termSec><term>fuerza de fluctuación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Calque of Fluktuationsstärke. 'intensidad de fluctuación' also occurs, but 'intensidad' clashes with sound intensity; UPV notes say 'fuerza fluctuante'. Unit vacil.</note></termSec>
<termSec><term>intensidad de fluctuación</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Wrażenie wywołane wolną modulacją amplitudy (ok. 1–20 Hz, najsilniejsze w pobliżu 4 Hz); jednostka: vacil.</descrip>
<termSec><term>siła fluktuacji</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>A. Preis (naukawpolsce.pl), M. Gałuszka (twojazielonka.org).</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Ощущение медленной амплитудной модуляции (примерно 1–20 Гц, сильнее всего около 4 Гц); измеряется в василах.</descrip>
<termSec><term>сила флуктуаций</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Акустический журнал, 2022, и Стаценко и др., 2023: «сила флуктуаций», единица «васил» (vacil); в первой статье встречается и «сила колебаний». Написание «флюктуаций» устарело.</note></termSec>
<termSec><term>сила колебаний</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="psychoacoustic-annoyance">
<descrip type="subjectField">psycho</descrip>
<langSec xml:lang="en">
<descrip type="definition">Zwicker's combination of loudness, sharpness, roughness and fluctuation strength into one annoyance value.</descrip>
<termSec><term>psychoacoustic annoyance</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zwickerovo spojení hlasitosti, ostrosti, drsnosti a síly fluktuace do jediné hodnoty obtěžování.</descrip>
<termSec><term>psychoakustické obtěžování</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Obtěžování' is the ČSN term for noise annoyance (ČSN ISO 1996-1). 'Nepříjemnost' is left for harshness, which is derived from it.</note></termSec>
<termSec><term>psychoakustická nepříjemnost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>index obtěžování</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Zwickers Zusammenfassung von Lautheit, Schärfe, Rauigkeit und Schwankungsstärke zu einem einzigen Lästigkeitswert.</descrip>
<termSec><term>psychoakustische Lästigkeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Widmann/Zwicker; Fastl and Zwicker 2007. Because 'Lästigkeit' is taken here, it is not used for harshness.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La combinación, propuesta por Zwicker, de sonoridad, agudeza, rugosidad y fuerza de fluctuación en un único valor de molestia.</descrip>
<termSec><term>molestia psicoacústica</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'molestia' is the standard Spanish term for noise annoyance (UPV notes: 'modelo de molestia/agrado de Zwicker').</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zaproponowane przez Zwickera połączenie głośności, ostrości, chropowatości i siły fluktuacji w jedną wartość uciążliwości.</descrip>
<termSec><term>uciążliwość psychoakustyczna</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>„Uciążliwość hałasu” is the established Polish noise-annoyance term in environmental acoustics; A. Preis uses „dokuczliwość”. Harshness („nieprzyjemność”) is derived from it but is a separate term.</note></termSec>
<termSec><term>dokuczliwość psychoakustyczna</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Предложенное Цвикером объединение громкости, резкости, хриплости и силы флуктуаций в единую величину раздражения.</descrip>
<termSec><term>психоакустическое раздражение</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Термин и сокращение ПАР — Римская-Корсакова и др., Акустический журнал, 2022; Стаценко и др., 2023. «Раздражающее действие шума» — общий термин гигиены шума.</note></termSec>
<termSec><term>раздражающее действие</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="masking">
<descrip type="subjectField">psycho</descrip>
<langSec xml:lang="en">
<descrip type="definition">One sound making another harder or impossible to hear.</descrip>
<termSec><term>masking</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jev, kdy jeden zvuk ztěžuje nebo znemožňuje slyšet jiný zvuk.</descrip>
<termSec><term>maskování</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Sound macht einen anderen schwerer oder gar nicht hörbar.</descrip>
<termSec><term>Verdeckung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Zwicker/Fastl and German psychoacoustics: Verdeckung, Mithörschwelle; studio and codec literature also say 'Maskierung'.</note></termSec>
<termSec><term>Maskierung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Que un sonido haga que otro sea más difícil o imposible de oír.</descrip>
<termSec><term>enmascaramiento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zjawisko, w którym jeden dźwięk utrudnia lub uniemożliwia usłyszenie innego.</descrip>
<termSec><term>maskowanie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Standard in Polish psychoacoustics, audiology („maskowanie przesłuchu”, UAM) and perceptual coding. Polish Wikipedia titles the article „Zagłuszanie (akustyka)”, but audio usage is „maskowanie”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Явление, при котором один звук делает другой хуже слышимым или вовсе неслышимым.</descrip>
<termSec><term>маскировка</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Вологдин, 2012; Акустический журнал: «маскировка», «слуховая маскировка».</note></termSec>
<termSec><term>маскирование</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="critical-band">
<descrip type="subjectField">psycho</descrip>
<langSec xml:lang="en">
<descrip type="definition">The frequency range the ear integrates as one; on the Bark scale.</descrip>
<termSec><term>critical band</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Frekvenční rozsah, který ucho integruje jako celek; vyjadřuje se na Barkově stupnici.</descrip>
<termSec><term>kritické pásmo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Standard ('kritická pásma slyšení', 'Barkova stupnice').</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Frequenzbereich, den das Gehör zu einer Einheit zusammenfasst; angegeben auf der Bark-Skala (Tonheit).</descrip>
<termSec><term>Frequenzgruppe</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Zwicker's German term (Frequenzgruppe, Tonheit in Bark); 'kritisches Band' is a back-translation from English.</note></termSec>
<termSec><term>kritisches Band</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>kritische Bandbreite</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El rango de frecuencias que el oído integra como una unidad; en la escala Bark.</descrip>
<termSec><term>banda crítica</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zakres częstotliwości, który słuch integruje jako całość; wyrażany w skali Bark.</descrip>
<termSec><term>pasmo krytyczne</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Bark scale: „skala Bark” (Polish Wikipedia: „Bark (skala)”), unit „bark”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Диапазон частот, который слух объединяет в одно целое; отсчитывается по шкале барков.</descrip>
<termSec><term>критическая полоса</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Вологдин, 2012: «критические полосы слуха», единица «барк».</note></termSec>
<termSec><term>критическая полоса слуха</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="curve">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A value drawn over time along the waveform.</descrip>
<termSec><term>curve</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Hodnota vykreslená v čase podél vlnového průběhu.</descrip>
<termSec><term>křivka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Wert, der über der Zeit entlang der Wellenform gezeichnet wird.</descrip>
<termSec><term>Kurve</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un valor dibujado a lo largo del tiempo, siguiendo la forma de onda.</descrip>
<termSec><term>curva</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Wartość wykreślona w czasie wzdłuż przebiegu.</descrip>
<termSec><term>krzywa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Величина, нарисованная во времени вдоль формы волны.</descrip>
<termSec><term>кривая</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="overview">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A small picture of a whole sound used to find one's way in it.</descrip>
<termSec><term>overview</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Malý obraz celého zvuku, který slouží k orientaci v něm.</descrip>
<termSec><term>přehled</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>náhled</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>přehledové zobrazení</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein kleines Bild eines ganzen Sounds, mit dem man sich darin zurechtfindet.</descrip>
<termSec><term>Übersicht</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Überblick</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Übersichtsanzeige</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una imagen pequeña de un sonido completo que sirve para orientarse en él.</descrip>
<termSec><term>vista general</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Cubase es: 'Línea de vista global' (overview line); 'vista general' is the more common Spanish UI term.</note></termSec>
<termSec><term>vista global</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Mały obraz całego dźwięku, który pomaga się w nim zorientować.</descrip>
<termSec><term>widok ogólny</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Bare „podgląd” means preview, so it is avoided as the main term.</note></termSec>
<termSec><term>podgląd całości</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>przegląd</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>miniatura</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Небольшое изображение всего звука, помогающее в нём ориентироваться.</descrip>
<termSec><term>обзор</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>обзорная полоса</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>миниатюра</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="strip">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The overview of one sound as Playhead draws it: waveform, curves and marks in one band.</descrip>
<termSec><term>strip</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>lane</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Přehled jednoho zvuku tak, jak ho kreslí Playhead: vlnový průběh, křivky a značky v jednom pásu.</descrip>
<termSec><term>pás</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Chosen so that a 'pás' (strip) contains 'pruhy' (lanes), as in a road with lanes. 'Proužek' is friendlier but diminutive; 'lišta' suggests a toolbar; 'strip' is clear to DAW users but does not decline well.</note></termSec>
<termSec><term>proužek</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>lišta</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>strip</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Übersicht eines Sounds, wie Playhead sie zeichnet: Wellenform, Kurven und Markierungen in einem Band.</descrip>
<termSec><term>Streifen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Streifen' is literal, visual and collides with no DAW term; avoid 'Spur' (= track) and plain 'Band' (frequency band). 'Leiste' reads like a toolbar. A Lane is part of a Streifen.</note></termSec>
<termSec><term>Leiste</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Strip</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Übersichtsstreifen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La vista general de un sonido tal como la dibuja Playhead: forma de onda, curvas y marcas en una sola franja.</descrip>
<termSec><term>tira</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'tira' as in 'tira de canal' (channel strip) and film strip. 'franja' is kept for the generic 'band' used in definitions; 'banda' is avoided because of frequency bands. The loan is unlikely in UI.</note></termSec>
<termSec><term>franja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>banda</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>strip</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Widok ogólny jednego dźwięku w postaci, w jakiej rysuje go Playhead: przebieg, krzywe i znaczniki w jednym pasie.</descrip>
<termSec><term>pasek</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Pasek” is the natural Polish UI word for a horizontal band; it is also used for toolbars („pasek narzędzi”), but „pasek dźwięku” is unambiguous in context. „Taśma” is evocative (tape) but suggests a recording medium; „pas” is neutral but stiff. A lane is „tor”, part of a „pasek”.</note></termSec>
<termSec><term>pas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>taśma</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>strip</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Обзор одного звука в том виде, в каком его рисует Playhead: форма волны, кривые и метки в одной полосе.</descrip>
<termSec><term>лента</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Лента» наглядна и свободна («полоса» нужна для частотных полос, «стрип» напоминает channel strip — канальную линейку). Дорожка (lane) — часть ленты.</note></termSec>
<termSec><term>полоса</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>стрип</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="look">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A named way to draw a strip, written as a short code of layers.</descrip>
<termSec><term>look</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>skin, theme</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Pojmenovaný způsob kreslení pásu, zapsaný jako krátký kód vrstev.</descrip>
<termSec><term>vzhled</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Vzhled' reads most naturally ('Vzhled: klasický', 'Kód vzhledu'), but Firefox cs calls themes 'Vzhledy'. If chosen, name colour themes 'barevný motiv' to keep look ≠ theme. 'Podoba' avoids the clash but sounds less natural in UI.</note></termSec>
<termSec><term>podoba</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>styl zobrazení</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>look</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine benannte Art, einen Streifen zu zeichnen, festgelegt durch einen kurzen Code aus Ebenen.</descrip>
<termSec><term>Look</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Look' is an established German loan (Duden; film and photo grading) and stays unambiguous as a named, coded object; 'Darstellung' and 'Ansicht' are already used in UIs for generic display options and zoom/scroll views. Not 'Skin', not 'Design/Theme' (colours only).</note></termSec>
<termSec><term>Darstellung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ansicht</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Darstellungsstil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una forma, con nombre propio, de dibujar una tira, escrita como un código breve de capas.</descrip>
<termSec><term>estilo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'estilo' reads as a named, reusable set of drawing choices (like text styles) and stays distinct from 'tema' (theme). 'aspecto' is the OS word for appearance/theme, which the English avoids; 'look' (an anglicism listed by the DLE) is natural in speech but odd in UI ('Guardar look'); 'vista' clashes with 'vista general'.</note></termSec>
<termSec><term>aspecto</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>look</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>vista</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Nazwany sposób rysowania paska, zapisany jako krótki kod warstw.</descrip>
<termSec><term>styl</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Wygląd” is the literal choice, but Polish UIs use „Wygląd” for Appearance/theme settings (and „motyw” for theme), which the source says to keep apart. „Styl” reads well („kod stylu”, „Styl: …”). „Odsłona” is idiomatic („w nowej odsłonie”) but also means a page view.</note></termSec>
<termSec><term>wygląd</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>odsłona</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>look</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Именованный способ отрисовки ленты, записанный в виде короткого кода из слоёв.</descrip>
<termSec><term>облик</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Облик» не занят в интерфейсах (в отличие от меню «Вид») и не путается с «темой» (только цвета) и «скином»; «стиль» слишком общий, «лук» — разговорная калька.</note></termSec>
<termSec><term>вид</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>стиль</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>лук</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="look-code">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The short text that defines a look, for example "form:overlay,shape:mirror,lane:harshness".</descrip>
<termSec><term>look code</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Krátký text, který definuje vzhled, například „form:overlay,shape:mirror,lane:harshness“.</descrip>
<termSec><term>kód vzhledu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Follows the choice for 'look'. The code's keys and values are not translated.</note></termSec>
<termSec><term>kód podoby</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zápis vzhledu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>look code</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der kurze Text, der einen Look festlegt, zum Beispiel „form:overlay,shape:mirror,lane:harshness“.</descrip>
<termSec><term>Look-Code</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Follows the choice for 'look' ('Darstellungscode' if 'Darstellung' is chosen). The code keywords stay English because they are syntax.</note></termSec>
<termSec><term>Darstellungscode</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Look-Kürzel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El texto breve que define un estilo, por ejemplo "form:overlay,shape:mirror,lane:harshness".</descrip>
<termSec><term>código de estilo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Follows 'look'. The code keywords (form, overlay, shape, mirror, lane, harshness) are syntax and stay in English.</note></termSec>
<termSec><term>código de aspecto</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>código de look</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Krótki tekst definiujący styl, np. „form:overlay,shape:mirror,lane:harshness”.</descrip>
<termSec><term>kod stylu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Follows the choice made for look. The code keywords stay in English.</note></termSec>
<termSec><term>kod wyglądu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>kod looku</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Короткий текст, задающий облик, например «form:overlay,shape:mirror,lane:harshness».</descrip>
<termSec><term>код облика</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Следует выбору для look; сам код не переводится, ключи и значения остаются латиницей.</note></termSec>
<termSec><term>код вида</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>строка облика</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>лук-код</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="layer">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">One element of a look: a waveform, spectrogram, curve, set of marks or sections.</descrip>
<termSec><term>layer</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jeden prvek vzhledu: vlnový průběh, spektrogram, křivka, sada značek nebo oddíly.</descrip>
<termSec><term>vrstva</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>The usual word, also used in Ardour cs for overlaid/stacked layers. The same word is used for sound layers in 'remix vrstev'; context separates them. 'Prvek' is vaguer but would avoid that overlap.</note></termSec>
<termSec><term>prvek</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>layer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Element eines Looks: eine Wellenform, ein Spektrogramm, eine Kurve, eine Gruppe von Markierungen oder Abschnitte.</descrip>
<termSec><term>Ebene</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Ebene' as in German graphics software (Photoshop, GIMP). This deliberately separates drawing layers from the sound layers of the layer-remix tool, for which the sound-design loan 'Layer' is used.</note></termSec>
<termSec><term>Layer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Schicht</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un elemento de un estilo: una forma de onda, un espectrograma, una curva, un conjunto de marcas o las secciones.</descrip>
<termSec><term>capa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'capa' is universal for graphic layers (image editors) and for sound layers in sound design, matching the English double use (see layer-remix). 'plano' is a possible but vaguer alternative.</note></termSec>
<termSec><term>plano</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>layer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jeden element stylu: przebieg, spektrogram, krzywa, zestaw znaczników lub sekcje.</descrip>
<termSec><term>warstwa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>„Warstwa” is universal in Polish graphics and audio software. Like the English, it is also used for the separated sound layers in the layer remix tool; „element” is the fallback if the two meanings must be kept apart.</note></termSec>
<termSec><term>element</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>składnik</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>layer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Один элемент облика: форма волны, спектрограмма, кривая, набор меток или разметка частей.</descrip>
<termSec><term>слой</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Слой» привычен по графическим редакторам; то же слово стоит в «пересведении слоёв» (звуковые слои). Если их нужно развести, для облика подойдёт «элемент облика», «пласт» — книжно.</note></termSec>
<termSec><term>элемент облика</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>пласт</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="lane">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A horizontal band of a strip that holds one curve.</descrip>
<termSec><term>lane</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Vodorovná část pásu, ve které je vykreslena jedna křivka.</descrip>
<termSec><term>pruh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour cs ('pruh automatizace' = automation lane); also 'jízdní pruh' = traffic lane.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein waagerechtes Band eines Streifens, das eine Kurve enthält.</descrip>
<termSec><term>Lane</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>As in German DAWs (Ableton de 'Take-Lanes', 'Automations-Lane'; Cubase de 'Lanes'). Avoid 'Spur' (= track). 'Bahn' is the German option for a loan-free UI.</note></termSec>
<termSec><term>Bahn</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Zeile</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una franja horizontal de una tira que contiene una curva.</descrip>
<termSec><term>carril</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Cubase es: 'Carriles' (lanes). Avoid 'pista' (track).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Poziomy pas w obrębie paska, w którym mieści się jedna krzywa.</descrip>
<termSec><term>tor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>As in „tor automatyki”. This avoids „ścieżka” (track) and „pasmo” (frequency band).</note></termSec>
<termSec><term>pas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>linia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Горизонтальная полоса ленты, содержащая одну кривую.</descrip>
<termSec><term>дорожка</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Как «дорожки автоматизации» в русских DAW. «Полоса» тоже возможна, но занята частотными полосами (эквалайзер, критические полосы).</note></termSec>
<termSec><term>полоса</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="overlay">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Curves drawn in one shared band instead of separate lanes.</descrip>
<termSec><term>overlaid</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Křivky kreslené do jednoho společného pruhu místo do samostatných pruhů.</descrip>
<termSec><term>překryté</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Ardour cs 'Překryto' (overlaid layer display). Neuter, agreeing with 'zobrazení'. 'Přes sebe' is the clearest toggle label. Distinct from 'zrcadlené' (mirrored).</note></termSec>
<termSec><term>přes sebe</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>v jednom pruhu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>překrývající se</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Kurven, die in einem gemeinsamen Band statt in getrennten Lanes gezeichnet werden.</descrip>
<termSec><term>überlagert</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Option value next to 'gespiegelt' and 'von der Grundlinie'. Not 'überblendet' (= crossfaded).</note></termSec>
<termSec><term>übereinander</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Overlay</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Curvas dibujadas en una franja común en lugar de en carriles separados.</descrip>
<termSec><term>superpuesto</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Adjective that agrees ('curvas superpuestas'); the mode as a noun is 'superposición'. Must stay distinct from 'en espejo' (mirrored).</note></termSec>
<termSec><term>superposición</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Krzywe rysowane w jednym wspólnym pasie zamiast w osobnych torach.</descrip>
<termSec><term>nałożone</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Adjective (krzywe nałożone); noun „nałożenie”. Distinct from mirrored („lustrzane”).</note></termSec>
<termSec><term>nakładane</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>we wspólnym torze</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Кривые, нарисованные в одной общей полосе, а не на отдельных дорожках.</descrip>
<termSec><term>наложенный</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Прилагательное согласуется с существительным («наложенные кривые»); в переключателе формы — «Наложение». Не путать с «зеркальным»: наложение — общая полоса, зеркальность — симметрия.</note></termSec>
<termSec><term>внахлёст</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="mirrored">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Drawn symmetrically above and below a centre line, like a waveform.</descrip>
<termSec><term>mirrored</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Kreslené souměrně nad a pod středovou čárou, jako vlnový průběh.</descrip>
<termSec><term>zrcadlené</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Neuter, agreeing with 'zobrazení'; use 'zrcadlený průběh' etc. when agreeing with a masculine noun.</note></termSec>
<termSec><term>souměrné</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Symmetrisch über und unter einer Mittellinie gezeichnet, wie eine Wellenform.</descrip>
<termSec><term>gespiegelt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Kept distinct from 'überlagert' (overlaid).</note></termSec>
<termSec><term>symmetrisch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Dibujado simétricamente por encima y por debajo de una línea central, como una forma de onda.</descrip>
<termSec><term>en espejo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Invariable and visual; 'simétrico' is acceptable in docs. Not to be confused with 'superpuesto' (overlaid).</note></termSec>
<termSec><term>simétrico</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>reflejado</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Rysowane symetrycznie nad linią środkową i pod nią, jak przebieg.</descrip>
<termSec><term>lustrzane</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Adjective that agrees with its noun (krzywa lustrzana, przebieg lustrzany). Not „nałożone” (overlaid).</note></termSec>
<termSec><term>symetryczne</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>odbite</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Нарисованный симметрично выше и ниже центральной линии, как форма волны.</descrip>
<termSec><term>зеркальный</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>В переключателе формы — наречие «Зеркально». Не путать с «наложенным».</note></termSec>
<termSec><term>симметричный</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="baseline-form">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Drawn upwards from the bottom of the band.</descrip>
<termSec><term>from the baseline</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Kreslené od spodního okraje pruhu nahoru.</descrip>
<termSec><term>od základny</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Adverbial phrase, used as a mode label next to 'zrcadlené' and 'překryté'.</note></termSec>
<termSec><term>od spodní hrany</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>od základní čáry</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Vom unteren Rand des Bandes nach oben gezeichnet.</descrip>
<termSec><term>von der Grundlinie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Grundlinie = bottom edge of the band, not the waveform's zero line (that is the Mittellinie).</note></termSec>
<termSec><term>ab Grundlinie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>von unten</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Dibujado hacia arriba desde la parte inferior de la franja.</descrip>
<termSec><term>desde la línea de base</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>desde abajo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Rysowane w górę od dolnej krawędzi pasa.</descrip>
<termSec><term>od podstawy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Adverbial option label, alongside „lustrzane” and „nałożone”.</note></termSec>
<termSec><term>od linii bazowej</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>od dołu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Нарисованный вверх от нижнего края полосы.</descrip>
<termSec><term>от базовой линии</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Не «от нуля»: базовая линия — низ полосы, а не нулевой уровень сигнала.</note></termSec>
<termSec><term>от основания</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>снизу вверх</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="horizon-chart">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A compact chart that folds a curve into coloured bands of increasing intensity.</descrip>
<termSec><term>horizon chart</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Kompaktní graf, který křivku skládá do barevných pásem se vzrůstající intenzitou.</descrip>
<termSec><term>horizontový graf</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>No established Czech term found; this is a calque. Czech data-visualisation texts usually keep 'horizon chart'.</note></termSec>
<termSec><term>horizon chart</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein kompaktes Diagramm, das eine Kurve in farbige Bänder zunehmender Intensität zusammenfaltet.</descrip>
<termSec><term>Horizon-Chart</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>German visualisation writing mostly keeps the English (also 'Horizon Graph', Heer et al. 2009); 'Horizontdiagramm' is understandable but rarely attested.</note></termSec>
<termSec><term>Horizontdiagramm</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un gráfico compacto que pliega una curva en bandas de color de intensidad creciente.</descrip>
<termSec><term>gráfico de horizonte</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>No settled Spanish term in data-visualisation literature; 'gráfico de horizonte' is the transparent calque. Docs may add '(horizon chart)' on first use.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zwarty wykres, który składa krzywą w kolorowe pasma o rosnącej intensywności.</descrip>
<termSec><term>wykres horyzontowy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>I found no competing Polish term; the calque is transparent. Give „(horizon chart)” on first mention in docs.</note></termSec>
<termSec><term>horizon chart</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Компактный график, который складывает кривую в цветные полосы нарастающей интенсивности.</descrip>
<termSec><term>горизонтный график</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Так в русскоязычных текстах о визуализации данных (dev.by: «Горизонтный график (Horizon graphs)»); общепринятого стандарта нет.</note></termSec>
<termSec><term>график-горизонт</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="sculpted-waveform">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A waveform whose height follows a curve, for example perceived loudness, instead of the peak level.</descrip>
<termSec><term>sculpted waveform</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Vlnový průběh, jehož výška sleduje křivku, například vnímanou hlasitost, místo špičkové úrovně.</descrip>
<termSec><term>tvarovaný vlnový průběh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Tvarovaný' (shaped) is neutral and clear. 'Modelovaný' is closer to sculpting but clashes with the physical models in Workbench (model nárazu). The loan would be unusual.</note></termSec>
<termSec><term>modelovaný vlnový průběh</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>vytvarovaný průběh</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>sculpted waveform</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine Wellenform, deren Höhe statt des Spitzenpegels einer Kurve folgt, zum Beispiel der wahrgenommenen Lautheit.</descrip>
<termSec><term>modellierte Wellenform</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'modellieren' also means shaping by hand (clay), so it carries 'sculpted'; 'geformt' is neutral but bland; 'skulptiert' is not idiomatic German.</note></termSec>
<termSec><term>geformte Wellenform</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Kurven-Wellenform</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Sculpted Waveform</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una forma de onda cuya altura sigue una curva, por ejemplo la sonoridad percibida, en lugar del nivel de pico.</descrip>
<termSec><term>forma de onda esculpida</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Literal 'esculpida' keeps the image and is unambiguous; 'modelada' sounds more technical but collides with 'modelado' (physical modelling); 'perfilada' is softer.</note></termSec>
<termSec><term>forma de onda modelada</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>forma de onda perfilada</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Przebieg, którego wysokość podąża za krzywą, np. za postrzeganą głośnością, zamiast za poziomem szczytowym.</descrip>
<termSec><term>przebieg rzeźbiony</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Rzeźbić brzmienie” is a common Polish studio metaphor, so the literal rendering works; the adjective follows the noun, as in classifying Polish terms (przebieg szczytowy). „Kształtowany” is plainer but less distinctive.</note></termSec>
<termSec><term>przebieg kształtowany</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>rzeźbiona fala</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>sculpted waveform</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Форма волны, высота которой повторяет кривую (например, воспринимаемую громкость), а не пиковый уровень.</descrip>
<termSec><term>вылепленная форма волны</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Вылепленная» точно передаёт sculpted и наглядна; «рельефная» звучит естественнее, но намекает на объём и тени; «по кривой» однозначно, но не похоже на название.</note></termSec>
<termSec><term>рельефная форма волны</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>форма волны по кривой</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>скульптурная форма волны</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="outline">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The ordinary peak waveform drawn as a thin line behind another layer.</descrip>
<termSec><term>outline</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Běžný špičkový vlnový průběh nakreslený tenkou čarou za jinou vrstvou.</descrip>
<termSec><term>obrys</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die gewöhnliche Spitzenwert-Wellenform, als dünne Linie hinter einer anderen Ebene gezeichnet.</descrip>
<termSec><term>Umriss</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>Kontur</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Outline</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La forma de onda de picos habitual, dibujada como una línea fina detrás de otra capa.</descrip>
<termSec><term>contorno</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Avoid 'perfil' (used for the analysis profile).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zwykły przebieg szczytowy narysowany cienką linią za inną warstwą.</descrip>
<termSec><term>kontur</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>obrys</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Обычная пиковая форма волны, нарисованная тонкой линией позади другого слоя.</descrip>
<termSec><term>контур</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="marks">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Ticks along the strip at events, onsets, beats or section boundaries.</descrip>
<termSec><term>marks</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Rysky podél pásu u událostí, nástupů, dob nebo hranic oddílů.</descrip>
<termSec><term>značky</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Ardour cs uses 'Značka' for marker. Plural noun.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Striche entlang des Streifens an Ereignissen, Onsets, Beats oder Abschnittsgrenzen.</descrip>
<termSec><term>Markierungen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Not 'Marker': in DAWs those are user-set position markers.</note></termSec>
<termSec><term>Marken</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ticks</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Pequeñas marcas a lo largo de la tira en eventos, inicios, pulsos o límites de sección.</descrip>
<termSec><term>marcas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Distinct from 'marcadores' (user markers in DAWs).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Kreski wzdłuż paska w miejscach zdarzeń, początków dźwięków, miar lub granic sekcji.</descrip>
<termSec><term>znaczniki</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour and Audacity pl: „znacznik” = marker.</note></termSec>
<termSec><term>kreski</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>znaczki</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Засечки вдоль ленты в местах событий, онсетов, долей или границ частей.</descrip>
<termSec><term>метки</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Не «маркеры»: в DAW маркер — отметка, которую ставит пользователь.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="legend">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The text that says what each colour and line of a strip shows.</descrip>
<termSec><term>legend</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Text, který říká, co jednotlivé barvy a čáry pásu znázorňují.</descrip>
<termSec><term>legenda</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Text, der angibt, was jede Farbe und jede Linie eines Streifens zeigt.</descrip>
<termSec><term>Legende</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El texto que indica qué muestra cada color y cada línea de una tira.</descrip>
<termSec><term>leyenda</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Tekst objaśniający, co pokazuje każdy kolor i każda linia paska.</descrip>
<termSec><term>legenda</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Подпись, поясняющая, что показывает каждый цвет и каждая линия ленты.</descrip>
<termSec><term>легенда</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Как в русских Excel и библиотеках графиков.</note></termSec>
<termSec><term>условные обозначения</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="profile">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How much Playhead analyses: fast (curves only), sound effect, or music.</descrip>
<termSec><term>analysis profile</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Kolik toho Playhead analyzuje: rychlý profil (jen křivky), zvukový efekt nebo hudba.</descrip>
<termSec><term>profil analýzy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>rozsah analýzy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie viel Playhead analysiert: schnell (nur Kurven), Soundeffekt oder Musik.</descrip>
<termSec><term>Analyseprofil</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
<termSec><term>Profil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuánto analiza Playhead: rápido (solo curvas), efecto de sonido o música.</descrip>
<termSec><term>perfil de análisis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zakres analizy wykonywanej przez Playhead: szybki (tylko krzywe), efekt dźwiękowy lub muzyka.</descrip>
<termSec><term>profil analizy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько подробно Playhead анализирует звук: «быстрый» (только кривые), «звуковой эффект» или «музыка».</descrip>
<termSec><term>профиль анализа</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="descriptor">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A number or curve computed from a sound that describes one of its properties.</descrip>
<termSec><term>descriptor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Číslo nebo křivka vypočtená ze zvuku, která popisuje jednu jeho vlastnost.</descrip>
<termSec><term>deskriptor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech MIR usage ('zvukové deskriptory').</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine aus einem Sound berechnete Zahl oder Kurve, die eine seiner Eigenschaften beschreibt.</descrip>
<termSec><term>Deskriptor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Peeters et al. 2011 (Timbre Toolbox).</note></termSec>
<termSec><term>Audiodeskriptor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Klangdeskriptor</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un número o una curva calculados a partir de un sonido que describen una de sus propiedades.</descrip>
<termSec><term>descriptor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Liczba lub krzywa obliczona z dźwięku, opisująca jedną z jego właściwości.</descrip>
<termSec><term>deskryptor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish MPEG-7 and MIR literature: „deskryptory audio”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Число или кривая, вычисленные по звуку и описывающие одно из его свойств.</descrip>
<termSec><term>дескриптор</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Как в русской литературе по MIR («аудиодескрипторы»; Peeters et al. 2011).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="feature">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A descriptor used as input to a classifier or search.</descrip>
<termSec><term>feature</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Deskriptor použitý jako vstup klasifikátoru nebo vyhledávání.</descrip>
<termSec><term>příznak</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech pattern-recognition term ('příznakový vektor', 'kepstrální příznaky', ČVUT).</note></termSec>
<termSec><term>rys</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>feature</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Deskriptor, der als Eingabe für einen Klassifikator oder eine Suche dient.</descrip>
<termSec><term>Merkmal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>German pattern-recognition usage: Merkmal, Merkmalsextraktion, Merkmalsvektor; MIR jargon also says 'Feature'. Keeps feature ≠ descriptor.</note></termSec>
<termSec><term>Feature</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un descriptor que se usa como entrada de un clasificador o de una búsqueda.</descrip>
<termSec><term>característica</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Standard in Spanish machine learning ('extracción de características'); 'rasgo' is less common.</note></termSec>
<termSec><term>rasgo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Deskryptor używany jako wejście klasyfikatora lub wyszukiwania.</descrip>
<termSec><term>cecha</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish machine-learning usage („wektor cech”, „ekstrakcja cech”).</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Дескриптор, используемый как входные данные для классификатора или поиска.</descrip>
<termSec><term>признак</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Признак» — норма русского машинного обучения; «фича» — разговорный жаргон.</note></termSec>
<termSec><term>фича</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="activity">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How much is happening: spectral change and the density of events.</descrip>
<termSec><term>activity</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Kolik se toho děje: spektrální změny a hustota událostí.</descrip>
<termSec><term>aktivita</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Aktivita' is clear and fits UI phrases. 'Dění' is the most idiomatic ('kolik se toho děje') but awkward as a curve name. 'Ruch' is avoided because 'ruchy' means Foley.</note></termSec>
<termSec><term>dění</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>rušnost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>activity</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie viel passiert: spektrale Veränderung und Dichte der Ereignisse.</descrip>
<termSec><term>Aktivität</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Literal, immediately clear and short. 'Bewegtheit' is a musicological term with a similar meaning but less suited to a UI label. Not 'Aktivierung' (psychology, close to arousal).</note></termSec>
<termSec><term>Bewegtheit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Geschehen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Activity</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuánto está ocurriendo: el cambio espectral y la densidad de eventos.</descrip>
<termSec><term>actividad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Literal and idiomatic coincide. 'dinamismo' risks confusion with dynamics ('dinámica'); 'movimiento' collides with 'movimiento espectral'.</note></termSec>
<termSec><term>dinamismo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>movimiento</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Ile się dzieje: zmiany widma i gęstość zdarzeń.</descrip>
<termSec><term>aktywność</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Literal and clear. „Ruchliwość” is more idiomatic for a busy sound but sounds more evaluative; „zagęszczenie zdarzeń” covers only half the definition.</note></termSec>
<termSec><term>ruchliwość</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zagęszczenie zdarzeń</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>activity</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько много всего происходит: изменения спектра и плотность событий.</descrip>
<termSec><term>активность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Активность» проста и понятна; «оживлённость» и «событийность» ближе к смыслу, но тяжелее. Не путать с arousal (возбуждение).</note></termSec>
<termSec><term>оживлённость</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>событийность</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="arousal">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How exciting or calming a sound is, after the psychological dimension of the same name.</descrip>
<termSec><term>arousal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak vzrušující, nebo naopak zklidňující zvuk je; podle stejnojmenné psychologické dimenze.</descrip>
<termSec><term>vzrušení</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Czech psychology often keeps the loan ('valence a arousal', declined 'arousalu') or uses 'excitace'. 'Aktivace' is avoided next to 'aktivita' (activity).</note></termSec>
<termSec><term>arousal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>excitace</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>aktivace</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie aufregend oder beruhigend ein Sound wirkt, nach der gleichnamigen psychologischen Dimension.</descrip>
<termSec><term>Erregung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>German emotion psychology uses both 'Erregung' and the loan 'Arousal' (valence/arousal after Russell). Not 'Aktivierung' (collides with Aktivität) and not 'Anregung' (= excitation in cross-synthesis).</note></termSec>
<termSec><term>Arousal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuán excitante o calmante es un sonido, por analogía con la dimensión psicológica del mismo nombre.</descrip>
<termSec><term>activación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Spanish emotion research pairs 'valencia' and 'activación' (e.g. Spanish and Rioplatense work on the SAM scale and IADS sounds); the loan 'arousal' appears in academic texts. 'excitación' is avoided for its other connotations.</note></termSec>
<termSec><term>arousal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo dźwięk ekscytuje lub uspokaja; od wymiaru psychologicznego o tej nazwie.</descrip>
<termSec><term>pobudzenie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Polish emotion psychology: „pobudzenie” (the valence–arousal model is „walencja–pobudzenie”).</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько звук возбуждает или успокаивает — по одноимённому измерению в психологии эмоций.</descrip>
<termSec><term>возбуждение</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>В русской психологии эмоций (модель Рассела «валентность — возбуждение») встречаются «возбуждение» и «активация»; «активация» слишком близка к activity. Не путать с «возбуждением» (excitation) в кросс-синтезе.</note></termSec>
<termSec><term>активация</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="harshness">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How unpleasant a sound is to listen to, computed from psychoacoustic annoyance; not the same as roughness.</descrip>
<termSec><term>harshness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>roughness, sharpness</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak nepříjemné je zvuk poslouchat, odvozeno z psychoakustického obtěžování; není totéž co drsnost.</descrip>
<termSec><term>nepříjemnost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>The everyday Czech words for 'harsh' (ostrý, drsný) are taken by sharpness and roughness. 'Nepříjemnost' follows the definition and differs from 'obtěžování' (annoyance), its input. 'Tvrdost' is idiomatic in mixing but clashes with material hardness in Workbench. 'Drásavost' is expressive but close to roughness.</note></termSec>
<termSec><term>tvrdost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>drásavost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>harshness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie unangenehm ein Sound anzuhören ist, abgeleitet aus der psychoakustischen Lästigkeit; nicht dasselbe wie Rauigkeit.</descrip>
<termSec><term>Härte</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Härte' is studio jargon ('Härten in den Hochmitten'), short, and clearly separate from Schärfe and Rauigkeit; risk: confusion with material or mallet hardness in the impact model, so write those as compounds ('Schlägelhärte'). 'Harschheit' is unambiguous but rare; 'Lästigkeit' is taken by psychoacoustic annoyance.</note></termSec>
<termSec><term>Harschheit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Aggressivität</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Harshness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuán desagradable resulta escuchar un sonido, a partir de la molestia psicoacústica; no es lo mismo que la rugosidad.</descrip>
<termSec><term>estridencia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'aspereza' is the most idiomatic translation of 'harshness' in mixing talk, but Spanish psychoacoustics also uses it for roughness (asper), the exact confusion the source warns against. 'estridencia' (DLE 'estridente': agudo, desapacible y chirriante) names the unpleasantness without a technical clash; 'dureza' collides with hardness (mallet, material, impact model).</note></termSec>
<termSec><term>aspereza</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>dureza</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>harshness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak nieprzyjemny w słuchaniu jest dźwięk, obliczana z uciążliwości psychoakustycznej; nie to samo co chropowatość.</descrip>
<termSec><term>nieprzyjemność</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Studio Polish calls harsh sound „ostry”, but „ostrość” is taken by sharpness and „chropowatość”/„szorstkość” by roughness, so a third word is needed. „Nieprzyjemność” follows the definition directly; „przykrość” is shorter but sounds emotional (sorrow); „jazgotliwość” is vivid but colloquial and suggests loud din.</note></termSec>
<termSec><term>przykrość</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>jazgotliwość</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>harshness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько неприятно слушать звук; вычисляется на основе психоакустического раздражения; не то же самое, что хриплость.</descrip>
<termSec><term>жёсткость</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Звукорежиссёры называют harsh-звук «жёстким» или «резким», но «резкость» занята sharpness, поэтому — «жёсткость»; остальные варианты описательны или непонятны без английского. Хриплость и резкость — входные величины, а не синонимы.</note></termSec>
<termSec><term>режущий характер</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>неприятность звучания</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>харшнесс</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="tension">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Build-up and release over time, after the model of musical tension by Farbood (2012).</descrip>
<termSec><term>tension</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Narůstání a uvolňování v čase, podle modelu hudebního napětí, který navrhla Farbood (2012).</descrip>
<termSec><term>napětí</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>The surname is left uninflected with a feminine verb (modern usage), instead of 'Farboodová'.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Aufbau und Lösung über die Zeit, nach Farboods Modell der musikalischen Spannung.</descrip>
<termSec><term>Spannung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Established in musicology (Spannung und Entspannung/Lösung). In technical prose 'Spannung' can be read as electrical voltage; write 'musikalische Spannung' where needed.</note></termSec>
<termSec><term>Spannungsverlauf</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Spannungsbogen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Acumulación y distensión a lo largo del tiempo, según el modelo de tensión musical de Farbood (2012).</descrip>
<termSec><term>tensión</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'tensión/distensión' is the Spanish music-theory pair for build-up and release.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narastanie i rozładowanie w czasie, według modelu napięcia muzycznego Farbood (2012).</descrip>
<termSec><term>napięcie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Polish music theory pair „napięcie – rozładowanie (odprężenie)”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Нарастание и разрядка во времени — по модели музыкального напряжения Фарбуд.</descrip>
<termSec><term>напряжение</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Farbood 2012. «Напряжение» — обычный термин теории музыки; «напряжённость» книжнее.</note></termSec>
<termSec><term>напряжённость</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="harmonic-tension">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How far the harmony is from rest, from the tonal interval space.</descrip>
<termSec><term>harmonic tension</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak daleko je harmonie od klidu, určeno z tonálního intervalového prostoru.</descrip>
<termSec><term>harmonické napětí</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Tonální intervalový prostor' is a calque of tonal interval space (Bernardes et al. 2016).</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie weit die Harmonik von der Ruhe entfernt ist, bestimmt im tonalen Intervallraum.</descrip>
<termSec><term>harmonische Spannung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Bernardes et al. 2016 (Tonal Interval Space, TIV).</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuán lejos está la armonía del reposo, según el espacio de intervalos tonales.</descrip>
<termSec><term>tensión armónica</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Bernardes et al.'s Tonal Interval Space = 'espacio de intervalos tonales'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak daleko harmonia jest od stanu spoczynku, wyznaczone w tonalnej przestrzeni interwałów.</descrip>
<termSec><term>napięcie harmoniczne</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько гармония удалена от состояния покоя; вычисляется в тональном интервальном пространстве.</descrip>
<termSec><term>гармоническое напряжение</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Bernardes et al. 2016 (Tonal Interval Space).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="novelty">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How much a moment differs from what came before.</descrip>
<termSec><term>novelty</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak moc se daný okamžik liší od toho, co mu předcházelo.</descrip>
<termSec><term>novost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Foote 2000; 'křivka novosti' for the novelty curve. Kept apart from 'spektrální překvapení' and 'překvapivost'.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie sehr sich ein Moment vom Vorangegangenen unterscheidet.</descrip>
<termSec><term>Neuheit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Foote 2000. German MIR writing (e.g. AudioLabs Erlangen) mostly keeps 'Novelty-Kurve' in English. Keep distinct from 'spektrale Überraschung' and 'Informationsgehalt' (surprisal).</note></termSec>
<termSec><term>Novelty</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuánto difiere un momento de lo que vino antes.</descrip>
<termSec><term>novedad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'curva/función de novedad' (Foote) in Spanish MIR.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo dana chwila różni się od tego, co było wcześniej.</descrip>
<termSec><term>nowość</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Foote's novelty function is „funkcja nowości”. Keep it distinct from „zaskoczenie widmowe” and „informacja własna”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько момент отличается от того, что было до него.</descrip>
<termSec><term>новизна</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Foote 2000: «функция новизны». Новизна учитывает и изменения уровня — в отличие от спектральной неожиданности.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="spectral-surprise">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Change of the spectrum that loudness does not explain.</descrip>
<termSec><term>spectral surprise</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>novelty</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Změna spektra, kterou nelze vysvětlit hlasitostí.</descrip>
<termSec><term>spektrální překvapení</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Parallels the English and stays distinct from 'novost' (novelty) and 'překvapivost' (surprisal) by word form. 'Nečekaná změna spektra' is clearer but long. 'Spektrální zvrat' is short but suggests a reversal.</note></termSec>
<termSec><term>nečekaná změna spektra</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>spektrální zvrat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>spectral surprise</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Veränderung des Spektrums, die sich nicht durch die Lautheit erklären lässt.</descrip>
<termSec><term>spektrale Überraschung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Literal and clear; stays apart from 'Neuheit' (which also includes level changes) and from 'Informationsgehalt' (surprisal). Never shorten to bare 'Überraschung', or the line to surprisal blurs.</note></termSec>
<termSec><term>Spektralüberraschung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>unerklärte Klangänderung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Spectral Surprise</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cambio del espectro que la sonoridad no explica.</descrip>
<termSec><term>sorpresa espectral</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>The literal rendering is natural and keeps the English pairing; keep it apart from 'novedad' (novelty) and 'autoinformación' (surprisal). 'cambio espectral inesperado' is clearer but too long for UI.</note></termSec>
<termSec><term>imprevisto espectral</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>cambio espectral inesperado</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zmiana widma, której nie wyjaśnia głośność.</descrip>
<termSec><term>zaskoczenie widmowe</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Literal and natural. It only works if surprisal is „informacja własna” and never bare „zaskoczenie”. „Niespodzianka” sounds playful; the descriptive form is clear but long.</note></termSec>
<termSec><term>niespodzianka widmowa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>nieoczekiwana zmiana widma</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>spectral surprise</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изменение спектра, не объясняемое громкостью.</descrip>
<termSec><term>спектральная неожиданность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Буквальный вариант ясен, но «неожиданность» встречается и как перевод surprisal, поэтому в тексте всегда пишите полностью; «сюрприз» звучит несерьёзно, описательный вариант точен, но длинен.</note></termSec>
<termSec><term>спектральный сюрприз</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>необъяснённое изменение спектра</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="surprisal">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Information content of an event: the less expected, the higher.</descrip>
<termSec><term>surprisal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Informační obsah události: čím je méně očekávaná, tím je vyšší.</descrip>
<termSec><term>překvapivost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>In Czech information theory the quantity is 'vlastní informace' (self-information); 'překvapivost' is the readable UI name. Note the pair překvapivost (surprisal) / spektrální překvapení (spectral surprise).</note></termSec>
<termSec><term>vlastní informace</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>informační obsah</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>surprisal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Informationsgehalt eines Ereignisses: je weniger erwartet, desto höher.</descrip>
<termSec><term>Informationsgehalt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Standard German information-theory term (Shannon: Informationsgehalt, Selbstinformation); music cognition and psycholinguistics also use the loan 'Surprisal'. 'Überraschungswert' avoided so it cannot be confused with spectral surprise.</note></termSec>
<termSec><term>Surprisal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Selbstinformation</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Contenido de información de un evento: cuanto menos esperado, mayor.</descrip>
<termSec><term>autoinformación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Information-theory term (self-information); music-expectation literature (IDyOM) says 'contenido de información (IC)'. 'sorpresa' is avoided because it would merge with 'sorpresa espectral'.</note></termSec>
<termSec><term>contenido de información</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zawartość informacyjna zdarzenia: im mniej oczekiwane, tym wyższa.</descrip>
<termSec><term>informacja własna</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish information-theory term for self-information (Polish Wikipedia: „Ilość informacji”). Music-cognition papers sometimes write „zaskoczenie”; that is avoided here to keep it apart from spectral surprise.</note></termSec>
<termSec><term>ilość informacji</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>surprisal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Информационное содержание события: чем оно менее ожидаемо, тем выше значение.</descrip>
<termSec><term>собственная информация</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Стандартный русский термин теории информации (self-information); в психолингвистике всё чаще «сюрпризал». Не переводите как «неожиданность», чтобы не смешать со спектральной неожиданностью (Abdallah and Plumbley 2009).</note></termSec>
<termSec><term>сюрпризал</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>информационное содержание</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="structural-change">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Where a piece moves to a new part, signed: up where sound enters, down where it falls away or breaks off.</descrip>
<termSec><term>structural change</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Místo, kde skladba přechází do nové části, se znaménkem: nahoru tam, kde zvuk vstupuje, dolů tam, kde odeznívá nebo se přeruší.</descrip>
<termSec><term>strukturní změna</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Strukturní změna' is a literal, neutral term that suits a signed curve. 'Předěl' is idiomatic for a move to a new part but suggests a point, not a curve. 'Strukturální' is also correct. 'Vstupuje' is used for 'enters' so as not to clash with 'nástup' (onset).</note></termSec>
<termSec><term>předěl</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>změna struktury</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>structural change</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wo ein Stück in einen neuen Teil übergeht, mit Vorzeichen: nach oben, wo Klang einsetzt, nach unten, wo er wegfällt oder abbricht.</descrip>
<termSec><term>Strukturwechsel</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Strukturwechsel' is short and neutral (works for SFX as well as music); 'Formwechsel' is more musicological; 'strukturelle Änderung' is literal but long. Signed labels in the UI: 'oben: Einsatz, unten: Wegfall oder Abbruch'.</note></termSec>
<termSec><term>Formwechsel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>strukturelle Änderung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Teilwechsel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Dónde una pieza pasa a una parte nueva, con signo: hacia arriba donde entra sonido, hacia abajo donde cae o se corta.</descrip>
<termSec><term>cambio estructural</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'cambio de sección' is friendlier but blurs with the section marks. In the Playhead UI the signed legend reads 'arriba: entrada; abajo: caída o corte'.</note></termSec>
<termSec><term>cambio de sección</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>transición estructural</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Miejsce, w którym utwór przechodzi do nowej części; ze znakiem: w górę tam, gdzie dźwięk wchodzi, w dół tam, gdzie zanika lub się urywa.</descrip>
<termSec><term>zmiana strukturalna</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>„Strukturalna” matches MIR usage („analiza struktury utworu”); „zmiana formy” is the musicological wording. In the app's short legends, up/down are „wejście” / „spadek lub urwanie”.</note></termSec>
<termSec><term>zmiana formy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>przejście formalne</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>structural change</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Место, где произведение переходит к новой части; со знаком: вверх — там, где звук вступает, вниз — там, где он спадает или обрывается.</descrip>
<termSec><term>структурное изменение</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Буквальный вариант нейтрален и сохраняет знак; «смена части» идиоматична, но знака не передаёт; «структурный сдвиг» звучит как экономический термин.</note></termSec>
<termSec><term>смена части</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>структурный сдвиг</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="local-pulse">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How clearly a regular pulse is felt at each moment.</descrip>
<termSec><term>local pulse</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>beat strength</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak silně a pravidelně je v každém okamžiku cítit doba.</descrip>
<termSec><term>lokální puls</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Calque of Grosche and Müller's (predominant) local pulse. Avoid 'síla doby' (beat strength).</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie stark und regelmäßig in jedem Moment ein Beat spürbar ist.</descrip>
<termSec><term>lokaler Puls</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Grosche and Müller 2011 (predominant local pulse, PLP). Not 'Beat-Stärke'.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué fuerza y regularidad se percibe un pulso en cada momento.</descrip>
<termSec><term>pulso local</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Grosche and Müller's PLP = 'pulso local predominante'. Avoid 'fuerza del pulso' (beat strength).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak wyraźnie w każdej chwili odczuwalny jest regularny puls.</descrip>
<termSec><term>puls lokalny</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Grosche &amp; Müller's PLP = „dominujący puls lokalny”. Avoid „siła beatu/miary” (beat strength). Its measure is „wyrazistość pulsu” (pulse clarity).</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько сильно и регулярно в каждый момент ощущается пульсация долей.</descrip>
<termSec><term>локальный пульс</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Grosche and Müller 2011 (PLP — «преобладающий локальный пульс»). Не называйте «силой доли» (beat strength).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="onset">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The moment a sound or note begins.</descrip>
<termSec><term>onset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Okamžik, kdy začíná zvuk nebo tón.</descrip>
<termSec><term>nástup</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech MIR says 'nástup (tónu)' or 'detekce nástupů', often alongside 'onset'. A moment, kept apart from 'náběh' (attack, a phase) and 'tranzient'.</note></termSec>
<termSec><term>začátek</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>onset</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Moment, in dem ein Sound oder ein Ton beginnt.</descrip>
<termSec><term>Onset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>German MIR and DSP usage keeps 'Onset' (Onset-Detektion); musicians say '(Ton-)Einsatz'. Onset (instant) ≠ Attack (phase up to the peak) ≠ Transiente (fast change).</note></termSec>
<termSec><term>Einsatz</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Toneinsatz</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El momento en que empieza un sonido o una nota.</descrip>
<termSec><term>inicio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Spanish MIR often keeps 'onset' ('detección de onsets'); 'inicio' (de nota, de sonido) keeps it distinct from 'ataque' (a phase of the sound) and 'transitorio' (a signal feature).</note></termSec>
<termSec><term>onset</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Chwila, w której zaczyna się dźwięk lub nuta.</descrip>
<termSec><term>początek dźwięku</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour pl („Rozdziel na początkach dźwięków perkusyjnych”, „czas między początkami dźwięków”); MIR jargon „onset”. It is a moment; „atak” is the phase and „transjent” the change.</note></termSec>
<termSec><term>onset</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Момент начала звука или ноты.</descrip>
<termSec><term>онсет</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>В русской MIR-литературе — «онсет» или «начало ноты». «Онсет» короче и не смешивается с атакой (участок от начала до пика) и транзиентом (быстрое изменение). В пользовательских текстах при первом упоминании: «онсет (начало звука)».</note></termSec>
<termSec><term>начало звука</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>момент начала</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="onset-strength">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How strongly new sound arrives at each moment; peaks are hits.</descrip>
<termSec><term>onset strength</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak silně v každém okamžiku přichází nový zvuk; vrcholy odpovídají úderům.</descrip>
<termSec><term>síla nástupu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>síla nástupů</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>onset strength</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie stark in jedem Moment neuer Schall einsetzt; Spitzen sind Hits.</descrip>
<termSec><term>Onset-Stärke</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Einsatzstärke</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué fuerza llega sonido nuevo en cada momento; sus picos son golpes.</descrip>
<termSec><term>fuerza de inicio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'intensidad' avoided (physical quantity).</note></termSec>
<termSec><term>fuerza de onset</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak silnie w każdej chwili pojawia się nowy dźwięk; szczyty to uderzenia.</descrip>
<termSec><term>siła początków dźwięku</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Technical docs may use „funkcja detekcji początków” (onset detection function).</note></termSec>
<termSec><term>siła onsetu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>funkcja detekcji początków</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько сильно в каждый момент появляется новый звук; пики — это удары.</descrip>
<termSec><term>сила онсетов</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>сила начал</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="event">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">One distinct sound within a file, such as a hit, a step or a creak, with a start and an end.</descrip>
<termSec><term>event</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jeden samostatný zvuk v souboru, například úder, krok nebo vrznutí, se začátkem a koncem.</descrip>
<termSec><term>událost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>zvuková událost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein einzelner, abgegrenzter Sound innerhalb einer Datei, etwa ein Schlag, ein Schritt oder ein Knarren, mit Anfang und Ende.</descrip>
<termSec><term>Ereignis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Not 'Event': in Cubase an Event is a clip on a track.</note></termSec>
<termSec><term>Klangereignis</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un sonido diferenciado dentro de un archivo, como un golpe, un paso o un crujido, con un inicio y un final.</descrip>
<termSec><term>evento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Cubase es: 'Eventos'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jeden wyodrębniony dźwięk w pliku, np. uderzenie, krok lub skrzypnięcie, z początkiem i końcem.</descrip>
<termSec><term>zdarzenie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>As in „detekcja zdarzeń dźwiękowych” (sound event detection).</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Отдельный звук внутри файла — например, удар, шаг или скрип — с началом и концом.</descrip>
<termSec><term>событие</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="attack">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The first part of a sound, from its start to its peak.</descrip>
<termSec><term>attack</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">První část zvuku, od jeho začátku po jeho vrchol.</descrip>
<termSec><term>náběh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech music acoustics divides a tone into náběh, ustálená část and doznívání; LMMS and Audacity cs also use 'náběh'. Engineers often say 'attack'. A phase, kept apart from 'nástup' (onset, a moment).</note></termSec>
<termSec><term>atak</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>attack</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der erste Teil eines Sounds, von seinem Beginn bis zu seinem Maximum.</descrip>
<termSec><term>Attack</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Synth and studio usage; acoustics says 'Einschwingphase/Einschwingvorgang', percussion 'Anschlag'. Gender varies (der/die Attack); plural Attacks.</note></termSec>
<termSec><term>Einschwingphase</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Anschlag</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La primera parte de un sonido, desde su comienzo hasta su pico.</descrip>
<termSec><term>ataque</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Pierwsza część dźwięku, od jego początku do szczytu.</descrip>
<termSec><term>atak</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio and musical-acoustics usage. LMMS and Audacity pl use „narastanie” for the ADSR stage.</note></termSec>
<termSec><term>narastanie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>faza narastania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Первая часть звука — от его начала до пика.</descrip>
<termSec><term>атака</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Атака — участок, онсет — момент, транзиент — характер изменения.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="body">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The sustained, often tonal, part of a sound after its attack.</descrip>
<termSec><term>body</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Trvající, často tónová část zvuku po náběhu.</descrip>
<termSec><term>tělo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Engineers say 'tělo' (e.g. the body of a snare); music acoustics says 'ustálená část'.</note></termSec>
<termSec><term>ustálená část</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>jádro</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der gehaltene, oft tonale Teil eines Sounds nach dem Attack.</descrip>
<termSec><term>Körper</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio jargon ('der Snare fehlt Körper'); 'Body' is also common. Not 'Klangkörper' (= instrument body or orchestra) and not 'Sustain' (an ADSR level).</note></termSec>
<termSec><term>Body</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Klangkern</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La parte sostenida, a menudo tonal, de un sonido tras su ataque.</descrip>
<termSec><term>cuerpo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Podtrzymana, często tonalna część dźwięku po ataku.</descrip>
<termSec><term>korpus</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Dodać ciała” is a common studio idiom, but „ciało” as the name of a part reads oddly. „Korpus” works in „atak i korpus”. Acoustics textbooks say „stan ustalony”.</note></termSec>
<termSec><term>ciało</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>faza ustalona</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>body</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Длящаяся, часто тональная часть звука после атаки.</descrip>
<termSec><term>тело</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>В саунд-дизайне говорят «тело звука» (атака — тело — хвост).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="decay">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The part of a sound in which it dies away.</descrip>
<termSec><term>decay</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Část zvuku, během níž zvuk odeznívá.</descrip>
<termSec><term>doznívání</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Czech music-acoustics term. Synth ADSR 'decay' is 'pokles' (LMMS cs), which is a different meaning.</note></termSec>
<termSec><term>útlum</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pokles</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Teil eines Sounds, in dem er abklingt.</descrip>
<termSec><term>Abklingphase</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Do not equate with the Decay stage of an ADSR envelope (fall to the sustain level), where German synths keep 'Decay'. Acoustics: Ausschwingvorgang.</note></termSec>
<termSec><term>Ausklingen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Decay</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La parte de un sonido en la que este se extingue.</descrip>
<termSec><term>decaimiento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>As in synth and reverb UIs (Audacity es: 'Decaimiento (ms)'); room-acoustics texts say 'caída' ('curva de caída', 'tiempo de caída inicial' EDT). The loan 'decay' is also common.</note></termSec>
<termSec><term>caída</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Część dźwięku, w której dźwięk wygasa.</descrip>
<termSec><term>zanikanie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>This is not the ADSR decay stage (LMMS and Audacity pl: „opadanie”). „Wybrzmiewanie” is a good synonym but is used for the ring time tool.</note></termSec>
<termSec><term>wybrzmiewanie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zanik</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Часть звука, в которой он угасает.</descrip>
<termSec><term>затухание</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>В огибающей ADSR decay — «спад», а «затухание» там иногда означает release; здесь речь о естественном угасании звука. Не используйте «затухание» для fade-out и damping.</note></termSec>
<termSec><term>спад</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="tail">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The late part of a decay, including reverberation.</descrip>
<termSec><term>tail</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Pozdní část doznívání, včetně dozvuku.</descrip>
<termSec><term>doznění</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Ocas' (as in 'ocas dozvuku') is common studio slang but sounds odd in UI. 'Doznění' is neutral and works in the tool names (rozšířit doznění, dozvuk na doznění).</note></termSec>
<termSec><term>ocas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>konec doznívání</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der späte Teil der Abklingphase, einschließlich des Nachhalls.</descrip>
<termSec><term>Ausklang</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio jargon 'Fahne' (Hallfahne); 'Ausklang' is understood by everyone and forms good tool names (Ausklänge verbreitern). Plural Ausklänge.</note></termSec>
<termSec><term>Fahne</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Tail</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La parte final del decaimiento, incluida la reverberación.</descrip>
<termSec><term>cola</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'cola de reverberación' is standard.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Późna część zanikania, łącznie z pogłosem.</descrip>
<termSec><term>ogon</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio usage („ogon pogłosu”).</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Поздняя часть затухания, включая реверберацию.</descrip>
<termSec><term>хвост</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="transient">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A short, fast change of level and spectrum, typically at an attack.</descrip>
<termSec><term>transient</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Krátká, rychlá změna úrovně a spektra, typicky při náběhu.</descrip>
<termSec><term>tranzient</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Engineers say 'tranzient/transient' (pl. 'tranzienty'); physics and electronics say 'přechodový jev'. Ardour cs 'přechod' is not adopted (too vague).</note></termSec>
<termSec><term>přechodový jev</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>transient</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine kurze, schnelle Änderung von Pegel und Spektrum, typischerweise im Attack.</descrip>
<termSec><term>Transiente</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Plural 'Transienten' (Ableton de, studio). Gender varies: die Transiente / der Transient.</note></termSec>
<termSec><term>Transient</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un cambio breve y rápido de nivel y espectro, típicamente en un ataque.</descrip>
<termSec><term>transitorio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ableton Live es and Native Instruments es: 'transitorios'; 'transiente' is an anglicism heard in Latin America.</note></termSec>
<termSec><term>transiente</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Krótka, szybka zmiana poziomu i widma, zwykle w ataku.</descrip>
<termSec><term>transjent</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish Wikipedia („Transjent”) and Ardour pl; acoustics textbooks use „stan nieustalony”.</note></termSec>
<termSec><term>stan nieustalony</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>transient</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Короткое быстрое изменение уровня и спектра, обычно в атаке.</descrip>
<termSec><term>транзиент</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Транзиент» — студийная норма; «переходный процесс» — термин физики и электротехники, в интерфейсе громоздок.</note></termSec>
<termSec><term>переходный процесс</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="beat">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The regular pulse a listener taps along to.</descrip>
<termSec><term>beat</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Pravidelný puls, do kterého posluchač ťuká.</descrip>
<termSec><term>doba</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Ardour cs ('Takty a doby') and Czech MIR theses. 'Úder' is reserved for hits.</note></termSec>
<termSec><term>úder</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>beat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der regelmäßige Puls, zu dem Hörer mitklopfen.</descrip>
<termSec><term>Beat</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ableton de writes both 'Beats' and 'Schlägen'; music theory says Schlag, Grundschlag, Zählzeit.</note></termSec>
<termSec><term>Schlag</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Zählzeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El pulso regular que un oyente marcaría con el pie.</descrip>
<termSec><term>pulso</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'pulso' is the felt pulse (music theory; MIR 'seguimiento del pulso'); DAWs count bar positions in 'tiempos' ('compás:tiempo'). Audacity es wrongly renders beat as 'compás'.</note></termSec>
<termSec><term>tiempo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>beat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Regularny puls, który słuchacz wystukuje.</descrip>
<termSec><term>miara</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish music theory (miary w takcie; Audacity pl „Miary i takty”). Ardour and LMMS pl use „uderzenie”, which is avoided here because „uderzenie” means a hit (event). „Beat” is common in speech; note that „bit” means a hip-hop instrumental.</note></termSec>
<termSec><term>puls</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>beat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Регулярная пульсация, под которую слушатель отстукивает ритм.</descrip>
<termSec><term>доля</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Музыкальный термин — «доля» (русская Audacity: «Доли и такты»); «бит» в русской речи означает ещё и инструментал.</note></termSec>
<termSec><term>бит</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="downbeat">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The first beat of a bar.</descrip>
<termSec><term>downbeat</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">První doba taktu.</descrip>
<termSec><term>první doba</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Těžká doba' is broader (any strong beat).</note></termSec>
<termSec><term>těžká doba</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>downbeat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der erste Beat eines Takts.</descrip>
<termSec><term>Downbeat</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Musicians say 'die Eins'; German MIR writing keeps 'Downbeat'.</note></termSec>
<termSec><term>Eins</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>erste Zählzeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El primer tiempo de un compás.</descrip>
<termSec><term>primer tiempo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'primer tiempo (del compás)' is exact; 'tiempo fuerte' means any strong beat.</note></termSec>
<termSec><term>tiempo fuerte</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>downbeat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Pierwsza miara w takcie.</descrip>
<termSec><term>pierwsza miara taktu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Musicians say „raz” („wejście na raz”). „Mocna część taktu” is broader.</note></termSec>
<termSec><term>raz</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>downbeat</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Первая доля такта.</descrip>
<termSec><term>сильная доля</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>В русской теории музыки сильная доля такта — первая; в MIR-текстах встречается калька «даунбит».</note></termSec>
<termSec><term>первая доля</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>даунбит</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="bar">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A group of beats, usually four.</descrip>
<termSec><term>bar</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>measure</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Skupina dob, obvykle čtyř.</descrip>
<termSec><term>takt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour cs. Not to be confused with the shape 'tyč' (bar-shape).</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine Gruppe von Beats, meist vier.</descrip>
<termSec><term>Takt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>US 'measure' is also 'Takt'. Not to be confused with bar-shape (Stab).</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un grupo de pulsos (tiempos), normalmente cuatro.</descrip>
<termSec><term>compás</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>No bar/measure split in Spanish: both are 'compás'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Grupa miar, zwykle czterech.</descrip>
<termSec><term>takt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>The US „measure” is also „takt”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Группа долей, обычно четыре.</descrip>
<termSec><term>такт</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Американское measure — тоже «такт».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="tempo">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The speed of the beat, in beats per minute (BPM).</descrip>
<termSec><term>tempo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Rychlost dob, udávaná v úderech za minutu (BPM).</descrip>
<termSec><term>tempo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Czech expansion of BPM: 'úderů za minutu' (Audacity cs).</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Geschwindigkeit des Beats, in Beats pro Minute (BPM).</descrip>
<termSec><term>Tempo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">La velocidad del pulso, en pulsos por minuto (BPM).</descrip>
<termSec><term>tempo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'BPM' is kept; the Spanish expansion is 'pulsos' or 'pulsaciones por minuto'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Szybkość miar, w uderzeniach na minutę (BPM).</descrip>
<termSec><term>tempo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>„Uderzeń na minutę” is the fixed Polish reading of BPM (Audacity pl). It is the one place where „uderzenie” refers to the beat.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Скорость следования долей, в ударах в минуту (BPM).</descrip>
<termSec><term>темп</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>BPM оставлено латиницей, как в DAW; по-русски сокращают «уд./мин».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="section">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A part of a piece, such as an intro or chorus, found from where its sound changes.</descrip>
<termSec><term>section</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Část skladby, například intro nebo refrén, nalezená podle toho, kde se mění její zvuk.</descrip>
<termSec><term>oddíl</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Část' is too generic for a UI term; producers also say 'sekce'.</note></termSec>
<termSec><term>část</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>sekce</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>díl</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Teil eines Stücks, etwa Intro oder Refrain, ermittelt aus den Stellen, an denen sich sein Klang ändert.</descrip>
<termSec><term>Abschnitt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Formteil' is the musicological term for music; 'Abschnitt' also fits sound effects.</note></termSec>
<termSec><term>Formteil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Teil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una parte de una pieza, como una introducción o un estribillo, detectada a partir de dónde cambia su sonido.</descrip>
<termSec><term>sección</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Część utworu, np. intro lub refren, wyznaczona na podstawie miejsc, w których zmienia się brzmienie.</descrip>
<termSec><term>sekcja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Producers say „sekcja”. Musicologists say „część” or „odcinek”, but „część” is too generic for a UI label and also means a movement.</note></termSec>
<termSec><term>część</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>odcinek formy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Часть произведения, например вступление или припев, определённая по тому, где меняется звучание.</descrip>
<termSec><term>часть</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Часть» — обычное слово для формы песни; «секция» в русской речи чаще означает группу инструментов.</note></termSec>
<termSec><term>раздел</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>секция</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="recurrence">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How much a sound returns to states it has been in before.</descrip>
<termSec><term>recurrence</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak moc se zvuk vrací do stavů, ve kterých už byl.</descrip>
<termSec><term>rekurence</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>As in 'rekurentní diagram' (recurrence plot, Marwan et al. 2007).</note></termSec>
<termSec><term>návratnost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie sehr ein Sound zu Zuständen zurückkehrt, in denen er schon war.</descrip>
<termSec><term>Rekurrenz</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Marwan et al. 2007; German: Rekurrenzplot, Rekurrenzquantifizierungsanalyse.</note></termSec>
<termSec><term>Wiederkehr</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuánto vuelve un sonido a estados en los que ya ha estado.</descrip>
<termSec><term>recurrencia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Marwan et al.: 'gráficos de recurrencia'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo dźwięk wraca do stanów, w których już był.</descrip>
<termSec><term>rekurencja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>As in recurrence plots („wykresy rekurencyjne”) and RQA („ilościowa analiza rekurencji”) in Polish nonlinear-dynamics writing.</note></termSec>
<termSec><term>powracanie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько звук возвращается к состояниям, в которых уже бывал.</descrip>
<termSec><term>рекуррентность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Marwan et al. 2007: «рекуррентный анализ», «рекуррентные диаграммы». «Повторяемость» понятнее, но близка к частоте повторения (repetition rate).</note></termSec>
<termSec><term>повторяемость</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="repetition-rate">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How often a pattern repeats, in Hz.</descrip>
<termSec><term>repetition rate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak často se vzor opakuje, v Hz.</descrip>
<termSec><term>frekvence opakování</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie oft sich ein Muster wiederholt, in Hz.</descrip>
<termSec><term>Wiederholrate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Wiederholungsrate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Wiederholfrequenz</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué frecuencia se repite un patrón, en Hz.</descrip>
<termSec><term>frecuencia de repetición</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Given in Hz, so 'frecuencia' rather than 'tasa'.</note></termSec>
<termSec><term>tasa de repetición</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak często powtarza się wzór, w Hz.</descrip>
<termSec><term>częstotliwość powtarzania</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>As in „częstotliwość powtarzania impulsów” (pulse repetition frequency).</note></termSec>
<termSec><term>częstość powtórzeń</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Как часто повторяется паттерн, в Гц.</descrip>
<termSec><term>частота повторения</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="periodicity">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How strongly a sound is periodic (pitched) rather than noisy.</descrip>
<termSec><term>periodicity</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak silně je zvuk periodický (má výšku), a ne šumový.</descrip>
<termSec><term>periodicita</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie stark ein Sound periodisch (tonhaft) statt rauschhaft ist.</descrip>
<termSec><term>Periodizität</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Hillenbrand et al. 1994.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">En qué medida un sonido es periódico (con tono definido) en lugar de ruidoso.</descrip>
<termSec><term>periodicidad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo dźwięk jest okresowy (ma określoną wysokość), a nie szumowy.</descrip>
<termSec><term>okresowość</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько звук периодичен (имеет высоту тона), а не шумоподобен.</descrip>
<termSec><term>периодичность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Hillenbrand et al. 1994.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="phase-coherence">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How steadily a sound's phases advance; 1 for a steady tone, near 0 for noise.</descrip>
<termSec><term>phase coherence</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak rovnoměrně postupují fáze zvuku; 1 pro ustálený tón, blízko 0 pro šum.</descrip>
<termSec><term>fázová koherence</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie gleichmäßig die Phasen eines Sounds fortschreiten; 1 für einen stationären Ton, nahe 0 für Rauschen.</descrip>
<termSec><term>Phasenkohärenz</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué regularidad avanzan las fases de un sonido; 1 para un tono estable, cerca de 0 para el ruido.</descrip>
<termSec><term>coherencia de fase</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak równomiernie narastają fazy dźwięku; 1 dla stałego tonu, blisko 0 dla szumu.</descrip>
<termSec><term>koherencja fazowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>spójność fazowa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько равномерно нарастают фазы звука: 1 для стационарного тона, около 0 для шума.</descrip>
<termSec><term>фазовая когерентность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="time-arrow">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How much a sound changes when played backwards; high for hits that decay.</descrip>
<termSec><term>time arrow</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>time irreversibility</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak moc se zvuk změní, když se přehraje pozpátku; vysoká pro údery, které doznívají.</descrip>
<termSec><term>šipka času</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Šipka času' is the established Czech phrase for the physical arrow of time, so it carries the same image. 'Časová nevratnost' is the technical term (docs only, as in the source). 'Směr času' is plainer but loses the idea of a degree.</note></termSec>
<termSec><term>časová nevratnost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>směr času</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>time arrow</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie sehr sich ein Sound ändert, wenn er rückwärts abgespielt wird; hoch bei abklingenden Hits.</descrip>
<termSec><term>Zeitpfeil</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Zeitpfeil' is the established German physics term for the arrow of time and short; 'Zeitasymmetrie' is more technical. For docs: zeitliche Irreversibilität (Ramsey and Rothman 1996).</note></termSec>
<termSec><term>Zeitrichtung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Zeitasymmetrie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Time Arrow</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuánto cambia un sonido al reproducirlo al revés; es alta en golpes que decaen.</descrip>
<termSec><term>flecha del tiempo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'flecha del tiempo' is the established physics phrase and reads well as a curve name; 'irreversibilidad temporal' is the technical term (docs only, as in English); 'asimetría temporal' is a plain description.</note></termSec>
<termSec><term>irreversibilidad temporal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>asimetría temporal</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo dźwięk zmienia się po odtworzeniu wstecz; wysoka dla uderzeń, które zanikają.</descrip>
<termSec><term>strzałka czasu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>„Strzałka czasu” is the established Polish physics term for the arrow of time (Polish Wikipedia), so the metaphor carries over. „Nieodwracalność czasowa” is the technical term, for docs only.</note></termSec>
<termSec><term>kierunkowość czasu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>nieodwracalność czasowa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>time arrow</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько меняется звук при воспроизведении задом наперёд; велика у затухающих ударов.</descrip>
<termSec><term>стрела времени</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Стрела времени» — устоявшаяся физическая метафора, понятна без пояснений; «необратимость во времени» (time irreversibility) — технический термин только для документации (Ramsey and Rothman 1996).</note></termSec>
<termSec><term>необратимость во времени</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>асимметрия во времени</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="impulsiveness">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How much a sound consists of clicks, cracks and crackle, from spectral kurtosis.</descrip>
<termSec><term>impulsiveness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>spikiness</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak moc se zvuk skládá z cvaknutí, prasknutí a praskotu; odvozeno ze spektrální kurtózy.</descrip>
<termSec><term>impulzivnost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>ČSN ISO 1996-1 uses 'impulzivnost' for impulsive noise, so the word is established in acoustics. 'Praskavost' is vivid but covers only crackle. Avoid 'špičatost' (= kurtosis).</note></termSec>
<termSec><term>impulznost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>praskavost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>impulsiveness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie sehr ein Sound aus Klicks, Knacksern und Knistern besteht, ermittelt aus der spektralen Kurtosis.</descrip>
<termSec><term>Impulshaltigkeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Impulshaltigkeit' is the established term of German noise assessment (DIN 45645-1, TA Lärm: 'impulshaltige Geräusche') and fits the meaning, although there it is rated from level differences, not spectral kurtosis. 'Impulsivität' sounds like a character trait. Not 'Spitzigkeit' (spikiness).</note></termSec>
<termSec><term>Impulshaftigkeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Impulsivität</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Knackanteil</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">En qué medida un sonido se compone de clics, chasquidos y crepitaciones, a partir de la curtosis espectral.</descrip>
<termSec><term>impulsividad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'impulsividad' and 'ruido impulsivo' are used in Spanish noise assessment; 'carácter impulsivo' avoids the psychological sense of 'impulsividad' but is longer.</note></termSec>
<termSec><term>carácter impulsivo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>contenido impulsivo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo dźwięk składa się z kliknięć, trzasków i trzeszczenia; wyznaczana z kurtozy widmowej.</descrip>
<termSec><term>impulsowość</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish acousticians use „impulsowość” for impulsive noise (M. Gałuszka, twojazielonka.org; „hałas impulsowy”). „Impulsywność” is the everyday word for temperament; „trzaskliwość” is vivid but unusual. Avoid „kolczastość” (spikiness).</note></termSec>
<termSec><term>impulsywność</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>trzaskliwość</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>impulsiveness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько звук состоит из щелчков, тресков и потрескиваний; вычисляется по спектральному эксцессу.</descrip>
<termSec><term>импульсность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Импульсность» опирается на привычное «импульсный шум»; «трескучесть» образна, но разговорна. Не «колючесть» (spikiness) и не «импульсивность» (черта характера).</note></termSec>
<termSec><term>импульсный характер</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>трескучесть</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="spectral-kurtosis">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A statistic that is 0 for steady noise, −1 for a steady tone and large for clicks.</descrip>
<termSec><term>spectral kurtosis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Statistika, která je 0 pro ustálený šum, −1 pro ustálený tón a velká pro cvaknutí.</descrip>
<termSec><term>spektrální kurtóza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Czech machine-diagnostics usage of Antoni's spectral kurtosis; 'špičatost' is the general statistics word for kurtosis.</note></termSec>
<termSec><term>spektrální špičatost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine Kenngröße, die für stationäres Rauschen 0, für einen stationären Ton −1 und für Klicks groß ist.</descrip>
<termSec><term>spektrale Kurtosis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Antoni 2006; German machine-diagnostics literature mostly says 'spektrale Kurtosis'.</note></termSec>
<termSec><term>spektrale Wölbung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un estadístico que vale 0 para un ruido estable, −1 para un tono estable y es grande para los clics.</descrip>
<termSec><term>curtosis espectral</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Statystyka równa 0 dla stałego szumu, −1 dla stałego tonu i duża dla kliknięć.</descrip>
<termSec><term>kurtoza widmowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Статистика, равная 0 для стационарного шума, −1 для стационарного тона и большая для щелчков.</descrip>
<termSec><term>спектральный эксцесс</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Kurtosis в русской статистике — «эксцесс»; в вибродиагностике по Antoni (2006) встречается калька «спектральный куртозис» («куртограмма»).</note></termSec>
<termSec><term>спектральный куртозис</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="spectral-motion">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How fast the spectrum's centre moves up or down, in octaves per second.</descrip>
<termSec><term>spectral motion</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak rychle se střed spektra posouvá nahoru nebo dolů, v oktávách za sekundu.</descrip>
<termSec><term>pohyb spektra</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Pohyb spektra' is natural Czech. 'Spektrální pohyb' mirrors the English and the other 'spektrální' terms. 'Posun těžiště spektra' is exact but long.</note></termSec>
<termSec><term>spektrální pohyb</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>posun těžiště spektra</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>spectral motion</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie schnell sich der Schwerpunkt des Spektrums nach oben oder unten bewegt, in Oktaven pro Sekunde.</descrip>
<termSec><term>spektrale Bewegung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Literal and clear; 'Schwerpunktbewegung' is more precise (it is the centroid that moves) but unclear without context; 'Drift' suggests slow change.</note></termSec>
<termSec><term>Schwerpunktbewegung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Spektraldrift</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Spectral Motion</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué rapidez sube o baja el centro del espectro, en octavas por segundo.</descrip>
<termSec><term>movimiento espectral</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Literal and clear. 'desplazamiento espectral' clashes with 'desplazamiento DC'; 'deriva espectral' suggests a slow drift.</note></termSec>
<termSec><term>desplazamiento espectral</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>deriva espectral</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak szybko środek widma przesuwa się w górę lub w dół, w oktawach na sekundę.</descrip>
<termSec><term>ruch widma</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Literal and short. The descriptive „prędkość środka widma” is exact but long.</note></termSec>
<termSec><term>ruch widmowy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>prędkość środka widma</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>spectral motion</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько быстро центр спектра движется вверх или вниз, в октавах в секунду.</descrip>
<termSec><term>движение спектра</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>«Движение спектра» звучит естественно; «спектральное движение» — калька; «дрейф центроида» технически точнее, но длиннее и уже по смыслу.</note></termSec>
<termSec><term>спектральное движение</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>дрейф центроида</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="spectral-centroid">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The centre of mass of a spectrum; a measure of brightness.</descrip>
<termSec><term>spectral centroid</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Těžiště spektra; míra jasu zvuku.</descrip>
<termSec><term>spektrální centroid</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Spektrální centroid' is the usual term in Czech MIR theses; 'těžiště spektra' in psychoacoustics.</note></termSec>
<termSec><term>těžiště spektra</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>spektrální těžiště</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Schwerpunkt eines Spektrums; ein Maß für die Helligkeit.</descrip>
<termSec><term>spektraler Schwerpunkt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>Spektralschwerpunkt</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Spectral Centroid</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El centro de masas de un espectro; una medida del brillo.</descrip>
<termSec><term>centroide espectral</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Środek ciężkości widma; miara jasności.</descrip>
<termSec><term>centroid widma</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish MIR and MPEG-7 writing uses both „centroid” and „środek ciężkości widma”.</note></termSec>
<termSec><term>środek ciężkości widma</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>centroid widmowy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Центр масс спектра; мера яркости.</descrip>
<termSec><term>спектральный центроид</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>центр тяжести спектра</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="reshaping">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Spectral change that does not move the centre, as when a spectrum spreads or narrows.</descrip>
<termSec><term>reshaping</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Spektrální změna, která neposouvá střed spektra, například když se spektrum rozšiřuje nebo zužuje.</descrip>
<termSec><term>přetváření</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Přetváření' is short and pairs with 'pohyb spektra'. 'Změna tvaru spektra' is self-explanatory but long.</note></termSec>
<termSec><term>změna tvaru spektra</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>přeskupení spektra</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>reshaping</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Spektrale Veränderung, die den Schwerpunkt nicht verschiebt, etwa wenn sich ein Spektrum verbreitert oder verengt.</descrip>
<termSec><term>Umformung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Umformung' is short and sits well next to 'spektrale Bewegung'; 'spektrale Umformung' is clearer in docs.</note></termSec>
<termSec><term>spektrale Umformung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Formänderung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Reshaping</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cambio espectral que no desplaza el centro, como cuando un espectro se ensancha o se estrecha.</descrip>
<termSec><term>remodelado</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'remodelado' is short and suggests a change of shape in place; 'cambio de forma' is plainest but generic; 'reconfiguración' sounds like settings.</note></termSec>
<termSec><term>cambio de forma</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>reconfiguración</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zmiana widma, która nie przesuwa jego środka, np. gdy widmo się rozszerza lub zwęża.</descrip>
<termSec><term>zmiana kształtu widma</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>„Przekształcanie” is the closest literal match but collides with „przekształcenie” (a transform, e.g. „przekształcenie Fouriera”). „Deformacja” sounds like damage.</note></termSec>
<termSec><term>przekształcanie widma</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>deformacja widma</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>reshaping</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изменение спектра, не сдвигающее его центр, — например, когда спектр расширяется или сужается.</descrip>
<termSec><term>изменение формы спектра</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Описательный вариант однозначен; «перестройка» короче, но в радиотехнике означает перестройку частоты; «переформирование» — тяжеловесная калька.</note></termSec>
<termSec><term>перестройка спектра</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>переформирование спектра</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="burstiness">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Whether events come regularly (below 0), at random (0) or in bursts (above 0).</descrip>
<termSec><term>burstiness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zda události přicházejí pravidelně (pod 0), náhodně (0), nebo ve shlucích (nad 0).</descrip>
<termSec><term>shlukovitost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>No established Czech term. Based on 'shluk' = burst (as in telecom 'shlukové chyby'); 'nárazovitost' (cf. 'nárazový provoz') is the other option.</note></termSec>
<termSec><term>nárazovitost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>burstiness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ob Ereignisse regelmäßig (unter 0), zufällig (0) oder gehäuft in Schüben (über 0) auftreten.</descrip>
<termSec><term>Burstiness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Goh and Barabási 2008; German scientific writing leaves it untranslated. If a German UI word is wanted, descriptive 'Schubhaftigkeit' or 'Häufung' could serve, but neither is established.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Si los eventos llegan de forma regular (por debajo de 0), aleatoria (0) o en ráfagas (por encima de 0).</descrip>
<termSec><term>índice de ráfagas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>No settled Spanish term; Spanish network-science papers usually keep 'burstiness' (Goh and Barabási's parameter B). 'índice de ráfagas' is transparent.</note></termSec>
<termSec><term>burstiness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Czy zdarzenia pojawiają się regularnie (poniżej 0), losowo (0) czy seriami (powyżej 0).</descrip>
<termSec><term>seryjność</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>No established Polish term: Polish complex-systems papers usually keep „burstiness”. „Seryjność” (from „seria”, a burst as in „seria strzałów”) is my proposal; it can also suggest „produkcja seryjna”, so the loan is safer in docs.</note></termSec>
<termSec><term>burstiness</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>skupianie w seriach</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Приходят ли события регулярно (ниже 0), случайно (0) или пачками (выше 0).</descrip>
<termSec><term>пачечность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Устоявшегося перевода параметра Goh and Barabási 2008 найти не удалось; «пачечность» — по аналогии с «пачечным трафиком» в теории телетрафика, «всплесковость» — описательно.</note></termSec>
<termSec><term>всплесковость</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>бёрстность</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="temporal-entropy">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How evenly a sound's energy is spread over time.</descrip>
<termSec><term>temporal entropy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak rovnoměrně je energie zvuku rozložena v čase.</descrip>
<termSec><term>časová entropie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie gleichmäßig die Energie eines Sounds über die Zeit verteilt ist.</descrip>
<termSec><term>zeitliche Entropie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Sueur et al. 2008 (Ht).</note></termSec>
<termSec><term>temporale Entropie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuán uniformemente se reparte la energía de un sonido en el tiempo.</descrip>
<termSec><term>entropía temporal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Sueur et al.'s H_t; same term in Spanish ecoacoustics.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak równomiernie energia dźwięku rozkłada się w czasie.</descrip>
<termSec><term>entropia czasowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько равномерно энергия звука распределена во времени.</descrip>
<termSec><term>временная энтропия</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Sueur et al. 2008 (индекс Ht в биоакустике).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="decay-time">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">The time a sound takes to fall by 60 dB.</descrip>
<termSec><term>decay time (T60)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Doba, za kterou zvuk klesne o 60 dB.</descrip>
<termSec><term>doba doznívání (T60)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>For rooms the ČSN EN ISO 3382 term is 'doba dozvuku'. Here it is the sound's own decay, hence 'doznívání'.</note></termSec>
<termSec><term>doba dozvuku (T60)</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die Zeit, in der ein Sound um 60 dB abfällt.</descrip>
<termSec><term>Abklingzeit (T60)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>In room acoustics T60 is the 'Nachhallzeit' (DIN EN ISO 3382); for sounds and struck objects in general 'Abklingzeit'.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El tiempo que tarda un sonido en caer 60 dB.</descrip>
<termSec><term>tiempo de decaimiento (T60)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Follows 'decaimiento'. For rooms the same measure is 'tiempo de reverberación'.</note></termSec>
<termSec><term>tiempo de caída (T60)</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Czas, w którym poziom dźwięku spada o 60 dB.</descrip>
<termSec><term>czas zaniku (T60)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Czas pogłosu” (T60) is the room-acoustics term (PN-EN ISO 3382); for a single sound „czas zaniku” is clearer. „Czas wybrzmiewania” is used for the ring time tool.</note></termSec>
<termSec><term>czas wybrzmiewania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>czas pogłosu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Время, за которое уровень звука падает на 60 дБ.</descrip>
<termSec><term>время затухания (T60)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Для помещений та же величина называется «время реверберации» (RT60); здесь — для любого звука (Schroeder 1965).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="damping">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">How quickly a vibrating body loses energy.</descrip>
<termSec><term>damping</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak rychle kmitající těleso ztrácí energii.</descrip>
<termSec><term>tlumení</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
<termSec><term>útlum</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie schnell ein schwingender Körper Energie verliert.</descrip>
<termSec><term>Dämpfung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué rapidez pierde energía un cuerpo que vibra.</descrip>
<termSec><term>amortiguamiento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak szybko drgające ciało traci energię.</descrip>
<termSec><term>tłumienie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Physics: „tłumienie drgań”; LMMS pl „Tłumienie”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько быстро колеблющееся тело теряет энергию.</descrip>
<termSec><term>демпфирование</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Термин механики выбран, чтобы не смешивать с decay («затухание»).</note></termSec>
<termSec><term>затухание колебаний</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="material">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">What an impacted object is made of, as heard: damped, glass-like or metal-like.</descrip>
<termSec><term>material</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Z čeho je udeřený předmět vyroben, jak to zní: tlumený, sklovitý nebo kovový.</descrip>
<termSec><term>materiál</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Woraus ein angeschlagenes Objekt besteht, wie es gehört wird: gedämpft, glasartig oder metallisch.</descrip>
<termSec><term>Material</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Klatzky et al. 2000.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">De qué está hecho un objeto golpeado, tal como se percibe: amortiguado, similar al vidrio o similar al metal.</descrip>
<termSec><term>material</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Z czego wykonany jest uderzany przedmiot, w odbiorze słuchowym: tłumiony, szklisty lub metaliczny.</descrip>
<termSec><term>materiał</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Из чего, судя по звуку, сделан предмет, по которому ударили: глухой (демпфированный), стеклоподобный или металлоподобный.</descrip>
<termSec><term>материал</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Klatzky et al. 2000.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="partial">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">One frequency component of a sound.</descrip>
<termSec><term>partial</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jedna frekvenční složka zvuku.</descrip>
<termSec><term>částkový tón</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech music-acoustics term.</note></termSec>
<termSec><term>parciální tón</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>parciála</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine Frequenzkomponente eines Sounds.</descrip>
<termSec><term>Teilton</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>Partialton</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una componente de frecuencia de un sonido.</descrip>
<termSec><term>parcial</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Noun 'un parcial'; use 'armónico' only for harmonic partials.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jedna składowa częstotliwościowa dźwięku.</descrip>
<termSec><term>ton składowy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish musical acoustics („tony składowe”). „Parcjał” is additive-synthesis jargon. Bare „składowa” is avoided as the term because of „składowa stała” (DC offset).</note></termSec>
<termSec><term>składowa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ton częściowy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>parcjał</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Одна частотная составляющая звука.</descrip>
<termSec><term>парциальный тон</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Парциальный тон» — термин музыкальной акустики; «парциал» — краткая форма из аддитивного синтеза.</note></termSec>
<termSec><term>парциал</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>частичный тон</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="overtone">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A partial above the lowest one.</descrip>
<termSec><term>overtone</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Částkový tón nad nejnižším.</descrip>
<termSec><term>svrchní tón</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Alikvotní tón' is the more common word but implies harmonic partials. The definition includes inharmonic ones (bells), so the neutral 'svrchní tón' is preferred (cf. 'zpěv svrchních tónů').</note></termSec>
<termSec><term>alikvotní tón</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>vyšší částkový tón</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Teilton oberhalb des tiefsten.</descrip>
<termSec><term>Oberton</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Counting: 1. Oberton = 2. Teilton.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un parcial por encima del más grave.</descrip>
<termSec><term>sobretono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'armónico' only when the partial is harmonic.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Ton składowy powyżej najniższego.</descrip>
<termSec><term>alikwot</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity pl: „alikwoty”. Polish usage often treats „alikwot” as a harmonic only; here it includes inharmonic partials.</note></termSec>
<termSec><term>nadton</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Парциальный тон выше самого низкого.</descrip>
<termSec><term>обертон</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="inharmonic">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">With partials that are not whole-number multiples of a fundamental, as in bells and struck metal.</descrip>
<termSec><term>inharmonic</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">S částkovými tóny, které nejsou celočíselnými násobky základního tónu, jako u zvonů a udeřeného kovu.</descrip>
<termSec><term>neharmonický</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Mit Teiltönen, die keine ganzzahligen Vielfachen einer Grundfrequenz sind, wie bei Glocken und angeschlagenem Metall.</descrip>
<termSec><term>inharmonisch</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>German instrument acoustics also writes 'unharmonische Teiltöne'.</note></termSec>
<termSec><term>unharmonisch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con parciales que no son múltiplos enteros de una fundamental, como en campanas y metales golpeados.</descrip>
<termSec><term>inarmónico</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">O tonach składowych, które nie są całkowitymi wielokrotnościami częstotliwości podstawowej, jak w dzwonach i uderzanym metalu.</descrip>
<termSec><term>nieharmoniczny</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">С парциальными тонами, частоты которых не кратны основной частоте целое число раз, как у колоколов и металла при ударе.</descrip>
<termSec><term>негармонический</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>«Негармонический» — музыкальная акустика; «ангармонический» — физика колебаний.</note></termSec>
<termSec><term>ангармонический</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="quality-checks">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">Automatic checks for clipping, DC offset, silence and cut tails.</descrip>
<termSec><term>quality checks</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Automatické kontroly přebuzení, stejnosměrné složky, ticha a useknutých doznění.</descrip>
<termSec><term>kontroly kvality</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Automatische Prüfungen auf Clipping, DC-Offset, Stille und abgeschnittene Ausklänge.</descrip>
<termSec><term>Qualitätsprüfungen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Qualitätschecks</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Comprobaciones automáticas de clipping, desplazamiento DC, silencio y colas cortadas.</descrip>
<termSec><term>comprobaciones de calidad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'comprobar' is the Microsoft Spanish verb for 'check'; 'controles de calidad' also natural.</note></termSec>
<termSec><term>controles de calidad</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Automatyczne sprawdzanie przesterowania, składowej stałej, ciszy i uciętych ogonów.</descrip>
<termSec><term>kontrola jakości</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>testy jakości</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Автоматические проверки на клиппинг, DC-смещение, тишину и обрезанные хвосты.</descrip>
<termSec><term>проверки качества</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="self-check">
<descrip type="subjectField">analysis</descrip>
<langSec xml:lang="en">
<descrip type="definition">A test that edits a sound in a known way and checks that the analysis changes as it must.</descrip>
<termSec><term>self-check</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>unit test</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Test, který zvuk upraví známým způsobem a ověří, že se analýza změní tak, jak má.</descrip>
<termSec><term>samokontrola</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Samokontrola' describes what it does. 'Autotest' is familiar but suggests a hardware power-on test. Avoid 'jednotkový test' (unit test).</note></termSec>
<termSec><term>autotest</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>kontrolní test</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>self-check</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Test, der einen Sound auf bekannte Weise bearbeitet und prüft, ob sich die Analyse so ändert, wie sie muss.</descrip>
<termSec><term>Selbsttest</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Selbsttest' is familiar (device self-test) and short; 'Plausibilitätstest' describes the purpose but sounds bureaucratic. Not 'Unit-Test/Modultest'. Method: metamorphes Testen (Chen et al. 1998).</note></termSec>
<termSec><term>Selbstprüfung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Plausibilitätstest</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Self-Check</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una prueba que modifica un sonido de forma conocida y comprueba que el análisis cambia como debe.</descrip>
<termSec><term>autocomprobación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Matches 'comprobaciones de calidad'. 'autotest' is common in electronics but suggests a unit test, which the English avoids.</note></termSec>
<termSec><term>autoverificación</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>autotest</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Test, który zmienia dźwięk w znany sposób i sprawdza, czy analiza zmienia się tak, jak powinna.</descrip>
<termSec><term>autotest</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Autotest” is the familiar Polish IT word for a built-in self-test; „samosprawdzenie” is literal but clumsy. It must not be „test jednostkowy” (unit test); the technical name for docs is „test metamorficzny”.</note></termSec>
<termSec><term>samosprawdzenie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>samokontrola</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>self-check</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Тест, который изменяет звук заранее известным образом и проверяет, что результат анализа меняется так, как должен.</descrip>
<termSec><term>самопроверка</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Самопроверка» понятна пользователю; «самотест» звучит как аппаратная диагностика; «метаморфная проверка» (metamorphic testing, Chen et al. 1998) точна, но только для документации. Не «модульный тест».</note></termSec>
<termSec><term>самотест</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>метаморфная проверка</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="de-harsh">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that turns down resonances only while the sound is harsh.</descrip>
<termSec><term>de-harsh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>de-esser</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který stahuje rezonance jen po dobu, kdy je zvuk nepříjemný.</descrip>
<termSec><term>zjemnit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. 'Zjemnit' (make gentler) is short and idiomatic but does not echo 'nepříjemnost'. 'Zmírnit nepříjemnost' is transparent but long. A de-esser stays 'de-esser' in Czech.</note></termSec>
<termSec><term>zmírnit nepříjemnost</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zjemnění</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>de-harsh</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das Resonanzen nur so lange absenkt, wie der Sound hart klingt.</descrip>
<termSec><term>Härte reduzieren</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Command form, consistent with harshness = Härte. 'De-Harsh' would be understood by analogy with 'De-Esser' but is not German; 'Entschärfen' is catchy but blurs Schärfe (sharpness). Not a De-Esser (which keys on level in one band).</note></termSec>
<termSec><term>Härte zähmen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Härten glätten</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>De-Harsh</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que atenúa las resonancias solo mientras el sonido es estridente.</descrip>
<termSec><term>reducir estridencia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. Follows 'harshness'; becomes 'Reducir aspereza' if the author picks 'aspereza'. 'Suavizar' alone is idiomatic but too generic (smoothing). Not a de-esser ('de-esser' also in Spanish).</note></termSec>
<termSec><term>reducir aspereza</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>suavizar</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>de-harsh</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które tłumi rezonanse tylko wtedy, gdy dźwięk jest nieprzyjemny.</descrip>
<termSec><term>złagodź brzmienie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Imperative, per the command convention; noun form „łagodzenie brzmienia” for headings. „Złagodzić” is what Polish engineers say about taming harsh resonances. The literal „redukuj nieprzyjemność” ties the tool to the curve name. The loan works by analogy with „de-esser”, which Polish keeps in English. This is not a de-esser (a de-esser keys on level in one band).</note></termSec>
<termSec><term>redukuj nieprzyjemność</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>łagodzenie brzmienia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>de-harsh</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который приглушает резонансы только тогда, когда звук жёсткий.</descrip>
<termSec><term>смягчить жёсткость</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Инфинитив по правилу команд; «смягчить» точнее передаёт частичное приглушение, чем «убрать»; «антижёсткость» — именной вариант по образцу названий процессоров, «де-харш» непонятен без английского. Не «деэссер»: он реагирует на уровень в одной полосе.</note></termSec>
<termSec><term>убрать жёсткость</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>антижёсткость</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>де-харш</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="attack-and-body">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that splits a sound into its transient part and its sustained part, to rebalance them.</descrip>
<termSec><term>attack and body</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>transient shaper</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který rozdělí zvuk na tranzientní a trvající část, aby je bylo možné znovu vyvážit.</descrip>
<termSec><term>náběh a tělo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Noun-phrase tool title, reusing the terms for attack and body. 'Tranzienty a tělo' is closer to how engineers talk but mixes registers. Not 'tvarovač tranzientů' (transient shaper).</note></termSec>
<termSec><term>tranzienty a tělo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>rozdělení náběhu a těla</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>attack &amp; body</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das einen Sound in seinen transienten und seinen gehaltenen Anteil zerlegt, um beide neu zu gewichten.</descrip>
<termSec><term>Attack und Körper</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Noun title built from the chosen single terms (Attack, Körper); 'Attack &amp; Body' is the pure-loan title many sound designers would accept. Not 'Transient-Shaper' (works on level, not on a split).</note></termSec>
<termSec><term>Attack &amp; Body</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Anschlag und Körper</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Transiente und Körper</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que separa un sonido en su parte transitoria y su parte sostenida, para reequilibrarlas.</descrip>
<termSec><term>ataque y cuerpo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Noun title, as in English. 'Separar ataque y cuerpo' says what it does but is a command; avoid 'modelador de transitorios' (transient shaper).</note></termSec>
<termSec><term>separar ataque y cuerpo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ataque/cuerpo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które rozdziela dźwięk na część transjentową i część podtrzymaną, aby zmienić proporcje między nimi.</descrip>
<termSec><term>atak i korpus</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Noun title, as in English. „Atak i ciało” is idiomatic studio speech but reads oddly as a title; „podtrzymanie” recalls ADSR sustain. Do not call it „kształtowanie transjentów” (a transient shaper works on level, not on a split).</note></termSec>
<termSec><term>atak i ciało</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>atak i podtrzymanie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>attack &amp; body</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который разделяет звук на транзиентную и длящуюся части, чтобы изменить баланс между ними.</descrip>
<termSec><term>атака и тело</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Существительное, как в английском названии; «транзиенты и тело» привычнее звукорежиссёрам, но смешивает транзиент с атакой. Не «транзиент-шейпер»: тот работает с уровнем, а не с разделением.</note></termSec>
<termSec><term>разделение атаки и тела</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>транзиенты и тело</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="layer-remix">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that separates a sound into layers and mixes them again at new levels.</descrip>
<termSec><term>layer remix</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který rozloží zvuk na vrstvy a znovu je smíchá s novými úrovněmi.</descrip>
<termSec><term>remix vrstev</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Remix' is fully naturalised in Czech. 'Přemixování' stresses the action; 'nové smíchání' is plain but wordy.</note></termSec>
<termSec><term>přemixování vrstev</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>nové smíchání vrstev</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das einen Sound in Layer zerlegt und sie mit neuen Pegeln wieder zusammenmischt.</descrip>
<termSec><term>Layer-Remix</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Layer' is the sound-design word for sound layers (Layering) and keeps them apart from the 'Ebenen' of a look; 'Remix' is naturalised. 'Schichten neu mischen' is the loan-free command form.</note></termSec>
<termSec><term>Schichten neu mischen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Layer neu mischen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Schichten-Remix</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que separa un sonido en capas y las vuelve a mezclar con niveles nuevos.</descrip>
<termSec><term>remezcla de capas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Noun title. 'remix' is common in speech but 'remezcla' is standard Spanish.</note></termSec>
<termSec><term>remezclar capas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>remix de capas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które rozdziela dźwięk na warstwy i miksuje je ponownie na nowych poziomach.</descrip>
<termSec><term>remiks warstw</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Remiks” is naturalised Polish and short; „przemiksowanie warstw” is the plain verbal noun; „rozkład na warstwy” names only the first step.</note></termSec>
<termSec><term>przemiksowanie warstw</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>rozkład na warstwy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>layer remix</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который разделяет звук на слои и сводит их заново с новыми уровнями.</descrip>
<termSec><term>пересведение слоёв</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>«Пересведение» — точный студийный термин (mix — «сведение»); «ремикс» короче, но по-русски означает творческую переделку трека; «пересборка» нейтральна, но теряет связь со сведением.</note></termSec>
<termSec><term>ремикс слоёв</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>пересборка слоёв</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="tension-shaper">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that turns the tension curve into gain and brightness automation.</descrip>
<termSec><term>tension shaper</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který převádí křivku napětí na automatizaci zesílení a jasu.</descrip>
<termSec><term>tvarovač napětí</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Tvarovač' is the usual calque of 'shaper' (tvarovač obálky/tranzientů). 'Tvarování' is the process noun. 'Napětí do automatizace' says what it does.</note></termSec>
<termSec><term>tvarování napětí</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>napětí do automatizace</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>tension shaper</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das die Spannungskurve in Automation für Gain und Helligkeit umsetzt.</descrip>
<termSec><term>Spannungsformer</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Compact compound like 'Hüllkurvenformer'; drawback: engineers may read 'Spannung' as voltage. 'Spannungsbogen formen' is more idiomatic (Spannungsbogen = dramatic arc) but is a command, not a title.</note></termSec>
<termSec><term>Spannungsbogen formen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Spannungsautomation</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Tension Shaper</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que convierte la curva de tensión en automatización de ganancia y brillo.</descrip>
<termSec><term>modelador de tensión</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Parallels the Spanish names for a transient shaper ('modelador' / 'moldeador de transitorios'). 'perfilador' is literal but rare.</note></termSec>
<termSec><term>moldeador de tensión</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>perfilador de tensión</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które zamienia krzywą napięcia na automatykę wzmocnienia i jasności.</descrip>
<termSec><term>kształtowanie napięcia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Polish names such processors after the process („kształtowanie transjentów” for transient shaper). „Kształtownik” is the literal agent noun but in Polish it means a steel section; „modelator” is acceptable but rare.</note></termSec>
<termSec><term>modelator napięcia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>kształtownik napięcia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>tension shaper</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который превращает кривую напряжения в автоматизацию усиления и яркости.</descrip>
<termSec><term>шейпер напряжения</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Шейпер» знаком по «транзиент-шейперу»; «формирователь напряжения» в электронике означает формирователь электрического напряжения; «автоматизация по напряжению» однозначна, но длинна.</note></termSec>
<termSec><term>формирователь напряжения</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>автоматизация по напряжению</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="loop-maker">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that finds and crossfades loop points where the sound repeats best.</descrip>
<termSec><term>loop maker</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který najde body smyčky tam, kde se zvuk nejlépe opakuje, a prolne je.</descrip>
<termSec><term>tvorba smyček</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Tvorba smyček' reads as a tool title. 'Tvůrce smyček' is the literal agent noun. 'Smyčkovač' is playful and short but nonstandard.</note></termSec>
<termSec><term>tvůrce smyček</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>smyčkovač</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>loop maker</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das Loop-Punkte dort findet, wo sich der Sound am besten wiederholt, und sie mit Crossfades versieht.</descrip>
<termSec><term>Loop-Finder</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Loop-Finder' names the main job and reads as German ('Finder' is native); 'Loop-Maker' is the plain loan; 'Loop-Generator' collides with 'Generator' (the Workbench sound generator).</note></termSec>
<termSec><term>Loop-Maker</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Loop-Generator</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Loop erstellen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que encuentra los puntos de bucle donde el sonido se repite mejor y los une con un fundido cruzado.</descrip>
<termSec><term>creador de bucles</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Follows 'bucle'; 'creador de loops' if the author prefers the loan for loops.</note></termSec>
<termSec><term>generador de bucles</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>creador de loops</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które znajduje punkty pętli tam, gdzie dźwięk najlepiej się powtarza, i łączy je przenikaniem.</descrip>
<termSec><term>kreator pętli</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Kreator” is the Polish UI word for a wizard, which fits a tool that finds the points for you. „Zapętlacz” is playful and idiomatic. „Generator” clashes with the Workbench generator.</note></termSec>
<termSec><term>zapętlacz</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>generator pętli</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>loop maker</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который находит точки зацикливания там, где звук повторяется лучше всего, и сшивает их кроссфейдом.</descrip>
<termSec><term>зацикливание</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>«Зацикливание» — привычное русское название этого действия; «создание лупа» — буквально, «луп-мейкер» — калька, а «мастер» в русских интерфейсах означает wizard.</note></termSec>
<termSec><term>создание лупа</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>луп-мейкер</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>мастер лупов</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="variations">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Several slightly different versions of one sound, to avoid repetition in games.</descrip>
<termSec><term>variations</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Několik mírně odlišných verzí jednoho zvuku, aby se ve hrách zabránilo opakování.</descrip>
<termSec><term>varianty</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Variace' also has a musical-form meaning. Plural noun.</note></termSec>
<termSec><term>variace</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Mehrere leicht unterschiedliche Versionen eines Sounds, um Wiederholungen in Spielen zu vermeiden.</descrip>
<termSec><term>Variationen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>German game-audio usage; 'Varianten' also common.</note></termSec>
<termSec><term>Varianten</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Varias versiones ligeramente distintas de un mismo sonido, para evitar la repetición en los juegos.</descrip>
<termSec><term>variaciones</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Kilka nieco różniących się wersji jednego dźwięku, aby uniknąć powtarzalności w grach.</descrip>
<termSec><term>warianty</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Wariacje” suggests musical variations; game-audio usage is „warianty”.</note></termSec>
<termSec><term>wariacje</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>odmiany</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Несколько слегка различающихся версий одного звука — чтобы избежать повторяемости в играх.</descrip>
<termSec><term>вариации</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="clean-up">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that repairs what the quality checks flag before a sound is exported.</descrip>
<termSec><term>clean-up for export</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který před exportem zvuku opraví to, na co upozornily kontroly kvality.</descrip>
<termSec><term>vyčištění pro export</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Noun-phrase tool title; Ardour cs uses 'Vyčistit' for clean-up. Playhead names the tool with a verb ('Clean up for export'), so the app uses the infinitive 'Vyčistit pro export', as for the other command-style tools.</note></termSec>
<termSec><term>úprava před exportem</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>vyčistit pro export</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das behebt, was die Qualitätsprüfungen beanstanden, bevor ein Sound exportiert wird.</descrip>
<termSec><term>Bereinigung für den Export</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Noun title as in the English.</note></termSec>
<termSec><term>Export-Bereinigung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Für den Export bereinigen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que corrige lo que señalan las comprobaciones de calidad antes de exportar un sonido.</descrip>
<termSec><term>limpieza para exportar</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Exactly 22 characters, fits as a UI label.</note></termSec>
<termSec><term>limpieza previa a la exportación</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które przed eksportem naprawia to, co wykryła kontrola jakości.</descrip>
<termSec><term>czyszczenie przed eksportem</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>The vocabulary term is a noun, but Playhead names the tool with a verb („Clean up for export”), so the app uses the imperative „Wyczyść przed eksportem”, following the command convention.</note></termSec>
<termSec><term>wyczyść przed eksportem</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>porządki przed eksportem</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>przygotowanie do eksportu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который перед экспортом звука исправляет то, на что указали проверки качества.</descrip>
<termSec><term>очистка перед экспортом</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="reverb-on-tails">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Reverberation fed only from the decays of the events, keeping the attacks dry.</descrip>
<termSec><term>reverb on the tails</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Dozvuk napájený pouze z doznívání událostí; náběhy zůstávají suché.</descrip>
<termSec><term>dozvuk na doznění</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Dozvuk' = reverb (Audacity cs). 'Dozvuk na doznění' is compact; 'jen z doznění' states the feed more exactly; 'na ocasy' is studio slang.</note></termSec>
<termSec><term>dozvuk jen z doznění</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>dozvuk na ocasy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>reverb on the tails</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Hall, der nur aus den Abklingphasen der Ereignisse gespeist wird, sodass die Attacks trocken bleiben.</descrip>
<termSec><term>Hall auf die Ausklänge</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Follows the studio idiom 'Hall auf die Snare'; 'Hall im Ausklang' is smoother and shorter but loses the per-event plural. 'Hall' (not 'Reverb') is standard German studio usage.</note></termSec>
<termSec><term>Hall im Ausklang</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ausklang-Hall</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Tail-Reverb</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Reverberación alimentada solo por los decaimientos de los eventos, que mantiene secos los ataques.</descrip>
<termSec><term>reverberación en las colas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Noun title. Studio Spanish says 'la reverb'; 'reverberación' is preferred in docs, the short form in UI.</note></termSec>
<termSec><term>reverb en las colas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>reverb solo en colas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Pogłos zasilany wyłącznie zanikaniem zdarzeń, przy którym ataki pozostają suche.</descrip>
<termSec><term>pogłos na ogonach</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Literal and clear in studio Polish („ogon”, „suchy”). „Wybrzmienia” is more elegant but less exact. The half-loan is how engineers would say it aloud.</note></termSec>
<termSec><term>pogłos wybrzmień</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pogłos tylko na ogonach</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>reverb na ogonach</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Реверберация, на которую подаются только затухания событий, так что атаки остаются сухими.</descrip>
<termSec><term>реверб на хвостах</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Реверб» — студийное название процессора, «реверберация» — само явление, поэтому первая альтернатива книжнее; «хвостовой реверб» компактен, но читается как «хвост реверберации».</note></termSec>
<termSec><term>реверберация хвостов</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>хвостовой реверб</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="drive-hits">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Saturation applied only to the events' attacks or bodies.</descrip>
<termSec><term>drive the hits</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Saturace použitá pouze na náběhy nebo těla událostí.</descrip>
<termSec><term>saturovat údery</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. 'Saturovat' says exactly what happens. 'Nabudit' keeps the 'drive' image (buzení) and is idiomatic, but sounds close to 'přebuzení' (clipping).</note></termSec>
<termSec><term>nabudit údery</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>saturace úderů</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>drive the hits</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Sättigung, die nur auf die Attacks oder Körper der Ereignisse angewendet wird.</descrip>
<termSec><term>Hits anzerren</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>'anzerren' is the studio verb for driving lightly into distortion; 'Hits' is common in German sound design ('Impacts &amp; Hits'). 'Schläge' is more German but evokes blows; 'Ereignisse sättigen' is exact but flat.</note></termSec>
<termSec><term>Schläge anzerren</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ereignisse sättigen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Drive the Hits</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Saturación aplicada solo a los ataques o a los cuerpos de los eventos.</descrip>
<termSec><term>saturar los golpes</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. 'drive' as a saturation control is often left in English ('el drive'), but 'saturar' is clearest; 'golpes' = hits. 'calentar' is studio slang.</note></termSec>
<termSec><term>saturar golpes</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>drive en los golpes</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>calentar los golpes</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Saturacja stosowana tylko do ataków lub korpusów zdarzeń.</descrip>
<termSec><term>nasyć uderzenia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Imperative; noun form „nasycanie uderzeń” or „saturacja uderzeń”. „Nasycić” maps directly to saturation („nasycenie”). „Podkręcić” (crank up) is idiomatic but sounds like a level boost. „Przesterować” is the natural word for drive but points to clipping („przesterowanie”).</note></termSec>
<termSec><term>podkręć uderzenia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>przesteruj uderzenia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>drive na uderzeniach</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Сатурация, применяемая только к атакам или телам событий.</descrip>
<termSec><term>перегрузить удары</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Инфинитив по правилу команд; «перегруз» в студийной речи — overdrive, но вне контекста «перегрузить» может читаться как ошибка. «Добавить драйв ударам» однозначно, но длиннее; «раскачать» разговорно и путается с pumping.</note></termSec>
<termSec><term>добавить драйв ударам</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>раскачать удары</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>драйв на удары</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="ring-time">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that lengthens or shortens how long each event rings after its peak.</descrip>
<termSec><term>ring time</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který prodlužuje nebo zkracuje, jak dlouho každá událost po svém vrcholu doznívá.</descrip>
<termSec><term>délka doznívání</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Most natural Czech, but close to 'doba doznívání (T60)'. Choose 'délka znění' if a lexical distinction from the measured value is wanted; 'znění' also means 'wording'.</note></termSec>
<termSec><term>délka znění</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>doznívání</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ring time</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das verlängert oder verkürzt, wie lange jedes Ereignis nach seinem Maximum nachklingt.</descrip>
<termSec><term>Nachklingzeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'nachklingen' carries 'ring'; 'Ausschwingzeit' is acoustically correct but easily confused with Abklingzeit (T60).</note></termSec>
<termSec><term>Ausschwingzeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Klingdauer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ring Time</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que alarga o acorta cuánto tiempo resuena cada evento después de su pico.</descrip>
<termSec><term>tiempo de resonancia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Noun title, as in English. 'resonar' is the verb for ringing objects; avoid 'tiempo de decaimiento' (T60).</note></termSec>
<termSec><term>duración de la resonancia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>tiempo de vibración</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które wydłuża lub skraca czas, przez jaki każde zdarzenie wybrzmiewa po swoim szczycie.</descrip>
<termSec><term>czas wybrzmiewania</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Wybrzmiewać” means exactly „to ring out”. „Dzwonienie” is literal but evokes phones and bells. The measured decay time stays „czas zaniku (T60)”.</note></termSec>
<termSec><term>długość wybrzmienia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>czas dzwonienia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ring time</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который удлиняет или укорачивает звучание каждого события после его пика.</descrip>
<termSec><term>время звона</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>«Звон» — прямой аналог ring (ср. «звон малого барабана»), но для глухих звуков звучит странно; «послезвучание» — акустический термин без этого оттенка; «длительность звучания» легко принять за общую длину.</note></termSec>
<termSec><term>послезвучание</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>длительность звучания</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="level-events">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A tool that evens out how loud the events are, one gain per event, without touching their shape.</descrip>
<termSec><term>level the events</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>compress</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Nástroj, který vyrovná hlasitost událostí jedním zesílením na každou událost, aniž by měnil jejich tvar.</descrip>
<termSec><term>vyrovnat události</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command, matching 'vyrovnanost' (evenness). Not 'komprimovat'. 'Srovnat hlasitost' is more explicit but longer.</note></termSec>
<termSec><term>vyrovnání událostí</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>srovnat hlasitost událostí</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>level the events</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Werkzeug, das angleicht, wie laut die Ereignisse sind – ein Gain pro Ereignis –, ohne ihre Form zu verändern.</descrip>
<termSec><term>Ereignisse angleichen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Command form (object + infinitive, Microsoft German style). 'angleichen' stresses the result (equal loudness), 'ausgleichen' the process. Not 'komprimieren' (a compressor changes the shape).</note></termSec>
<termSec><term>Ereignispegel angleichen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ereignisse ausgleichen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Level the Events</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una herramienta que iguala la sonoridad de los eventos, con una ganancia por evento, sin alterar su forma.</descrip>
<termSec><term>nivelar los eventos</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. 'nivelar' keeps the link to 'nivel' and to 'nivelador' (leveler); 'igualar' is just as idiomatic. Not 'comprimir' (a compressor changes the shape).</note></termSec>
<termSec><term>igualar los eventos</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>igualar el nivel de los eventos</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Narzędzie, które wyrównuje głośność zdarzeń, stosując jedno wzmocnienie na zdarzenie, bez zmiany ich kształtu.</descrip>
<termSec><term>wyrównaj głośność zdarzeń</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Imperative; noun form „wyrównywanie głośności zdarzeń”. The bare „wyrównaj zdarzenia” is closer to the English but can be read as „align the events” in time. Do not call it „kompresja” (a compressor changes the shape).</note></termSec>
<termSec><term>wyrównaj zdarzenia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>wyrównywanie głośności zdarzeń</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>level events</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Инструмент, который выравнивает громкость событий — одно усиление на событие, не затрагивая их форму.</descrip>
<termSec><term>выровнять громкость событий</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>«Громкость» добавлена, потому что «выровнять события» по-русски скорее значит «выровнять по времени»; именной вариант — для заголовков. Не «компрессия»: компрессор меняет форму.</note></termSec>
<termSec><term>выровнять события</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>выравнивание громкости событий</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="fold-to-mono">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Turn stereo into mono with the channels' phase lined up, so nothing cancels.</descrip>
<termSec><term>fold to mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
<termSec><term>sum to mono</term><termNote type="administrativeStatus">deprecatedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Převést stereo na mono se srovnanou fází kanálů, aby se nic nevyrušilo.</descrip>
<termSec><term>sloučit do mona</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. 'Sloučit' is the natural verb; 'složit' is the literal calque of 'fold' but also means 'compose'. Keep 'sečíst do mona' for the plain sum (Audacity cs: 'Smíchání do mono').</note></termSec>
<termSec><term>složit do mona</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>sloučení do mona</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>fold to mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Stereo in Mono umwandeln und dabei die Phasen der Kanäle ausrichten, sodass sich nichts auslöscht.</descrip>
<termSec><term>Phasenrichtig auf Mono mischen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>A literal 'falten' is avoided because 'Faltung' is German for convolution. 'phasenrichtig' marks the difference from a plain 'auf Mono summieren' (sum to mono); 'zusammenführen' is shorter but hides the point.</note></termSec>
<termSec><term>Auf Mono zusammenführen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Phasenrichtig zu Mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Fold to Mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Convertir estéreo en mono con la fase de los canales alineada, para que nada se cancele.</descrip>
<termSec><term>pasar a mono en fase</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. 'pasar a mono' is the everyday phrase but also covers the plain sum ('sumar a mono'; Audacity es 'Mezclar pista estéreo a mono'); 'en fase' carries the alignment. Literal 'plegar' is not used in Spanish audio.</note></termSec>
<termSec><term>plegar a mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pasar a mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>fold to mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zamiana stereo na mono z wyrównaną fazą kanałów, tak aby nic się nie wygaszało.</descrip>
<termSec><term>złóż do mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Imperative; noun form „składanie do mono”. „Złożyć” keeps the folding metaphor and stays distinct from the plain sum („zsumuj do mono”; Audacity pl „Miksuj stereo do mono”). The descriptive form is exact but long.</note></termSec>
<termSec><term>zmiksuj do mono z wyrównaniem fazy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>mono bez wygaszania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>fold to mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Превратить стерео в моно, выровняв фазы каналов, чтобы ничего не подавлялось.</descrip>
<termSec><term>свернуть в моно</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>«Свернуть» передаёт fold и отличается от «свести в моно» — так обычно (и в русской Audacity) называют простое суммирование, то есть sum to mono. «Сложить» буквально, но значит «суммировать».</note></termSec>
<termSec><term>свести в моно</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>фазовое сведение в моно</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>сложить в моно</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="widen-tails">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Make or widen stereo only after the attacks, keeping attacks centred and the result mono-compatible.</descrip>
<termSec><term>widen the tails</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Vytvořit nebo rozšířit stereo jen po nábězích; náběhy zůstanou uprostřed a výsledek kompatibilní s monem.</descrip>
<termSec><term>rozšířit doznění</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command using 'doznění' for tails; 'ocasy' is slang.</note></termSec>
<termSec><term>rozšíření doznění</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>rozšířit ocasy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>widen the tails</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Stereo nur nach den Attacks erzeugen oder verbreitern; die Attacks bleiben in der Mitte, und das Ergebnis bleibt monokompatibel.</descrip>
<termSec><term>Ausklänge verbreitern</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Command form; 'verbreitern' as in 'Stereobreite'. 'aufweiten' is also heard in studios.</note></termSec>
<termSec><term>Ausklänge aufweiten</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Stereo im Ausklang</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Widen the Tails</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Crear o ensanchar el estéreo solo después de los ataques, manteniendo los ataques centrados y el resultado compatible con mono.</descrip>
<termSec><term>ensanchar las colas</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Infinitive command. 'ensanchar la imagen estéreo' is standard phrasing; 'abrir' is studio slang ('abrir el estéreo').</note></termSec>
<termSec><term>abrir las colas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ampliar el estéreo de las colas</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Tworzenie lub poszerzanie stereo tylko po atakach, z atakami pozostawionymi w środku i wynikiem kompatybilnym z mono.</descrip>
<termSec><term>poszerz ogony</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Imperative; noun form „poszerzanie ogonów”. It pairs with „pogłos na ogonach”. „Wybrzmienia” is softer but less precise about what is widened.</note></termSec>
<termSec><term>poszerz wybrzmienia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>stereo na ogonach</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>widen tails</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Создать или расширить стерео только после атак, оставив атаки по центру, а результат — моносовместимым.</descrip>
<termSec><term>расширить хвосты</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Инфинитив по правилу команд; вариант со словом «стерео» точнее, но длиннее; «стерео на хвостах» — именная пара к «реверб на хвостах».</note></termSec>
<termSec><term>расширить стерео хвостов</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>стерео на хвостах</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="downmix">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Turn more channels into fewer.</descrip>
<termSec><term>downmix</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Převést více kanálů na méně kanálů.</descrip>
<termSec><term>downmix</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>The loan is standard in Czech broadcast and post-production (e.g. downmix 5.1 do sterea).</note></termSec>
<termSec><term>sloučení kanálů</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Mehr Kanäle in weniger Kanäle umwandeln.</descrip>
<termSec><term>Downmix</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Broadcast and surround usage; Audacity de 'heruntermischen'.</note></termSec>
<termSec><term>Heruntermischen</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Convertir más canales en menos.</descrip>
<termSec><term>downmix</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Apple Compressor es keeps 'downmix' and studios use the loan; UIT-R BS.775 (es) says 'mezclado descendente', Dolby-style docs 'mezcla descendente'.</note></termSec>
<termSec><term>mezcla descendente</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zamiana większej liczby kanałów na mniejszą.</descrip>
<termSec><term>downmix</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Broadcast and post-production usage keeps the loan („downmix 5.1 do stereo”); „downmiks” is the Polonised spelling.</note></termSec>
<termSec><term>downmiks</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zgranie do mniejszej liczby kanałów</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Преобразование большего числа каналов в меньшее.</descrip>
<termSec><term>даунмикс</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Понижающее микширование» — термин русской версии МСЭ-R BS.775-4; в студийной речи и интерфейсе — «даунмикс».</note></termSec>
<termSec><term>понижающее микширование</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="mono-compatibility">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">How well a stereo sound survives being summed to mono.</descrip>
<termSec><term>mono compatibility</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak dobře stereofonní zvuk snese sečtení do mona.</descrip>
<termSec><term>monokompatibilita</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>kompatibilita s monem</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>mono kompatibilita</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie gut ein Stereosound das Summieren zu Mono übersteht.</descrip>
<termSec><term>Monokompatibilität</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Lo bien que un sonido estéreo resiste la suma a mono.</descrip>
<termSec><term>compatibilidad mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>UIT-R BS.775 (es): 'compatibilidad con los sistemas de escucha monofónica'.</note></termSec>
<termSec><term>compatibilidad con mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak dobrze dźwięk stereo znosi zsumowanie do mono.</descrip>
<termSec><term>kompatybilność z mono</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>TVP technical requirements: „kompatybilność sygnału stereofonicznego z monofonicznym”.</note></termSec>
<termSec><term>kompatybilność mono</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zgodność monofoniczna</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько хорошо стереозвук переносит суммирование в моно.</descrip>
<termSec><term>моносовместимость</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="decorrelation">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Making two signals less alike while keeping their spectrum, to widen a stereo image.</descrip>
<termSec><term>decorrelation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Snížení podobnosti dvou signálů při zachování jejich spektra, za účelem rozšíření stereofonního obrazu.</descrip>
<termSec><term>dekorelace</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Zwei Signale einander unähnlicher machen, ohne ihr Spektrum zu ändern, um ein Stereobild zu verbreitern.</descrip>
<termSec><term>Dekorrelation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Hacer que dos señales se parezcan menos manteniendo su espectro, para ensanchar una imagen estéreo.</descrip>
<termSec><term>decorrelación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zmniejszanie podobieństwa dwóch sygnałów przy zachowaniu ich widma, aby poszerzyć obraz stereo.</descrip>
<termSec><term>dekorelacja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Уменьшение сходства двух сигналов при сохранении их спектра — для расширения стереообраза.</descrip>
<termSec><term>декорреляция</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="comb-filtering">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Regular notches in a spectrum when a signal is summed with a delayed copy of itself.</descrip>
<termSec><term>comb filtering</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Pravidelné zářezy ve spektru, když se signál sečte se svou zpožděnou kopií.</descrip>
<termSec><term>hřebenová filtrace</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Hřebenový filtr' in ČVUT audio-processing lectures.</note></termSec>
<termSec><term>efekt hřebenového filtru</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Regelmäßige Einbrüche im Spektrum, wenn ein Signal mit einer verzögerten Kopie seiner selbst summiert wird.</descrip>
<termSec><term>Kammfiltereffekt</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>Kammfilterung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Muescas regulares en un espectro cuando una señal se suma con una copia retardada de sí misma.</descrip>
<termSec><term>filtrado en peine</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'filtro peine' = comb filter; 'efecto peine' is common in studio talk.</note></termSec>
<termSec><term>efecto peine</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Regularne wycięcia w widmie, gdy sygnał sumuje się z opóźnioną kopią samego siebie.</descrip>
<termSec><term>filtracja grzebieniowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish Wikipedia: „Filtr grzebieniowy”.</note></termSec>
<termSec><term>efekt filtru grzebieniowego</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Регулярные провалы в спектре, возникающие при сложении сигнала с его задержанной копией.</descrip>
<termSec><term>гребенчатая фильтрация</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>гребенчатый эффект</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="cancellation">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Loss of level when signals of opposite phase are summed.</descrip>
<termSec><term>cancellation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Ztráta úrovně při sečtení signálů s opačnou fází.</descrip>
<termSec><term>vyrušení</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Engineering usage: 'signály se v protifázi vyruší'.</note></termSec>
<termSec><term>fázové vyrušení</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>rušení v protifázi</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Pegelverlust, wenn Signale entgegengesetzter Phase summiert werden.</descrip>
<termSec><term>Auslöschung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Phasenauslöschung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Pérdida de nivel cuando se suman señales de fase opuesta.</descrip>
<termSec><term>cancelación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Often 'cancelación de fase' (RØDE es).</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Utrata poziomu, gdy sumują się sygnały o przeciwnej fazie.</descrip>
<termSec><term>wygaszanie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Studio speech also says „sygnały się znoszą”; physics: „interferencja destrukcyjna”.</note></termSec>
<termSec><term>znoszenie się sygnałów</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>interferencja destrukcyjna</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Потеря уровня при сложении сигналов в противофазе.</descrip>
<termSec><term>взаимное подавление</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
<termSec><term>фазовое подавление</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>компенсация</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="pre-echo">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A faint smear of a sound before its attack, caused by frame-based processing.</descrip>
<termSec><term>pre-echo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Slabé rozmazání zvuku před jeho náběhem, způsobené zpracováním po rámcích.</descrip>
<termSec><term>předozvěna</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Calque; no authoritative Czech source found, and codec literature often keeps 'pre-echo'.</note></termSec>
<termSec><term>pre-echo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine schwache Verschmierung eines Sounds vor seinem Attack, verursacht durch blockweise (rahmenbasierte) Verarbeitung.</descrip>
<termSec><term>Vorecho</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>German codec literature (MP3/AAC): Vorecho.</note></termSec>
<termSec><term>Pre-Echo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un leve emborronamiento de un sonido antes de su ataque, causado por el procesamiento por tramas.</descrip>
<termSec><term>preeco</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>RAE spelling joins prefixes ('preeco'); 'pre-eco' is widely seen.</note></termSec>
<termSec><term>pre-eco</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Słabe rozmycie dźwięku przed jego atakiem, wywołane przetwarzaniem w ramkach.</descrip>
<termSec><term>pre-echo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Polish perceptual-coding texts mostly keep „pre-echo” („zjawisko pre-echa”); the Polish calques exist but are rare.</note></termSec>
<termSec><term>echo wyprzedzające</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>przedecho</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Слабое «размазывание» звука перед его атакой, вызванное покадровой обработкой.</descrip>
<termSec><term>предэхо</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>Термин теории перцептивных кодеков (MP3, AAC).</note></termSec>
<termSec><term>пре-эхо</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="eq">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">An equaliser: a filter that changes the level of frequency bands.</descrip>
<termSec><term>EQ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Ekvalizér (EQ): filtr, který mění úroveň frekvenčních pásem.</descrip>
<termSec><term>ekvalizér</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'EQ' is used as is in UI and speech; 'korekce' is the older hi-fi term.</note></termSec>
<termSec><term>EQ</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>korekce</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Equalizer: ein Filter, das den Pegel von Frequenzbändern verändert.</descrip>
<termSec><term>EQ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Entzerrer' is the older broadcast term. 'das Filter' in technical prose, 'der Filter' in studio speech.</note></termSec>
<termSec><term>Equalizer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Entzerrer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un ecualizador: un filtro que cambia el nivel de bandas de frecuencia.</descrip>
<termSec><term>ecualizador (EQ)</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'EQ' is used as is in Spanish UIs and speech (masculine: 'el EQ'); 'ecualización' is the process (Audacity es).</note></termSec>
<termSec><term>ecualización</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Korektor częstotliwości: filtr, który zmienia poziom pasm częstotliwości.</descrip>
<termSec><term>korektor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish Wikipedia: „Korektor (akustyka)”; Audacity pl: „korektor graficzny”. Controls show „EQ”.</note></termSec>
<termSec><term>EQ</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>equalizer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Эквалайзер: фильтр, изменяющий уровень частотных полос.</descrip>
<termSec><term>эквалайзер</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>В интерфейсе допустимо латинское EQ; процесс — «эквализация».</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="dynamic-eq">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">An EQ whose band gains follow the level in each band.</descrip>
<termSec><term>dynamic EQ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Ekvalizér, jehož zesílení v pásmech sleduje úroveň v jednotlivých pásmech.</descrip>
<termSec><term>dynamický ekvalizér</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein EQ, dessen Gain pro Band dem Pegel im jeweiligen Band folgt.</descrip>
<termSec><term>dynamischer EQ</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un EQ cuyas ganancias de banda siguen el nivel de cada banda.</descrip>
<termSec><term>ecualizador dinámico</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>EQ dinámico</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Korektor, którego wzmocnienia pasm podążają za poziomem w każdym paśmie.</descrip>
<termSec><term>korektor dynamiczny</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>dynamiczny EQ</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Эквалайзер, у которого усиление полос следует за уровнем в каждой полосе.</descrip>
<termSec><term>динамический эквалайзер</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="automation">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Parameter changes over time, recorded or drawn.</descrip>
<termSec><term>automation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Změny parametrů v čase, nahrané nebo nakreslené.</descrip>
<termSec><term>automatizace</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Ardour cs.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Parameteränderungen über die Zeit, aufgenommen oder gezeichnet.</descrip>
<termSec><term>Automation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Cubase, Logic and Ableton de say 'Automation'; 'Automatisierung' is general IT German.</note></termSec>
<termSec><term>Automatisierung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cambios de parámetros a lo largo del tiempo, grabados o dibujados.</descrip>
<termSec><term>automatización</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zmiany parametrów w czasie, nagrane lub narysowane.</descrip>
<termSec><term>automatyka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Ardour pl and LMMS pl („ścieżka automatyki”, „edytor automatyki”).</note></termSec>
<termSec><term>automatyzacja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Изменения параметров во времени — записанные или нарисованные.</descrip>
<termSec><term>автоматизация</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="compressor">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A processor that turns loud passages down by a ratio above a threshold.</descrip>
<termSec><term>compressor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Procesor, který nad prahem stahuje hlasité pasáže v daném poměru.</descrip>
<termSec><term>kompresor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Prozessor, der laute Passagen oberhalb eines Thresholds gemäß einer Ratio absenkt.</descrip>
<termSec><term>Kompressor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un procesador que, por encima de un umbral, baja los pasajes fuertes según una ratio.</descrip>
<termSec><term>compresor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Procesor, który ścisza głośne fragmenty powyżej progu w zadanym stosunku.</descrip>
<termSec><term>kompresor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish Wikipedia: „Kompresor dynamiki”; Audacity and LMMS pl.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Процессор, который приглушает громкие участки выше порога с заданной степенью сжатия.</descrip>
<termSec><term>компрессор</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="threshold">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">The level above which a processor acts.</descrip>
<termSec><term>threshold</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Úroveň, nad kterou procesor začne působit.</descrip>
<termSec><term>práh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity, Ardour and LMMS cs.</note></termSec>
<termSec><term>prahová hodnota</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Pegel, oberhalb dessen ein Prozessor eingreift.</descrip>
<termSec><term>Threshold</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Control label in German DAWs (Cubase, Logic); German textbooks: 'Threshold (Arbeitspunkt, Schwellwert)' (HdM Stuttgart, Regelverstärker). 'Schwellenwert' reads well in running text.</note></termSec>
<termSec><term>Schwellenwert</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Schwellwert</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El nivel por encima del cual actúa un procesador.</descrip>
<termSec><term>umbral</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity es, Native Instruments es.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Poziom, powyżej którego procesor zaczyna działać.</descrip>
<termSec><term>próg</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity, Ardour, LMMS pl.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Уровень, выше которого процессор срабатывает.</descrip>
<termSec><term>порог</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="ratio">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">How strongly a compressor turns the level down above its threshold.</descrip>
<termSec><term>ratio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak silně kompresor nad prahem snižuje úroveň.</descrip>
<termSec><term>poměr</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity and LMMS cs.</note></termSec>
<termSec><term>kompresní poměr</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie stark ein Kompressor den Pegel oberhalb seines Thresholds absenkt.</descrip>
<termSec><term>Ratio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>HdM Stuttgart: 'Ratio (Kompressionsstärke)'; Audacity de 'Verhältnis'.</note></termSec>
<termSec><term>Kompressionsverhältnis</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Verhältnis</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuánto reduce un compresor el nivel por encima de su umbral.</descrip>
<termSec><term>ratio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Studio and Native Instruments es usage: 'ratio'. The DLE gives it as feminine ('la ratio'), but 'el ratio' is very common, especially in Latin America. 'relación de compresión' in formal texts.</note></termSec>
<termSec><term>relación de compresión</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak silnie kompresor obniża poziom powyżej progu.</descrip>
<termSec><term>współczynnik kompresji</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Audacity pl („Współczynnik kompresji”), LMMS pl („Współczynnik”). Hardware controls often keep „Ratio”.</note></termSec>
<termSec><term>stopień kompresji</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ratio</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько сильно компрессор снижает уровень выше порога.</descrip>
<termSec><term>степень сжатия</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>В технической литературе — «степень (коэффициент) сжатия»; в русской Audacity — «Соотношение»; на ручках плагинов часто оставляют Ratio.</note></termSec>
<termSec><term>коэффициент сжатия</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ratio</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="attack-time">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">How fast a processor reacts when the level rises.</descrip>
<termSec><term>attack time</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak rychle procesor zareaguje, když úroveň stoupne.</descrip>
<termSec><term>doba náběhu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity cs uses 'Čas náběhu' and LMMS cs 'Náběh'. Czech engineers mostly say 'attack' (e.g. muzikus.cz), so it is offered in alt for a loan-style UI.</note></termSec>
<termSec><term>attack</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>čas náběhu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie schnell ein Prozessor reagiert, wenn der Pegel steigt.</descrip>
<termSec><term>Attack-Zeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>HdM Stuttgart: 'Attack-Time (Ansprechzeit)'. Control label simply 'Attack'.</note></termSec>
<termSec><term>Ansprechzeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué rapidez reacciona un procesador cuando el nivel sube.</descrip>
<termSec><term>tiempo de ataque</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak szybko procesor reaguje, gdy poziom rośnie.</descrip>
<termSec><term>czas ataku</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio usage. Audacity and LMMS pl use „czas narastania”.</note></termSec>
<termSec><term>czas narastania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>attack</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько быстро процессор реагирует на рост уровня.</descrip>
<termSec><term>время атаки</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="release-time">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">How fast a processor recovers when the level falls.</descrip>
<termSec><term>release time</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak rychle se procesor vrátí zpět, když úroveň klesne.</descrip>
<termSec><term>doba uvolnění</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity cs uses 'Čas uvolnění'. LMMS cs 'Doznění' belongs to envelopes and is not used here. Engineers mostly say 'release'.</note></termSec>
<termSec><term>release</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>doba návratu</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>čas uvolnění</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie schnell ein Prozessor in den Ruhezustand zurückkehrt, wenn der Pegel fällt.</descrip>
<termSec><term>Release-Zeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>HdM Stuttgart: 'Release-Time (Rücklaufzeit)'. Control label simply 'Release'.</note></termSec>
<termSec><term>Rücklaufzeit</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué rapidez se recupera un procesador cuando el nivel baja.</descrip>
<termSec><term>tiempo de liberación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Native Instruments es: 'liberación'; ADSR texts use 'relajación'; Apple keeps 'Release'. Avoid Audacity es 'tiempo de decaimiento', which collides with decay.</note></termSec>
<termSec><term>tiempo de relajación</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>release</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak szybko procesor wraca do stanu spoczynku, gdy poziom spada.</descrip>
<termSec><term>czas powrotu</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Studio Polish varies: „powrót”, „zwolnienie”, often plain „release”. Audacity pl has „czas opadania”; LMMS pl has „czas zanikania”, which is avoided because „zanikanie” = decay here.</note></termSec>
<termSec><term>czas zwolnienia</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>czas opadania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>release</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько быстро процессор возвращается в исходное состояние, когда уровень падает.</descrip>
<termSec><term>время релиза</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>В студийной речи — «релиз»; «время восстановления» — технический термин для документации. Русская Audacity непоследовательна («время спада», «время затухания»), а оба этих слова здесь заняты.</note></termSec>
<termSec><term>время восстановления</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="gate">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">A processor or condition that opens only above a threshold.</descrip>
<termSec><term>gate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Procesor nebo podmínka, která se otevře jen nad prahem.</descrip>
<termSec><term>brána</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity and Ardour cs use 'Brána'. For the gate in loudness measurement, RRTV EBU R 128 cz uses 'hradlování' and 'hradlované měření'.</note></termSec>
<termSec><term>šumová brána</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>hradlo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>gate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Prozessor oder eine Bedingung, der bzw. die nur oberhalb eines Thresholds öffnet.</descrip>
<termSec><term>Gate</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>As a processor also 'Rauschsperre' (Noise Gate); in loudness metering 'Gate/Gating' (ZDF Vorgaben 2022: 'Absolutes Gate −70 LUFS').</note></termSec>
<termSec><term>Rauschsperre</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un procesador o una condición que solo se abre por encima de un umbral.</descrip>
<termSec><term>puerta</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity es: 'Puerta', 'Puerta de ruido'; 'gate' common in studio talk.</note></termSec>
<termSec><term>gate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>puerta de ruido</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Procesor lub warunek, który otwiera się dopiero powyżej progu.</descrip>
<termSec><term>bramka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Audacity pl („Bramka szumów”), LMMS pl. BS.1770 gating = „bramkowanie”.</note></termSec>
<termSec><term>gate</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Процессор или условие, которое открывается только выше порога.</descrip>
<termSec><term>гейт</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Гейт» — студийная норма (вариант русской Audacity «шлюз» не прижился); в значении условия анализа — «пороговое условие».</note></termSec>
<termSec><term>шумовой гейт</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>пороговое условие</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="saturation">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Soft distortion that adds harmonics and rounds peaks.</descrip>
<termSec><term>saturation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Měkké zkreslení, které přidává harmonické složky a zaobluje špičky.</descrip>
<termSec><term>saturace</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Weiche Verzerrung, die Harmonische hinzufügt und Spitzen abrundet.</descrip>
<termSec><term>Sättigung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Saturation</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Distorsión suave que añade armónicos y redondea los picos.</descrip>
<termSec><term>saturación</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Keep apart from clipping, although 'saturar' is loosely used for both in speech.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Łagodne zniekształcenie, które dodaje harmoniczne i zaokrągla szczyty.</descrip>
<termSec><term>saturacja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Studio usage prefers „saturacja”; „nasycenie” is the native word (nasycenie taśmy, lampy).</note></termSec>
<termSec><term>nasycenie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Мягкое искажение, которое добавляет гармоники и скругляет пики.</descrip>
<termSec><term>сатурация</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Сатурация» — студийная норма; «насыщение» — технический термин (насыщение ленты, трансформатора).</note></termSec>
<termSec><term>насыщение</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="pumping">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">Audible rise and fall of the background caused by a compressor.</descrip>
<termSec><term>pumping</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Slyšitelné stoupání a klesání pozadí způsobené kompresorem.</descrip>
<termSec><term>pumpování</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Hörbares Auf und Ab des Hintergrunds, verursacht durch einen Kompressor.</descrip>
<termSec><term>Pumpen</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>HdM Stuttgart: '„Pumpen“ eines Kompressors'.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Subida y bajada audibles del fondo causadas por un compresor.</descrip>
<termSec><term>bombeo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Native Instruments es: 'bombeo'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Słyszalne narastanie i opadanie tła wywołane przez kompresor.</descrip>
<termSec><term>pompowanie</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Слышимые подъёмы и спады фона, вызванные работой компрессора.</descrip>
<termSec><term>пампинг</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Студийный жаргон; описательно — «пульсация фона». Близкий эффект breathing — «дыхание» компрессора.</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="evenness">
<descrip type="subjectField">tools</descrip>
<langSec xml:lang="en">
<descrip type="definition">How alike the events are in loudness.</descrip>
<termSec><term>evenness</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak podobné si jsou události hlasitostí.</descrip>
<termSec><term>vyrovnanost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie ähnlich sich die Ereignisse in ihrer Lautheit sind.</descrip>
<termSec><term>Gleichmäßigkeit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>CH: Gleichmässigkeit.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Cuán parecidos son los eventos en sonoridad.</descrip>
<termSec><term>uniformidad</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'regularidad' would suggest timing (see burstiness).</note></termSec>
<termSec><term>regularidad</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak bardzo zdarzenia są do siebie podobne pod względem głośności.</descrip>
<termSec><term>równomierność</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>wyrównanie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько события похожи друг на друга по громкости.</descrip>
<termSec><term>равномерность</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="effect-chain">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Effects applied one after another to a sound.</descrip>
<termSec><term>effect chain</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Efekty použité na zvuk jeden po druhém.</descrip>
<termSec><term>řetězec efektů</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Effekte, die nacheinander auf einen Sound angewendet werden.</descrip>
<termSec><term>Effektkette</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Efectos aplicados uno tras otro a un sonido.</descrip>
<termSec><term>cadena de efectos</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Efekty stosowane do dźwięku jeden po drugim.</descrip>
<termSec><term>łańcuch efektów</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Эффекты, применяемые к звуку один за другим.</descrip>
<termSec><term>цепочка эффектов</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="preset">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A saved set of settings.</descrip>
<termSec><term>preset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Uložená sada nastavení.</descrip>
<termSec><term>předvolba</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Ardour and LMMS cs use 'předvolba'; Audacity cs uses 'přednastavení'.</note></termSec>
<termSec><term>přednastavení</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>preset</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein gespeicherter Satz von Einstellungen.</descrip>
<termSec><term>Preset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
<termSec><term>Voreinstellung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un conjunto de ajustes guardado.</descrip>
<termSec><term>preset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Cubase es keeps 'preset'; Apple and Adobe es use 'preajuste'; Audacity es 'valor predefinido'.</note></termSec>
<termSec><term>preajuste</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>valor predefinido</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zapisany zestaw ustawień.</descrip>
<termSec><term>preset</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Ardour, LMMS and Audacity pl all use „preset” (presety, presetu).</note></termSec>
<termSec><term>ustawienie wstępne</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zestaw ustawień</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Сохранённый набор настроек.</descrip>
<termSec><term>пресет</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Как в русской Audacity («Пресет»); «предустановка» — стиль Microsoft.</note></termSec>
<termSec><term>предустановка</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="morph">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A gradual blend from one sound into another.</descrip>
<termSec><term>morph</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Postupný plynulý přechod jednoho zvuku do druhého.</descrip>
<termSec><term>morfing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Avoid 'prolnutí', which means crossfade.</note></termSec>
<termSec><term>morfování</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>plynulý přechod</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein allmählicher Übergang von einem Sound in einen anderen.</descrip>
<termSec><term>Morphing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>German uses the noun 'Morphing' (verb 'morphen'); not 'Crossfade', which only blends levels.</note></termSec>
<termSec><term>Morph</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Klangüberblendung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una transición gradual de un sonido a otro.</descrip>
<termSec><term>morphing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Spanish sound design uses the loan 'morphing'; 'transformación progresiva' suits docs.</note></termSec>
<termSec><term>transformación progresiva</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>metamorfosis</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Stopniowe przejście jednego dźwięku w inny.</descrip>
<termSec><term>morfing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>płynne przejście</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Постепенное перетекание одного звука в другой.</descrip>
<termSec><term>морфинг</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>морф</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="cross-synthesis">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Combining the spectrum of one sound with the envelope or excitation of another.</descrip>
<termSec><term>cross-synthesis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Spojení spektra jednoho zvuku s obálkou nebo buzením jiného zvuku.</descrip>
<termSec><term>křížová syntéza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Das Spektrum eines Sounds mit der Hüllkurve oder der Anregung eines anderen kombinieren.</descrip>
<termSec><term>Kreuzsynthese</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>excitation = Anregung (source-filter model), not 'Erregung' (= arousal).</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Combinación del espectro de un sonido con la envolvente o la excitación de otro.</descrip>
<termSec><term>síntesis cruzada</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Łączenie widma jednego dźwięku z obwiednią lub pobudzeniem innego.</descrip>
<termSec><term>synteza krzyżowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Объединение спектра одного звука с огибающей или возбуждением другого.</descrip>
<termSec><term>кросс-синтез</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>перекрёстный синтез</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="convolution">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Filtering one sound by another, for example by a room's impulse response.</descrip>
<termSec><term>convolution</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Filtrování jednoho zvuku jiným zvukem, například impulzní odezvou místnosti.</descrip>
<termSec><term>konvoluce</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Einen Sound durch einen anderen filtern, zum Beispiel durch die Impulsantwort eines Raums.</descrip>
<termSec><term>Faltung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Faltungshall. This is why 'fold to mono' is not rendered with 'falten'.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Filtrado de un sonido mediante otro, por ejemplo mediante la respuesta al impulso de una sala.</descrip>
<termSec><term>convolución</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Filtrowanie jednego dźwięku przez inny, np. przez odpowiedź impulsową pomieszczenia.</descrip>
<termSec><term>splot</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Mathematical term (Polish Wikipedia: „Splot (analiza matematyczna)”); studio speech uses „pogłos splotowy” and the calque „konwolucja”.</note></termSec>
<termSec><term>konwolucja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Фильтрация одного звука другим, например импульсной характеристикой помещения.</descrip>
<termSec><term>свёртка</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Свёртка» — математический термин и термин ЦОС; в студийной речи — «конволюционный ревербератор».</note></termSec>
<termSec><term>конволюция</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="envelope-transfer">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Giving one sound the level envelope of another.</descrip>
<termSec><term>envelope transfer</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Předání obálky úrovně jednoho zvuku jinému zvuku.</descrip>
<termSec><term>přenos obálky</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Einem Sound die Pegelhüllkurve eines anderen geben.</descrip>
<termSec><term>Hüllkurvenübertragung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Hüllkurventransfer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Dar a un sonido la envolvente de nivel de otro.</descrip>
<termSec><term>transferencia de envolvente</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Nadanie jednemu dźwiękowi obwiedni poziomu innego dźwięku.</descrip>
<termSec><term>przeniesienie obwiedni</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>„Obwiednia” as in Audacity pl and Polish Wikipedia („Obwiednia dźwięku”).</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Придание одному звуку огибающей уровня другого звука.</descrip>
<termSec><term>перенос огибающей</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="ring-modulation">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Multiplying two signals, which creates sum and difference frequencies.</descrip>
<termSec><term>ring modulation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Násobení dvou signálů, při kterém vznikají součtové a rozdílové frekvence.</descrip>
<termSec><term>kruhová modulace</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Multiplikation zweier Signale, die Summen- und Differenzfrequenzen erzeugt.</descrip>
<termSec><term>Ringmodulation</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Multiplicación de dos señales, que crea frecuencias suma y diferencia.</descrip>
<termSec><term>modulación en anillo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Mnożenie dwóch sygnałów, które tworzy częstotliwości sumacyjne i różnicowe.</descrip>
<termSec><term>modulacja pierścieniowa</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>LMMS pl.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Перемножение двух сигналов, при котором возникают суммарные и разностные частоты.</descrip>
<termSec><term>кольцевая модуляция</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="granular">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Built from many short grains of sound.</descrip>
<termSec><term>granular</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Sestavený z mnoha krátkých zrn zvuku.</descrip>
<termSec><term>granulární</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Aus vielen kurzen Klangkörnern (Grains) aufgebaut.</descrip>
<termSec><term>granular</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Granularsynthese; studio usage 'Grains'.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Construido a partir de muchos granos cortos de sonido.</descrip>
<termSec><term>granular</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Zbudowany z wielu krótkich ziaren dźwięku.</descrip>
<termSec><term>granularny</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Polish Wikipedia: „Synteza granularna”; grain = „ziarno”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Состоящий из множества коротких гранул звука.</descrip>
<termSec><term>гранулярный</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Ср. «гранулярный синтез»; grain — «гранула» (реже «зерно»).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="accent">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A short added sound placed at a moment of another sound to emphasise it.</descrip>
<termSec><term>accent</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Krátký přidaný zvuk umístěný do určitého okamžiku jiného zvuku, aby ho zdůraznil.</descrip>
<termSec><term>akcent</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Akcent' is a familiar musical term and countable ('přidat akcent'). 'Zvýraznění' describes the effect, not the added sound. 'Důraz' is uncountable.</note></termSec>
<termSec><term>zvýraznění</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>důraz</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>accent</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein kurzer, zusätzlicher Sound, der an eine Stelle eines anderen Sounds gesetzt wird, um sie zu betonen.</descrip>
<termSec><term>Akzent</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Akzent' is literal and familiar from music; 'Betonung' names the act rather than the added sound; 'Akzentsound' is unambiguous but longer.</note></termSec>
<termSec><term>Betonung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Akzentsound</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Accent</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un sonido breve añadido en un momento de otro sonido para enfatizarlo.</descrip>
<termSec><term>acento</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'acento' is the musical sense and reads naturally; 'refuerzo' describes the purpose (like a sweetener); 'realce' may suggest an EQ boost; 'sweetener' is the trade loan.</note></termSec>
<termSec><term>refuerzo</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>realce</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>sweetener</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Krótki dodatkowy dźwięk umieszczony w danej chwili innego dźwięku, aby go podkreślić.</descrip>
<termSec><term>akcent</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>„Akcent” is natural (accent = emphasis) but a musician may read it as a louder note. „Podkreślenie” is plainer. Film post calls such layers „sweetener”.</note></termSec>
<termSec><term>podkreślenie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>dźwięk akcentujący</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>accent</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Короткий добавленный звук, поставленный в определённый момент другого звука, чтобы подчеркнуть его.</descrip>
<termSec><term>акцент</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Акцент» короток и точен; «акцентный звук» однозначнее в списках; «стингер» — жаргон игрового и кинозвука, но обычно означает короткую музыкальную вставку.</note></termSec>
<termSec><term>акцентный звук</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>стингер</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="generator">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A part of the app that makes new sounds from parameters.</descrip>
<termSec><term>generator</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Část aplikace, která vytváří nové zvuky z parametrů.</descrip>
<termSec><term>generátor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Teil der App, der aus Parametern neue Sounds erzeugt.</descrip>
<termSec><term>Generator</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una parte de la aplicación que crea sonidos nuevos a partir de parámetros.</descrip>
<termSec><term>generador</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Część aplikacji, która tworzy nowe dźwięki na podstawie parametrów.</descrip>
<termSec><term>generator</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Часть приложения, которая создаёт новые звуки по параметрам.</descrip>
<termSec><term>генератор</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="synth">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A sound generator built from oscillators, noise, envelopes and filters.</descrip>
<termSec><term>synth</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Generátor zvuku sestavený z oscilátorů, šumu, obálek a filtrů.</descrip>
<termSec><term>syntezátor</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Colloquially 'synťák'; not for UI.</note></termSec>
<termSec><term>synth</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Klangerzeuger aus Oszillatoren, Rauschen, Hüllkurven und Filtern.</descrip>
<termSec><term>Synth</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>Synthesizer</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un generador de sonido construido con osciladores, ruido, envolventes y filtros.</descrip>
<termSec><term>sintetizador</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Colloquial 'sinte' (Spain and Latin America) and 'synth'.</note></termSec>
<termSec><term>sinte</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>synth</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Generator dźwięku zbudowany z oscylatorów, szumu, obwiedni i filtrów.</descrip>
<termSec><term>syntezator</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>synth</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Генератор звука из осцилляторов, шума, огибающих и фильтров.</descrip>
<termSec><term>синтезатор</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>синт</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="impact-model">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A physical model of a struck object of a given material and shape.</descrip>
<termSec><term>impact</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Fyzikální model udeřeného předmětu z daného materiálu a daného tvaru.</descrip>
<termSec><term>náraz</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Úder' is reserved for hits (events).</note></termSec>
<termSec><term>úder</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>dopad</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>impact</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein physikalisches Modell eines angeschlagenen Objekts aus einem bestimmten Material und mit einer bestimmten Form.</descrip>
<termSec><term>Impact</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'Impacts' is common in German sound design (library categories 'Impacts &amp; Hits'); use 'Anschlagmodell' in docs when the model itself is meant.</note></termSec>
<termSec><term>Aufprall</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Anschlagmodell</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un modelo físico de un objeto golpeado de un material y una forma determinados.</descrip>
<termSec><term>impacto</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>As a model name: 'modelo de impacto'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Fizyczny model uderzanego przedmiotu o danym materiale i kształcie.</descrip>
<termSec><term>model uderzenia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Use „Uderzenie” as the generator title and „model uderzenia” in docs, to keep it apart from hits (uderzenia = events). Game-audio slang: „impakt”.</note></termSec>
<termSec><term>impakt</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zderzenie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Физическая модель предмета заданного материала и формы, по которому ударяют.</descrip>
<termSec><term>удар</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Слово «удар» переводит и hits («перегрузить удары»); если их нужно развести, генератор можно назвать «модель удара». «Импакт» — жаргон трейлерного звука (мощные удары), здесь уже по смыслу.</note></termSec>
<termSec><term>модель удара</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>импакт</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="resynthesis">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Rebuilding a sound from parameters measured on it, such as its partials and decays.</descrip>
<termSec><term>resynthesis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Znovusestavení zvuku z parametrů na něm naměřených, například z jeho částkových tónů a doznívání.</descrip>
<termSec><term>resyntéza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Einen Sound aus an ihm gemessenen Parametern, etwa seinen Teiltönen und Abklingzeiten, neu aufbauen.</descrip>
<termSec><term>Resynthese</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Reconstrucción de un sonido a partir de parámetros medidos en él, como sus parciales y decaimientos.</descrip>
<termSec><term>resíntesis</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Odtworzenie dźwięku z parametrów zmierzonych na nim samym, takich jak tony składowe i ich zanikanie.</descrip>
<termSec><term>resynteza</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Воссоздание звука по параметрам, измеренным на нём самом, например по его парциальным тонам и затуханиям.</descrip>
<termSec><term>ресинтез</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="modal">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Made of resonant modes, each with a frequency and a decay.</descrip>
<termSec><term>modal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Složený z rezonančních módů, z nichž každý má svou frekvenci a doznívání.</descrip>
<termSec><term>modální</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>As in 'modální syntéza'; acoustics also says 'vlastní módy/vidy'.</note></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Aus Resonanzmoden aufgebaut, jede mit einer Frequenz und einer Abklingzeit.</descrip>
<termSec><term>modal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Modalsynthese; die Mode, pl. Moden.</note></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Formado por modos resonantes, cada uno con su frecuencia y su decaimiento.</descrip>
<termSec><term>modal</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>'síntesis modal'.</note></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Złożony z modów rezonansowych, z których każdy ma częstotliwość i czas zaniku.</descrip>
<termSec><term>modalny</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>As in „synteza modalna”; mechanics says „mody drgań” or „postaci drgań własnych”.</note></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Состоящий из резонансных мод, каждая со своей частотой и затуханием.</descrip>
<termSec><term>модальный</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Ср. «модальный синтез». Не путать с музыкальным ладом (mode).</note></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="texture">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A continuous sound made of many small events, such as rain, fire or gravel.</descrip>
<termSec><term>texture</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Spojitý zvuk složený z mnoha drobných událostí, jako je déšť, oheň nebo štěrk.</descrip>
<termSec><term>textura</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein kontinuierlicher Sound aus vielen kleinen Ereignissen, etwa Regen, Feuer oder Kies.</descrip>
<termSec><term>Textur</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un sonido continuo formado por muchos eventos pequeños, como la lluvia, el fuego o la grava.</descrip>
<termSec><term>textura</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Ciągły dźwięk złożony z wielu drobnych zdarzeń, jak deszcz, ogień czy żwir.</descrip>
<termSec><term>tekstura</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Непрерывный звук из множества мелких событий, например дождь, огонь или гравий.</descrip>
<termSec><term>текстура</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="reaction">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A generator in which an action, such as an object moving or a force, drives the sound of a medium that responds to it (gravel, water, air).</descrip>
<termSec><term>action and reaction</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Generátor, ve kterém akce, například pohyb předmětu nebo síla, budí zvuk média, které na ni reaguje (štěrk, voda, vzduch).</descrip>
<termSec><term>akce a reakce</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Echoes Newton's 'zákon akce a reakce', which every Czech knows from school. 'Působení a odezva' sounds more technical. 'Odezva' fits 'response' but is also the word for impulse response. 'Budí' (excites) renders 'drives', as in physical models.</note></termSec>
<termSec><term>působení a odezva</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>akce a odezva</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>action &amp; reaction</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein Medium (Kies, Wasser, Luft), das auf eine Aktion reagiert, etwa auf ein Objekt, das sich hindurchbewegt.</descrip>
<termSec><term>Aktion und Reaktion</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>Literal and clear; echoes Newton's 'actio = reactio', which fits. 'Anregung und Antwort' is acoustically apt but collides with Anregung = excitation.</note></termSec>
<termSec><term>Einwirkung und Reaktion</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Anregung und Antwort</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Action &amp; Reaction</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un generador en el que una acción, como un objeto que se mueve o una fuerza, impulsa el sonido de un medio que responde a ella (grava, agua, aire).</descrip>
<termSec><term>acción y reacción</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Literal pair as in English; 'reacción' alone for a compact label; 'respuesta del medio' is the most explicit but long.</note></termSec>
<termSec><term>reacción</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>respuesta del medio</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Generator, w którym działanie, np. ruch przedmiotu lub siła, wywołuje dźwięk reagującego na nie ośrodka (żwir, woda, powietrze).</descrip>
<termSec><term>akcja i reakcja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>„Zasada akcji i reakcji” is the everyday Polish name of Newton's third law, so the pair is instantly understood. „Działanie” is more formal; „odpowiedź” sounds like signal processing.</note></termSec>
<termSec><term>działanie i reakcja</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>działanie i odpowiedź</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>action &amp; reaction</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Среда (гравий, вода, воздух), которая откликается на действие, например на движение предмета сквозь неё.</descrip>
<termSec><term>действие и реакция</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Буквальный вариант прозрачен и симметричен английскому; «отклик» мягче, но в ЦОС занят (импульсный отклик); «реакция среды» описывает только половину пары.</note></termSec>
<termSec><term>действие и отклик</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>реакция среды</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="medium">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">What reacts to an action: gravel, leaves, water, air, sparks or a force field.</descrip>
<termSec><term>medium</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">To, co reaguje na akci: štěrk, listí, voda, vzduch, jiskry nebo silové pole.</descrip>
<termSec><term>médium</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>'Prostředí' is the physics word for medium but also means environment or ambience.</note></termSec>
<termSec><term>prostředí</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Was auf eine Aktion reagiert: Kies, Laub, Wasser, Luft, Funken oder ein Kraftfeld.</descrip>
<termSec><term>Medium</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Lo que reacciona a una acción: grava, hojas, agua, aire, chispas o un campo de fuerza.</descrip>
<termSec><term>medio</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">To, co reaguje na działanie: żwir, liście, woda, powietrze, iskry lub pole siłowe.</descrip>
<termSec><term>ośrodek</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Physics term for a propagation medium; „medium” is also understood.</note></termSec>
<termSec><term>medium</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">То, что реагирует на действие: гравий, листья, вода, воздух, искры или силовое поле.</descrip>
<termSec><term>среда</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="drive-curve">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A curve that controls a sound's parameters over time.</descrip>
<termSec><term>drive curve</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Křivka, která v čase řídí parametry zvuku.</descrip>
<termSec><term>řídicí křivka</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Drive' here means control, not overdrive, so 'řídicí' (controlling) is clearest. 'Budicí' (exciting) fits physical models but suggests saturation drive.</note></termSec>
<termSec><term>budicí křivka</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>křivka řízení</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>drive curve</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Eine Kurve, die die Parameter eines Sounds über die Zeit steuert.</descrip>
<termSec><term>Steuerkurve</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Steuerkurve' (control curve) is precise and avoids the clash with drive = Anzerrung (drive the hits); 'Antriebskurve' is literal but sounds mechanical.</note></termSec>
<termSec><term>Antriebskurve</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Drive-Kurve</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Verlaufskurve</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Una curva que controla los parámetros de un sonido a lo largo del tiempo.</descrip>
<termSec><term>curva motriz</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'motriz' renders 'drive' (as in 'fuerza motriz') and is distinctive; 'curva de control' is immediately clear but generic; 'curva de mando' is literal and slightly old-fashioned.</note></termSec>
<termSec><term>curva de control</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>curva de mando</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Krzywa, która steruje parametrami dźwięku w czasie.</descrip>
<termSec><term>krzywa sterująca</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>„Sterować” is the Polish verb for driving a parameter. „Napędowa” is mechanically literal. „Wysterowanie” in Polish audio means drive or level, so it would suggest gain only.</note></termSec>
<termSec><term>krzywa napędowa</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>krzywa wysterowania</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>drive curve</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Кривая, которая управляет параметрами звука во времени.</descrip>
<termSec><term>управляющая кривая</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>«Управляющая» — как «управляющий сигнал», естественно по-русски; «кривая управления» — буквальнее; «кривая драйва» сохраняет английское слово, но «драйв» в студийной речи означает перегруз.</note></termSec>
<termSec><term>кривая управления</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>кривая драйва</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="inertia">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">How slowly a reaction settles after the action stops.</descrip>
<termSec><term>inertia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Jak pomalu se reakce ustálí poté, co akce skončí.</descrip>
<termSec><term>setrvačnost</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Wie langsam sich eine Reaktion beruhigt, nachdem die Aktion aufgehört hat.</descrip>
<termSec><term>Trägheit</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>Nachlauf</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Con qué lentitud se asienta una reacción después de que cesa la acción.</descrip>
<termSec><term>inercia</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Jak wolno reakcja się uspokaja po ustaniu działania.</descrip>
<termSec><term>bezwładność</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Насколько медленно реакция успокаивается после прекращения действия.</descrip>
<termSec><term>инерция</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>инерционность</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="foley">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">Everyday sounds performed and recorded in sync with picture.</descrip>
<termSec><term>Foley</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Běžné zvuky předvedené a nahrané synchronně s obrazem.</descrip>
<termSec><term>ruchy</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Czech film-sound term; the Foley artist is a 'ruchař'. The English 'foley' is also used (filmvychova.cz, Rosebud). Plural noun.</note></termSec>
<termSec><term>foley</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>postsynchronní ruchy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Alltagsgeräusche, die synchron zum Bild gespielt und aufgenommen werden.</descrip>
<termSec><term>Foley</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">neuter</termNote><note>German film-sound practice: Foley, Geräuschemacher(in). Capitalised as in English (after Jack Foley).</note></termSec>
<termSec><term>Geräuschemacherei</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Sonidos cotidianos interpretados y grabados en sincronía con la imagen.</descrip>
<termSec><term>foley</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>'foley' (usually lowercase, m) is used across Spanish-speaking industries; Spain's film and dubbing tradition also calls it 'efectos sala' / 'efectos de sala'.</note></termSec>
<termSec><term>efectos de sala</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Codzienne dźwięki wykonywane i nagrywane synchronicznie z obrazem.</descrip>
<termSec><term>efekty synchroniczne</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Polish film-sound terminology: „efekty synchroniczne”, „imitacja synchroniczna”, with the artist called „imitator” (Polish film-sound article on ejournals.eu; noiz.ai pl „Kinowe efekty synchroniczne (Foley)”). „Foley” is understood in game audio.</note></termSec>
<termSec><term>Foley</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>imitacja synchroniczna</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>synchrony</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Бытовые звуки, исполняемые и записываемые синхронно с изображением.</descrip>
<termSec><term>фоли</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><note>В отечественном кино традиционно «шумовое озвучание», исполнитель — «шумовик»; в игровом звуке и современном постпродакшене — «фоли» (по фамилии Джека Фоли), строчными.</note></termSec>
<termSec><term>шумовое озвучание</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>синхронные шумы</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="ambience">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">The background sound of a place.</descrip>
<termSec><term>ambience</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zvukové pozadí určitého místa.</descrip>
<termSec><term>atmosféra</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Czech film-sound term ('atmosféry'; slang 'atmoska').</note></termSec>
<termSec><term>atmoska</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ambience</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>zvukové pozadí</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Der Hintergrundklang eines Ortes.</descrip>
<termSec><term>Atmo</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>German film-sound and sound-design standard (die Atmo, pl. Atmos; Atmo-Aufnahme).</note></termSec>
<termSec><term>Atmosphäre</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Ambience</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El sonido de fondo de un lugar.</descrip>
<termSec><term>ambiente</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Post-production speaks of 'ambientes' (pl.).</note></termSec>
<termSec><term>sonido ambiente</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Dźwiękowe tło miejsca.</descrip>
<termSec><term>atmosfera</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>Polish film post-production calls these tracks „atmosfery” (ejournals.eu article: „atmosfery, efekty boczne, synchroniczne”); general texts say „tło dźwiękowe”.</note></termSec>
<termSec><term>tło dźwiękowe</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>ambient</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Фоновое звучание места.</descrip>
<termSec><term>атмосфера</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>В постпродакшене говорят «атмосферы», «фоны»; калька «эмбиенс» легко путается с жанром «эмбиент».</note></termSec>
<termSec><term>фон</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>эмбиенс</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="one-shot">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">A short sound played once, such as a hit or a UI click.</descrip>
<termSec><term>one-shot</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Krátký zvuk přehraný jednou, například úder nebo cvaknutí v uživatelském rozhraní.</descrip>
<termSec><term>one-shot</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Loan used by Czech sound designers and sample libraries.</note></termSec>
<termSec><term>jednorázový zvuk</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Ein kurzer Sound, der einmal abgespielt wird, etwa ein Hit oder ein UI-Klick.</descrip>
<termSec><term>One-Shot</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Un sonido corto que se reproduce una vez, como un golpe o un clic de interfaz.</descrip>
<termSec><term>one-shot</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Loan used in samplers and sound libraries.</note></termSec>
<termSec><term>sonido de disparo único</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Krótki dźwięk odtwarzany raz, np. uderzenie lub kliknięcie w interfejsie.</descrip>
<termSec><term>one-shot</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Sampler and game-audio loan.</note></termSec>
<termSec><term>dźwięk pojedynczy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>pojedynczy sampel</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Короткий звук, проигрываемый один раз, например удар или щелчок интерфейса.</descrip>
<termSec><term>ваншот</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>«Ваншот» — обычное слово в библиотеках сэмплов; в документации при первом упоминании можно пояснить: «одиночный звук».</note></termSec>
<termSec><term>одиночный звук</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>однократный сэмпл</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="whoosh">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">The sound of something moving fast past the listener.</descrip>
<termSec><term>whoosh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Zvuk něčeho, co se rychle pohybuje kolem posluchače.</descrip>
<termSec><term>whoosh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Sound designers use the loan. 'Svist' is the Czech word for the sound and fits a more localised UI.</note></termSec>
<termSec><term>svist</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>průlet</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Das Geräusch von etwas, das sich schnell am Hörer vorbeibewegt.</descrip>
<termSec><term>Whoosh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>SFX library usage; 'Wusch' is the German onomatopoeia.</note></termSec>
<termSec><term>Swoosh</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Wusch</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">El sonido de algo que pasa rápidamente junto al oyente.</descrip>
<termSec><term>whoosh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Loan used in Spanish sound libraries; 'pasada' covers pass-bys.</note></termSec>
<termSec><term>pasada</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Dźwięk czegoś, co szybko przelatuje obok słuchacza.</descrip>
<termSec><term>whoosh</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>Sound designers use the loan; „świst” is the Polish word in general texts (noiz.ai pl: „charakterystyczne świsty”).</note></termSec>
<termSec><term>świst</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>przelot</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Звук чего-то, быстро проносящегося мимо слушателя.</descrip>
<termSec><term>вуш</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote><note>В библиотеках и у монтажёров — «вуш»; «пролёт» — русское слово для pass-by, «вжух» — шуточно-разговорное.</note></termSec>
<termSec><term>свист</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>пролёт</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>вжух</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
<conceptEntry id="finishing">
<descrip type="subjectField">workbench</descrip>
<langSec xml:lang="en">
<descrip type="definition">The last steps before export: format, channels, fades and level.</descrip>
<termSec><term>finishing</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="cs">
<descrip type="definition">Poslední kroky před exportem: formát, kanály, fade-in/fade-out a úroveň.</descrip>
<termSec><term>finalizace</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>dokončení</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>dokončovací úpravy</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="de">
<descrip type="definition">Die letzten Schritte vor dem Export: Format, Kanäle, Fades und Pegel.</descrip>
<termSec><term>Endbearbeitung</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote><note>'Feinschliff' is more idiomatic but suggests polish rather than format and channels.</note></termSec>
<termSec><term>Feinschliff</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Fertigstellung</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>Finishing</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="es">
<descrip type="definition">Los últimos pasos antes de exportar: formato, canales, fundidos y nivel.</descrip>
<termSec><term>acabado</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">masculine</termNote></termSec>
<termSec><term>finalización</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>retoques finales</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="pl">
<descrip type="definition">Ostatnie kroki przed eksportem: format, kanały, przejścia (fade) i poziom.</descrip>
<termSec><term>finalizacja</term><termNote type="administrativeStatus">preferredTerm-admn-sts</termNote><termNote type="grammaticalGender">feminine</termNote></termSec>
<termSec><term>wykończenie</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
<langSec xml:lang="ru">
<descrip type="definition">Последние шаги перед экспортом: формат, каналы, фейды и уровень.</descrip>
