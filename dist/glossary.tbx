<termSec><term>доводка</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
<termSec><term>финишная обработка</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termSec>
</langSec>
</conceptEntry>
